---
/** One step of the trial tour: the screen beside its explanation. Built from the Screenshot and CallToAction widgets. */
import Screenshot from 'parche:widgets/Screenshot';
import CallToAction from 'parche:widgets/CallToAction';
import { schema, type Props } from './TourStep.props';

const { screen, title, subtitle, action } = schema.parse(Astro.props) as Props;
---

<div class="grid items-center gap-8 md:grid-cols-2 md:gap-16">
  <Screenshot url={screen.url} badge={screen.badge} badgeTone="primary" caption={screen.caption} ratio={screen.ratio} />
  <CallToAction layout="stacked" {title} {subtitle} actions={action ? [{ variant: 'primary', ...action }] : []} />
</div>
