{
  "sections": [
    {
      "widget": "Header",
      "props": {
        "logo": { "text": "AstroWind", "href": "/" },
        "links": [
          { "label": "Docs", "href": "/fixtures/docs" },
          { "label": "Launch", "href": "/fixtures/launch" },
          { "label": "Blog", "href": "/blog" }
        ],
        "actions": [{ "label": "Get template", "href": "https://github.com/arthelokyo/astrowind", "variant": "primary", "icon": "tabler:download" }]
      }
    },
    {
      "widget": "Section",
      "props": { "width": "xl", "spacing": "sm" },
      "slots": {
        "default": [
          {
            "widget": "Columns",
            "props": { "ratio": "wide-start", "gap": "lg", "stack": "lg" },
            "slots": {
              "default": [
                { "widget": "Column", "slots": { "default": [{ "widget": "Outlet" }] } },
                {
                  "widget": "Column",
                  "props": { "as": "aside", "sticky": true, "label": "On this page" },
                  "slots": { "default": [{ "widget": "Outlet", "props": { "name": "aside" } }] }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "widget": "Footer",
      "props": {
        "columns": [{ "title": "Docs", "links": [{ "label": "Getting started", "href": "/fixtures/docs" }, { "label": "Launch page", "href": "/fixtures/launch" }] }],
        "socialLinks": [{ "label": "GitHub", "href": "https://github.com/arthelokyo/astrowind", "icon": "tabler:brand-github" }],
        "footNote": "A fixture layout: two columns with an outlet in each, the second one an aside."
      }
    }
  ]
}
