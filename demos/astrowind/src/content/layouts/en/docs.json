{
  "sections": [
    {
      "widget": "Header",
      "props": {
        "logo": {
          "text": "AstroWind",
          "href": "/"
        },
        "links": {
          "$ref": "navigation/docs"
        },
        "actions": [
          {
            "label": "Get template",
            "href": "https://github.com/arthelokyo/astrowind",
            "variant": "primary",
            "icon": "tabler:download"
          }
        ]
      }
    },
    {
      "widget": "Section",
      "props": {
        "width": "xl",
        "spacing": "sm"
      },
      "slots": {
        "default": [
          {
            "widget": "Columns",
            "props": {
              "ratio": "wide-start",
              "gap": "lg",
              "stack": "lg"
            },
            "slots": {
              "default": [
                {
                  "widget": "Column",
                  "slots": {
                    "default": [
                      {
                        "widget": "Outlet",
                        "props": {
                          "wrapper": {
                            "widget": "Section"
                          }
                        }
                      }
                    ]
                  }
                },
                {
                  "widget": "Column",
                  "props": {
                    "as": "aside",
                    "sticky": true,
                    "label": "On this page"
                  },
                  "slots": {
                    "default": [
                      {
                        "widget": "Outlet",
                        "props": {
                          "name": "aside",
                          "wrapper": {
                            "widget": "Section"
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "widget": "Footer",
      "props": {
        "columns": {
          "$ref": "navigation/docs-footer"
        },
        "socialLinks": {
          "$ref": "navigation/docs-social"
        },
        "footNote": "A fixture layout: two columns with an outlet in each, the second one an aside."
      }
    }
  ]
}
