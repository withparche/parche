      "slots": {
        "default": [
          {
            "widget": "Steps",
            "props": {
              "layout": "rows",
              "header": "top",
              "tagline": "Process",
              "title": "Who does the work, and what we need from you",
              "subtitle": "No account manager between you and the people designing. The named lead is in every session.",
              "items": [
                {
                  "title": "Discovery, and interviews with your customers",
                  "description": "Five calls with people who pay you, run by us. Almost every project turns on something said in these. **You owe:** the introductions, and one workshop.",
                  "duration": "weeks 1–2"
                },
                {
                  "title": "Positioning, agreed in writing before any design",
                  "description": "One page: who it is for, what it replaces, why it wins. We do not open Figma until you have signed it off. **You owe:** a decision, not a committee.",
                  "duration": "week 3"
                },
                {
                  "title": "Two directions, applied to real surfaces",
                  "description": "Not mood boards — your actual homepage, your product UI and your deck, in both routes. **You owe:** one 90-minute review with whoever can say yes.",
                  "duration": "weeks 4–6"
                },
                {
                  "title": "Build out, with your engineers in the room",
                  "description": "Weekly working sessions rather than a reveal at the end. A surprise at handover is a process failure. **You owe:** one engineer, two hours a week.",
                  "duration": "weeks 7–12"
                },
                {
                  "title": "Handover, then a review 90 days later",
                  "description": "Figma library, tokens, a rulebook and recorded walkthroughs — then a free session three months on, when the real questions arrive. **You owe:** nothing.",
                  "duration": "week 13"
                }
              ]
            }
          }
        ]
      }
