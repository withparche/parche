                {
                  "eyebrow": "The problem",
                  "description": "You ship something you are proud of and nobody notices. Adoption is flat and you cannot tell whether it is the feature or the silence."
                },
                {
                  "eyebrow": "With Cadence",
                  "eyebrowTone": "primary",
                  "description": "Read receipts per account, and the feature opened afterwards — so you can separate “nobody wants it” from “nobody heard about it”."
                },
                {
                  "eyebrow": "Measured",
                  "description": "Median 41% of active accounts read a release note within seven days.",
                  "footer": "Aggregate across 1,180 workspaces"
                }
              ]
