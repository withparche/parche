            "widget": "Features",
            "props": {
              "layout": "cards",
              "columns": "3",
              "card": "canvas",
              "items": [
                {
                  "eyebrow": "The problem",
                  "description": "Release notes land on whoever merged last, on the day they least have time, written from commit messages nobody outside the team understands."
