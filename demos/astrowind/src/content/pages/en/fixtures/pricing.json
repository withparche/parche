    { "widget": "Preset", "props": { "name": "faq-agencies" } },
    {
      "widget": "Section",
      "props": { "tone": "dark", "id": "get", "label": "Get it" },
      "slots": {
        "default": [
          {
            "widget": "CallToAction",
            "props": {
              "layout": "band",
              "title": "Start with the free tier",
