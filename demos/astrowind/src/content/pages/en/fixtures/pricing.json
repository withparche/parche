{
  "title": "Pricing",
  "description": "A fixture page: a billing switch with a plan set per period, prices from content, the questions preset, and a closing band.",
  "sections": [
    {
      "widget": "Hero",
      "props": {
        "layout": "text",
        "tagline": "Pricing",
        "title": "Per project, not per seat",
        "subtitle": "Three tiers, the middle one marked and reasoned. Yearly is ten months for twelve."
      }
    },
    {
      "widget": "Section",
      "props": { "id": "plans", "label": "Plans", "spacing": "sm" },
      "slots": {
