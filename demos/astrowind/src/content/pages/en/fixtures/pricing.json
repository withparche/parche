                      { "title": "Free", "subtitle": "One project", "price": "0", "currency": "€", "period": "per month", "items": [{ "description": "1 project" }, { "description": "Community support" }], "callToAction": { "text": "Start free", "href": "#get" } },
                      { "title": "Studio", "subtitle": "Most picked by agencies", "price": "39", "currency": "€", "period": "per month", "hasRibbon": true, "ribbonTitle": "Most picked", "items": [{ "description": "Unlimited projects" }, { "description": "The builder" }, { "description": "Email support, 1 business day" }], "callToAction": { "text": "Start Studio", "href": "#get" } },
                      { "title": "Done with you", "subtitle": "We build the first site", "type": "custom", "items": [{ "description": "Everything in Studio" }, { "description": "A scoping call" }, { "description": "Launch support" }], "callToAction": { "text": "Talk to us", "href": "/contact" } }
                    ]
                  }
                }
              ],
              "yearly": [
                {
                  "widget": "Pricing",
                  "props": {
                    "prices": [
                      { "title": "Free", "subtitle": "One project", "price": "0", "currency": "€", "period": "per year", "items": [{ "description": "1 project" }, { "description": "Community support" }], "callToAction": { "text": "Start free", "href": "#get" } },
                      { "title": "Studio", "subtitle": "Most picked by agencies", "price": "390", "currency": "€", "period": "per year", "hasRibbon": true, "ribbonTitle": "Two months free", "items": [{ "description": "Unlimited projects" }, { "description": "The builder" }, { "description": "Email support, 1 business day" }], "callToAction": { "text": "Start Studio", "href": "#get" } },
                      { "title": "Done with you", "subtitle": "We build the first site", "type": "custom", "items": [{ "description": "Everything in Studio" }, { "description": "A scoping call" }, { "description": "Launch support" }], "callToAction": { "text": "Talk to us", "href": "/contact" } }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
