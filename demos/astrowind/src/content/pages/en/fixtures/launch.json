{
  "title": "Launch",
  "description": "A fixture page from the 2026 redesign: a hero with a switcher in its media slot, features as cards, a numbered process, sourced numbers, questions and a closing band.",
  "sections": [
    {
      "widget": "Hero",
      "props": {
        "layout": "split",
        "tagline": "MIT · 4 years · every Astro major supported within 6 days",
        "title": "The client site is finished before the kickoff call ends",
        "subtitle": "Eight complete site types, wired for real work: metadata, feeds, generated OG images, consent, forms with states. Replace the words, ship it.",
        "actions": [
          {
            "text": "Clone this starter",
            "href": "#get",
            "variant": "primary"
          },
          {
            "text": "Open the demo",
            "href": "/homes/saas",
            "variant": "secondary"
          }
        ]
      },
      "slots": {
        "media": [
          {
            "widget": "Switch",
            "props": {
              "label": "I am building",
              "syncKey": "kind",
              "options": [
                {
                  "value": "agency",
                  "label": "An agency site"
                },
                {
                  "value": "saas",
                  "label": "A SaaS product"
                },
                {
                  "value": "store",
                  "label": "A small store"
                }
              ]
            },
            "slots": {
              "agency": [
                {
                  "widget": "Content",
                  "props": {
                    "title": "Services, work, process, contact",
                    "content": "<p>Services with deliverables, case studies with measured results, a process page a client can follow, and a contact form with real states.</p><pre><code>npm create parche@latest -- --template agency</code></pre>"
                  }
                }
              ],
              "saas": [
                {
                  "widget": "Content",
                  "props": {
                    "title": "Pricing, docs, changelog, status",
                    "content": "<p>A pricing page with a billing switch, a docs shell, a changelog with a feed, and the trust strip enterprise buyers look for.</p><pre><code>npm create parche@latest -- --template saas</code></pre>"
                  }
                }
              ],
              "store": [
                {
                  "widget": "Content",
                  "props": {
                    "title": "Catalogue, product, cart, policies",
                    "content": "<p>A catalogue with filters, a product page with a gallery, shipping and returns before the basket.</p><pre><code>npm create parche@latest -- --template store</code></pre>"
                  }
                }
              ]
            }
          }
        ],
        "proof": [
          {
            "widget": "Stats",
            "props": {
              "items": [
                {
                  "value": "6.1K",
                  "label": "GitHub stars",
                  "source": "GitHub",
                  "date": "Sept 2026"
                },
                {
                  "value": "0.4",
                  "label": "Median LCP",
                  "unit": "s",
                  "source": "CrUX p75",
                  "date": "28 days"
                },
                {
                  "value": "38",
                  "label": "Client JS on a page",
                  "unit": "KB",
                  "source": "build-smoke"
                },
                {
                  "value": "34",
                  "label": "Sites in production",
                  "source": "showcase"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "widget": "Section",
      "props": {
        "tone": "muted",
        "id": "ships",
        "label": "What ships"
      },
      "slots": {
        "default": [
          {
            "widget": "Features",
            "props": {
              "layout": "cards",
              "columns": "3",
              "tagline": "What ships",
              "title": "Count it before you clone it",
              "items": [
                {
                  "title": "Metadata, canonicals and OG images",
                  "description": "Generated per page at build, with guard rails that fail on a missing description.",
                  "icon": "tabler:seo"
                },
                {
                  "title": "Structured data per page type",
                  "description": "Article, product, local business, course: the schema the page type needs, true for the site it is on.",
                  "icon": "tabler:braces"
                },
                {
                  "title": "Forms with states",
                  "description": "Idle, loading, error and success; the input is never cleared on error.",
                  "icon": "tabler:forms"
                },
                {
                  "title": "Cookie consent that gates scripts",
                  "description": "Reject is as prominent as accept, and analytics wait for the choice.",
                  "icon": "tabler:cookie"
                },
                {
                  "title": "Accessibility pass",
                  "description": "Every element audited against WCAG 2.2 AA in three browsers, with the open gaps listed.",
                  "icon": "tabler:accessible"
                },
                {
                  "title": "Dark mode across every component",
                  "description": "Every colour is a role with two values; nothing is hard-coded.",
                  "icon": "tabler:moon"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "widget": "Section",
      "props": {
        "id": "process",
        "label": "Process"
      },
      "slots": {
        "default": [
          {
            "widget": "Steps",
            "props": {
              "layout": "numbered",
              "tagline": "Process",
              "title": "Four steps, and you never write release notes twice",
              "subtitle": "Deliverable, duration and owner per step: what a client approves a budget on.",
              "items": [
                {
                  "title": "Scope",
                  "description": "A thirty-minute call and a written scope.",
                  "duration": "1 week",
                  "owner": "you and us"
                },
                {
                  "title": "Content",
                  "description": "Pages as JSON, reviewed in the builder.",
                  "duration": "2 weeks",
                  "owner": "you"
                },
                {
                  "title": "Build",
                  "description": "Widgets, theme and forms wired.",
                  "duration": "2 weeks",
                  "owner": "us"
                },
                {
                  "title": "Launch",
                  "description": "Deployed, measured, handed over.",
                  "duration": "3 days",
                  "owner": "us"
                }
              ],
              "actions": [
                {
                  "text": "Book a scoping call",
                  "href": "/contact"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "widget": "Section",
      "props": {
        "tone": "glow",
        "id": "numbers",
        "label": "Numbers"
      },
      "slots": {
        "default": [
          {
            "widget": "Stats",
            "props": {
              "tagline": "Field data, not a lab score",
              "title": "Core Web Vitals from real visitors",
              "subtitle": "28-day field percentiles from sites in production, with the threshold next to each number.",
              "items": [
                {
                  "value": "0.9s",
                  "label": "LCP · good under 2.5s"
                },
                {
                  "value": "42ms",
                  "label": "INP · good under 200ms"
                },
                {
                  "value": "0.00",
                  "label": "CLS · good under 0.1"
                },
                {
                  "value": "0.18s",
                  "label": "TTFB · good under 0.8s"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "widget": "Preset",
      "props": {
        "name": "faq-agencies"
      },
      "notes": "Inserted from the presets collection; edit the preset to change it everywhere it is used."
    },
    {
      "widget": "Section",
      "props": {
        "tone": "primary",
        "id": "get",
        "label": "Get it"
      },
      "slots": {
        "default": [
          {
            "widget": "CallToAction",
            "props": {
              "layout": "band",
              "title": "Same command as the top of the page",
              "subtitle": "npm create parche@latest my-site",
              "actions": [
                {
                  "text": "Clone it",
                  "href": "https://github.com/withparche/parche",
                  "variant": "secondary"
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
