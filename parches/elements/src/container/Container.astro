---
/**
 * Container — the horizontal measure. Widgets used to hand-roll `mx-auto
 * max-w-7xl px-4` in fourteen places with three different widths; this is the
 * one place that decision lives. Static, no tokens beyond spacing.
 */
import { cn, splitProps } from '@parche/elements/utils';
import { schema, type Props } from './container.props';

const { props: { width, padding, as: Tag }, rest, className, part } = splitProps(schema, Astro.props);

// The measures come from the conf tokens, so a site or a theme retunes the
// page grid from four knobs.
const widths: Record<typeof width, string> = {
  sm: 'max-w-(--ds-conf-width-sm)',
  md: 'max-w-(--ds-conf-width-md)',
  lg: 'max-w-(--ds-conf-width-lg)',
  xl: 'max-w-(--ds-conf-width-xl)',
  full: 'max-w-none',
};
---

<Tag
  class={cn('parche-container mx-auto w-full', widths[width], padding && 'px-(--ds-conf-gutter)', className)}
  {...rest}
  data-part={part}
  data-width={width}
>
  <slot />
</Tag>
