---
/**
 * Filter — a row of toggles over a list. Items inside the default slot say
 * what they are with `data-filter="new fixed"`; choosing an option hides the
 * items that do not carry it, updates the "Showing n of total" line, and
 * shows the empty state with a way back when nothing matches. Without script
 * the bar is hidden and everything shows.
 */
import { cn, splitProps } from '@parche/elements/utils';
import { schema } from './filter.props';

const { props: { options, label, aside, status, empty, clear, sticky }, rest, className, part } = splitProps(schema, Astro.props);
---

<parche-filter class={cn('parche-filter block', className)} {...rest} data-part={part} status-template={status}>
  <div
    class={cn(
      'parche-filter-bar flex flex-wrap items-center gap-x-3 gap-y-2 border-y border-border bg-background py-3',
      sticky && 'sticky top-[var(--parche-header-height,4.25rem)] z-10',
    )}
    data-part="bar"
    role="group"
    aria-label={label}
    hidden
  >
    <span class="mr-1 font-mono text-[10px] leading-none font-medium tracking-[0.14em] text-muted uppercase">{label}</span>
    {options.map((o, i) => (
      <button
        type="button"
        class="cursor-pointer rounded-full border border-border bg-surface px-3 py-1.5 text-xs leading-none font-medium text-heading hover:border-heading focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring aria-pressed:border-foreground aria-pressed:bg-foreground aria-pressed:text-background"
        data-part="option"
        data-value={o.value}
        data-count={o.count}
        aria-pressed={i === 0 ? 'true' : 'false'}
        data-state={i === 0 ? 'on' : 'off'}
      >
        {o.label}<span data-part="count">{o.count !== undefined ? ` · ${o.count}` : ''}</span>
      </button>
    ))}
    {aside && <span class="ml-auto text-xs leading-none text-muted">{aside}</span>}
  </div>
  <div data-part="items">
    <slot />
  </div>
  <div class="parche-filter-empty rounded-md border border-dashed border-border px-5 py-8 text-center" data-part="empty" hidden>
    <p class="text-sm text-muted">{empty}</p>
    <button type="button" class="mt-3 cursor-pointer text-sm font-semibold text-primary" data-part="clear">{clear}</button>
  </div>
  <p class="sr-only" role="status" data-part="status"></p>
</parche-filter>

<script>
  import './filter.element.ts';
</script>
