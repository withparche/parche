---
import { Icon as AstroIcon } from 'astro-icon/components';

interface Props {
  name: string;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
  [key: string]: any;
}

const { name, size = 'md', class: className = '', ...rest } = Astro.props;

const sizes: Record<string, string> = {
  xs: 'size-3',
  sm: 'size-4',
  md: 'size-5',
  lg: 'size-6',
  xl: 'size-8',
};
---

<AstroIcon {name} class:list={[sizes[size], className]} {...rest} />
