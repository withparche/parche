---
interface Props {
  src?: string;
  alt?: string;
  name?: string;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { src, alt = '', name = '', size = 'md', class: className = '' } = Astro.props;

const sizes: Record<string, string> = {
  xs: 'size-6 text-xs',
  sm: 'size-8 text-xs',
  md: 'size-10 text-sm',
  lg: 'size-12 text-base',
  xl: 'size-16 text-lg',
};

// Generate initials from name (max 2 chars)
const initials = name
  .split(' ')
  .map((word: string) => word[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

{src ? (
  <img
    src={src}
    alt={alt || name}
    class:list={[
      'rounded-full object-cover bg-surface shrink-0',
      sizes[size],
      className,
    ]}
    loading="lazy"
    decoding="async"
  />
) : (
  <span class:list={[
    'rounded-full bg-primary/10 text-primary font-semibold flex items-center justify-center shrink-0',
    sizes[size],
    className,
  ]}>
    {initials || '?'}
  </span>
)}
