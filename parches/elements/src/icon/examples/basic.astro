---
import Icon from '../Icon.astro';
---

<div class="flex flex-wrap items-center gap-4 text-heading">
  <Icon name="tabler:arrow-right" size="xs" />
  <Icon name="tabler:arrow-right" size="sm" />
  <Icon name="tabler:arrow-right" size="md" />
  <Icon name="tabler:arrow-right" size="lg" />
  <Icon name="tabler:arrow-right" size="xl" />
</div>
<div class="mt-4 flex flex-wrap items-center gap-4">
  <span class="text-primary"><Icon name="tabler:check" label="Included" /></span>
  <span class="text-muted"><Icon name="tabler:mail" /> Decorative, next to text</span>
</div>
