---
import Image from '../Image.astro';
const src = 'https://images.unsplash.com/photo-1519681393784-d120267933ba?w=800&q=60';
---

<div class="grid gap-4 sm:grid-cols-3">
  <Image src={src} alt="Snowy mountains at night" width={400} ratio="1/1" class="rounded-lg" />
  <Image src={src} alt="Snowy mountains at night" width={400} ratio="4/3" class="rounded-lg" />
  <Image src={src} alt="Snowy mountains at night" width={400} ratio="16/9" class="rounded-lg" />
</div>
