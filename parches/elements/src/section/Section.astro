---
/**
 * Section — a full-width band with vertical rhythm. Pair it with a Container
 * inside for the horizontal measure. `surface` paints it on the surface token,
 * which is how pages alternate bands without raw colours.
 */
import { cn, splitProps } from '@parche/elements/utils';
import { schema, type Props } from './section.props';

const { props: { padding, surface, as: Tag }, rest, className, part } = splitProps(schema, Astro.props);

// The rhythm comes from the conf tokens, so a theme retunes every band from
// three knobs instead of restyling the element.
const paddings: Record<typeof padding, string> = {
  none: '',
  sm: 'py-(--ds-conf-spacing-sm)',
  md: 'py-(--ds-conf-spacing-md)',
  lg: 'py-(--ds-conf-spacing-lg)',
};
---

<Tag
  class={cn('parche-section', paddings[padding], surface && 'bg-surface', className)}
  {...rest}
  data-part={part}
  data-padding={padding}
  data-state={surface ? 'surface' : undefined}
>
  <slot />
</Tag>
