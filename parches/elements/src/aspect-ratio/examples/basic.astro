---
import AspectRatio from '../AspectRatio.astro';
---

<div class="grid max-w-2xl gap-4 sm:grid-cols-2">
  <AspectRatio ratio="16/9" class="rounded-lg">
    <img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=800&q=60" alt="A mountain ridge at dawn" loading="lazy" />
  </AspectRatio>
  <AspectRatio ratio="1/1" class="rounded-lg">
    <img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=800&q=60" alt="The same ridge, cropped square" loading="lazy" />
  </AspectRatio>
</div>
