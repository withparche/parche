---
/**
 * Placeholder — a striped stand-in for an image, with a caption chip saying
 * what goes there. The ratio is the striped area's, with the padding around
 * it, as mock-ups draw a placeholder. The stripes are two component tokens, defaulting to the
 * second surface and a mix towards the border, so a theme can match its own
 * mock-ups exactly.
 */
import { cn, splitProps } from '@parche/elements/utils';
import { schema, type Props } from './placeholder.props';

const { props: { caption, label, ratio, stripe, compact }, rest, className, part } = splitProps(schema, Astro.props);
const stripes =
  'repeating-linear-gradient(135deg,' +
  ` var(--ds-comp-placeholder-stripe-a, var(--ds-sys-color-surface-2)) 0 ${stripe}px,` +
  ` var(--ds-comp-placeholder-stripe-b, color-mix(in oklab, var(--ds-sys-color-border) 70%, var(--ds-sys-color-surface-2))) ${stripe}px ${stripe * 2}px)`;
---

<div
  class={cn('parche-placeholder box-content flex items-end', compact ? 'p-3.5' : 'p-4', className)}
  style={`aspect-ratio: ${ratio}; background: ${stripes};`}
  role="img"
  aria-label={caption ?? label ?? 'Image to come'}
  {...rest}
  data-part={part}
>
  {caption && (
    <span
      class={cn(
        'parche-placeholder-caption border border-border bg-background font-mono leading-none font-medium tracking-[0.08em] text-muted uppercase',
        compact ? 'rounded-[6px] px-2 py-1.5 text-[10px]' : 'rounded-[7px] px-[9px] py-[7px] text-[11px]',
      )}
      data-part="caption"
      aria-hidden="true"
    >{caption}</span>
  )}
</div>
