---
/**
 * Calculator — numbers the reader sets (a stepper or a slider) and results a
 * formula makes of them. The server computes the results for the starting
 * values, so the page reads right without script; the element recomputes on
 * every change, keeps the inputs in the URL when `share` is on, and copies
 * the link. Formulas are plain arithmetic on the input names (formula.ts).
 */
import { cn, splitProps } from '@parche/elements/utils';
import { schema } from './calculator.props';
import { evaluate, format } from './formula';

const { props: { inputs, results, share, locale }, rest, className, part } = splitProps(schema, Astro.props);
const vars = Object.fromEntries(inputs.map((i) => [i.name, i.value]));
const button = 'flex size-9 cursor-pointer items-center justify-center rounded-sm border border-border bg-surface text-base leading-none text-heading hover:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring';
---

<parche-calculator class={cn('parche-calculator block', className)} {...rest} data-part={part} locale={locale} data-share={share ? '' : undefined}>
  <div class="flex flex-col gap-4">
    {inputs.map((i) => (
      <div class="flex flex-wrap items-center justify-between gap-3" data-part="input" data-name={i.name}>
        <label for={`calc-${i.name}`} class="text-sm leading-[1.4] text-heading">{i.label}</label>
        {i.control === 'range' ? (
          <span class="flex min-w-[220px] flex-1 items-center gap-3">
            <input id={`calc-${i.name}`} type="range" name={i.name} min={i.min} max={i.max} step={i.step} value={i.value} class="flex-1 accent-(--ds-sys-color-primary)" />
            <output for={`calc-${i.name}`} class="min-w-[5ch] text-right font-mono text-sm text-heading" data-part="echo">{i.prefix}{i.value}{i.suffix}</output>
          </span>
        ) : (
          <span class="flex items-center gap-1.5">
            <button type="button" class={button} data-part="decrement" aria-label={`Less ${i.label}`}>−</button>
            <input id={`calc-${i.name}`} type="number" name={i.name} min={i.min} max={i.max} step={i.step} value={i.value} inputmode="decimal" class="w-[7ch] rounded-sm border border-border bg-background px-2 py-2 text-center font-mono text-sm text-heading" />
            <button type="button" class={button} data-part="increment" aria-label={`More ${i.label}`}>+</button>
            {i.suffix && <span class="ml-1 text-xs text-muted">{i.suffix}</span>}
          </span>
        )}
      </div>
    ))}
  </div>
  <div class="mt-5 flex flex-col gap-2 border-t border-border pt-5" aria-live="polite">
    {results.map((r) => (
      <div class="flex flex-wrap items-baseline justify-between gap-2" data-part="result" data-formula={r.formula} data-decimals={r.decimals} data-prefix={r.prefix ?? ''} data-suffix={r.suffix ?? ''}>
        <span class="text-sm text-muted">{r.label}</span>
        <output class="font-heading text-[clamp(1.5rem,3vw,2rem)] leading-none font-semibold tracking-[-0.02em] text-heading tabular-nums" data-part="value">{r.prefix}{format(evaluate(r.formula, vars), r.decimals, locale)}{r.suffix}</output>
        {r.note && <p class="basis-full text-xs leading-[1.5] text-muted">{r.note}</p>}
      </div>
    ))}
  </div>
  {share && (
    <div class="mt-4 flex flex-col gap-2" data-share-row hidden>
      <div class="flex items-center gap-2">
        <code class="min-w-0 flex-1 truncate rounded-sm border border-border bg-background px-2.5 py-2 font-mono text-xs text-muted" data-part="link"></code>
        <button type="button" class="shrink-0 cursor-pointer rounded-sm border border-border bg-surface px-3 py-2 text-xs font-medium text-heading hover:border-primary" data-part="share" data-copied={share.copiedLabel}>{share.label}</button>
      </div>
      {share.note && <p class="text-xs leading-[1.5] text-muted">{share.note}</p>}
    </div>
  )}
</parche-calculator>

<script>
  import './calculator.element.ts';
</script>
