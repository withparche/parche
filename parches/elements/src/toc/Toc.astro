---
/**
 * Toc — in-page links, one per heading, that behave one way and never grow
 * past a height: the list scrolls inside a capped box (the
 * `--ds-comp-toc-max-height` token, `min(22rem, 50vh)` by default) whose
 * edges fade where there is more. The element marks every section in view
 * on a track at the left, the one being read with `aria-current="true"`,
 * opens that section's subsections and closes the others, and keeps the
 * current link in view inside the box. Items nest; the caller decides how
 * deep. `layout="disclosure"` puts it all behind a closed "On this page",
 * for narrow screens.
 */
import { cn, splitProps } from '@parche/elements/utils';
import Outline from './Outline.astro';
import { schema, type Props } from './toc.props';

const { props: { items, title, label, offset, layout }, rest, className, part } = splitProps(schema, Astro.props);
---

<parche-toc
  class={cn('parche-toc block text-sm', className)}
  {...rest}
  data-part={part}
  offset={offset}
>
  <nav aria-label={label} data-part="nav">
    {layout === 'disclosure' ? (
      <details class="parche-toc-disclosure group rounded-lg border border-border" data-part="disclosure">
        <summary class="parche-toc-title flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 font-semibold text-heading focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ring [&::-webkit-details-marker]:hidden" data-part="title">
          {title}
          <svg class="size-4 shrink-0 text-muted transition-transform group-open:rotate-180 motion-reduce:transition-none" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
        </summary>
        <div class="px-4 pb-4">
          <Outline items={items} />
        </div>
      </details>
    ) : (
      <>
        <h2 class="parche-toc-title mb-3 font-semibold text-heading" data-part="title">{title}</h2>
        <Outline items={items} />
      </>
    )}
  </nav>
</parche-toc>

<script>
  import './toc.element.ts';
</script>
