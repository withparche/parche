---
// One level of the table of contents; recurses for children. Every link
// starts at the track on the left and is indented by padding, so the
// indicator can run past all of them.
import type { TocItem } from './toc.props';

interface Props {
  items: TocItem[];
  depth: number;
}
const { items, depth } = Astro.props;
const indent = ['pl-3', 'pl-6', 'pl-9', 'pl-12', 'pl-14', 'pl-16'][depth] ?? 'pl-16';
---

<ul class:list={['parche-toc-list', depth === 0 && 'border-l border-border']} data-part="list" data-depth={depth}>
  {items.map((item) => (
    <li data-part="item">
      <a
        href={`#${item.slug}`}
        class:list={[
          'parche-toc-link block py-1 leading-snug text-muted transition-colors hover:text-heading focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ring data-[state=current]:text-heading data-[state=visible]:text-heading',
          indent,
        ]}
        data-part="link"
        data-slug={item.slug}
      >
        {item.text}
      </a>
      {item.children && item.children.length > 0 && (
        <div class="parche-toc-group" data-part="group" data-state="open">
          <Astro.self items={item.children} depth={depth + 1} />
        </div>
      )}
    </li>
  ))}
</ul>
