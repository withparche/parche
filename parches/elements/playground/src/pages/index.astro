---
import Playground from '../layouts/Playground.astro';
import { elementIndex, elementMeta } from 'parche:registry/elements';
import { grouped } from '../groups';

const nav = grouped(elementIndex.map((e) => e.name));
const byName = new Map(elementIndex.map((e) => [e.name, e]));
---

<Playground title="Elements">
  <div class="docs-ui">
  <h1 class="type-h1 mb-2">Elements</h1>
  <p class="type-body text-muted mb-10 max-w-2xl">
    {elementIndex.length} building blocks on tokens and the platform: server-rendered, accessible by contract, a custom element only where there is interactivity.
    This playground is the accessibility test fixture.
  </p>
  {nav.map((group) => (
    <section class="mb-10" aria-labelledby={`g-${group.label.toLowerCase().replace(/\s+/g, '-')}`}>
      <h2 id={`g-${group.label.toLowerCase().replace(/\s+/g, '-')}`} class="type-h3 mb-4">{group.label}</h2>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {group.names.map((name) => {
          const e = byName.get(name)!;
          const meta = elementMeta[name];
          return (
            <li class="rounded-lg border border-border bg-surface p-4">
              <div class="flex items-center justify-between gap-2">
                <a href={`/${name.toLowerCase()}`} class="font-semibold text-heading no-underline hover:text-primary">{name}</a>
                {e.interactive ? (
                  <span class="rounded-full bg-primary-soft px-2 py-0.5 text-xs text-heading">{`<${meta?.tag?.name}>`}</span>
                ) : (
                  <span class="rounded-full border border-border px-2 py-0.5 text-xs text-muted">zero JS</span>
                )}
              </div>
              <p class="mt-1 text-sm text-muted">{meta?.description ?? ''}</p>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
  </div>
</Playground>
