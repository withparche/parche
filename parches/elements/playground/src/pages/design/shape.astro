---
import DesignPage from '../../components/DesignPage.astro';
import { radii, shadows } from '../../lib/tokens';

const widths = [
  { name: 'sm', value: '48rem', note: 'prose, forms' },
  { name: 'md', value: '64rem', note: 'content' },
  { name: 'lg', value: '72rem', note: 'the default section measure' },
  { name: 'xl', value: '80rem', note: 'wide layouts, the header bar' },
  { name: 'full', value: 'none', note: 'edge to edge' },
];
---

<DesignPage title="Shape" description="There is no --ds- token for shape. Elements reach Tailwind's radius and shadow scale directly (rounded-md, shadow-lg), and the measures are Tailwind's max-w steps. A theme that wants another geometry overrides --radius-* or, as Corporate and Minimal do, flattens everything with one rule. Whether shape should become roles of the system is an open question this page exists to settle.">
  <section class="mb-12" aria-labelledby="radii">
    <h2 id="radii" class="docs-ui type-h2 mb-2">Radii</h2>
    <p class="docs-ui mb-4 text-sm text-muted"><code>--radius-*</code>, bridged as <code>rounded-*</code>. Buttons and badges use <code>full</code>; cards, dialogs and inputs <code>md</code> to <code>xl</code>.</p>
    <div class="docs-preview rounded-lg border border-(--doc-border) p-6">
      <div class="flex flex-wrap gap-6">
        {radii.map((r) => (
          <div class="text-center">
            <span class="block size-16 border-2 border-primary bg-primary-soft" style={`border-radius: var(${r.name})`}></span>
            <span class="mt-2 block font-mono text-xs text-heading">{r.name.replace('--radius-', '')}</span>
            <span class="block font-mono text-[10px] text-muted">{r.value}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mb-12" aria-labelledby="shadows">
    <h2 id="shadows" class="docs-ui type-h2 mb-2">Shadows</h2>
    <p class="docs-ui mb-4 text-sm text-muted"><code>--shadow-*</code>, bridged as <code>shadow-*</code>. Cards take <code>sm</code>, menus and popovers <code>lg</code>, dialogs <code>lg</code> too.</p>
    <div class="docs-preview rounded-lg border border-(--doc-border) p-6">
      <div class="flex flex-wrap gap-8">
        {shadows.map((s) => (
          <div class="text-center">
            <span class="block size-20 rounded-lg bg-surface" style={`box-shadow: var(${s.name})`}></span>
            <span class="mt-3 block font-mono text-xs text-heading">{s.name.replace('--shadow-', '')}</span>
          </div>
        ))}
      </div>
      <details class="mt-6 text-xs text-muted">
        <summary class="cursor-pointer">Values</summary>
        <ul class="mt-2 space-y-1 font-mono">{shadows.map((s) => <li>{s.name}: {s.value}</li>)}</ul>
      </details>
    </div>
  </section>

  <section class="mb-12" aria-labelledby="measure">
    <h2 id="measure" class="docs-ui type-h2 mb-2">Measures</h2>
    <p class="docs-ui mb-4 text-sm text-muted">The Container element owns the horizontal measure; sections pick one of five. These are Tailwind's <code>max-w-*</code> steps, not tokens, which is deliberate: a theme changes colour and type, not the page grid.</p>
    <div class="docs-ui overflow-x-auto rounded-lg border border-border">
      <table class="w-full text-sm">
        <thead><tr class="text-left text-muted"><th class="px-4 py-2">width</th><th class="px-4 py-2">max</th><th class="px-4 py-2">For</th></tr></thead>
        <tbody>{widths.map((w) => <tr class="border-t border-border"><td class="px-4 py-2 font-mono text-heading">{w.name}</td><td class="px-4 py-2 font-mono text-muted">{w.value}</td><td class="px-4 py-2 text-muted">{w.note}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="mb-12" aria-labelledby="motion">
    <h2 id="motion" class="docs-ui type-h2 mb-2">Motion</h2>
    <p class="docs-ui text-sm text-muted">There are no motion tokens. Transitions live in each element's own CSS, under <code>prefers-reduced-motion: no-preference</code>, and never carry function: the reduced-motion pass of the gate proves every element works with them off. Durations are 150 to 250 ms.</p>
  </section>
</DesignPage>
