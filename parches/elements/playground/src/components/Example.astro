---
/**
 * One example: a Preview / Code pair, built with the Tabs element. The
 * preview is the one themed canvas on the page (it keeps its `data-example`
 * wrapper, which the browser specs locate); the heading, the tab list and
 * the code are docs chrome, in the fixed palette.
 */
import Tabs from 'parche:elements/Tabs';
import { Code } from 'astro/components';

interface Props {
  element: string;
  name: string;
  description?: string;
  source: string;
  Component: any;
}
const { element, name, description, source, Component } = Astro.props;
const id = `${element.toLowerCase()}-${name}`;
// The example imports the element by a relative path; show what a site writes.
const shown = source
  .replace(/from '\.\.\/([A-Za-z]+)\.astro'/g, `from 'parche:elements/${element}'`)
  .replace(/from '\.\.\/index'/g, `from 'parche:elements/${element}'`)
  .replace(/from '\.\.\/\.\.\/([a-z-]+)\/([A-Za-z]+)\.astro'/g, "from 'parche:elements/$2'");
---

<section class="mb-12" aria-labelledby={`ex-${id}`}>
  <h3 id={`ex-${id}`} class="docs-ui type-h3 mb-1 capitalize">{name}</h3>
  {description && <p class="docs-ui mb-3 text-sm text-muted">{description}</p>}
  <Tabs id={`tabs-${id}`} class="docs-tabs" items={[{ value: 'preview', label: 'Preview' }, { value: 'code', label: 'Code' }]} label={`${name} example`} variant="pill">
    <div slot="preview" class="docs-preview rounded-lg border border-(--doc-border) p-6" data-example={name}>
      <Component />
    </div>
    <div slot="code" class="docs-ui overflow-hidden rounded-lg border border-border text-sm [&>pre]:overflow-x-auto [&>pre]:p-4">
      <Code code={shown.trim()} lang="astro" theme="github-dark" />
    </div>
  </Tabs>
</section>
