---
/**
 * The archive: the newest year by month at the archive's own address, and a
 * page per earlier year. Crawlable, and year pages with only a post or two are
 * noindex. Works in both static and SSR modes.
 */
import BlogPage from '../../components/BlogPage.astro';
import { archiveContext, baseContext } from '../../utils/context.js';
import config from 'parche:config';
import { generateItemListJsonLd } from '../../utils/blog-metadata.js';
import blogConfig from 'parche:app/blog';
import { defaultLocale, locales } from 'parche:config/i18n';
import { localizeSiteConfig } from 'parche:utils/site';
import { getRouteAlternates, toAbsolute } from '../../utils/alternates.js';
import { resolveLabels, format } from '../../labels.js';

const cfg = blogConfig as any;

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const { getPublishedPosts } = await import('../../utils/post-helpers.js');
  const showDrafts = import.meta.env.DEV && (blogConfig as any).showDraftsInDev;
  const years = [...new Set(getPublishedPosts(await getCollection('posts'), showDrafts).map((p: any) => p.data.publishDate.getUTCFullYear()))].sort((a, b) => b - a);
  // The newest year is the archive's own page; earlier years have their own.
  return [{ params: { year: undefined } }, ...years.slice(1).map((y) => ({ params: { year: String(y) } }))];
}

const locale = Astro.currentLocale ?? defaultLocale;
const showDrafts = import.meta.env.DEV && cfg.showDraftsInDev;
const opts = { cfg, locale, defaultLocale, showDrafts };
const asked = Astro.params.year ? Number(Astro.params.year) : undefined;
const archive = await archiveContext(asked, opts);

// A year this locale has no posts in, or the newest year under its own number
// (it lives at the archive's address), is not a page.
if (archive.total === 0 || (asked && (!archive.years.some((y) => y.year === asked) || asked === archive.years[0]?.year))) {
  return Astro.redirect('/404');
}

const site = localizeSiteConfig(config, locale);
const labels = resolveLabels(cfg.labels, locale, defaultLocale);
const alternates = toAbsolute(
  await getRouteAlternates({ path: `${cfg.permalinks.archive}${asked ? `/${asked}` : ''}`, locales: locales as string[], defaultLocale }),
  Astro.site,
);
const context = { ...(await baseContext('archive', opts)), posts: [], archive };
const count = archive.months.reduce((n, m) => n + m.count, 0);

const siteUrl = config.site || Astro.site?.href || '';
const metadata = {
  pageType: 'CollectionPage',
  jsonLd: [generateItemListJsonLd(archive.months.flatMap((m) => m.posts.map((x) => ({ name: x.title, url: x.href }))), siteUrl)],
  title: `${labels.archiveTitle}${asked ? ` · ${asked}` : ''} — ${site.brand.name}`,
  description: format(labels.archiveSubtitle, { total: archive.total }),
  // A year with only a post or two is a thin page: kept for readers, out of the index.
  noindex: Boolean(asked) && count < (cfg.tagIndexThreshold ?? 3),
  nofollow: false,
  ogType: 'website' as const,
  twitterCard: 'summary_large_image' as const,
};
---

<BlogPage view="archive" {context} {metadata} {site} {locale} {defaultLocale} {alternates} />
