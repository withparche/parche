---
/**
 * Posts filtered by author, with pagination.
 * Works in both static and SSR modes.
 */
import 'parche:config/styles';
import BaseLayout from 'parche:layouts/BaseLayout';
import LayoutRenderer from 'parche:LayoutRenderer';
import { showPanel } from 'parche:config/themes';
import ThemePanel from 'parche:components/ThemePanel';
import BlogList from 'parche:widgets/blog/BlogList';
import AuthorCard from 'parche:widgets/blog/AuthorCard';
import Breadcrumbs from 'parche:widgets/blog/Breadcrumbs';
import config from 'parche:config';
import blogConfig from 'parche:app/blog';
import { getCollection, getEntry } from 'astro:content';
import { queryPostsByAuthor } from '../../../utils/blog-query.js';
import { calculateReadingTime } from '../../../utils/reading-time.js';
import { resolvePostPermalink, resolveTaxonomyPermalink } from '../../../types.js';
import { resolveLayout } from 'parche:utils/layout';
import { defaultLocale } from 'parche:config/i18n';
import { extractPostLocale } from '../../../utils/post-helpers.js';
import Container from 'parche:primitives/Container';
import Section from 'parche:primitives/Section';

const cfg = blogConfig as any;
const permalinks = cfg.permalinks;

export async function getStaticPaths() {
  const { getCollection: gc } = await import('astro:content');
  const { extractPostLocale: epl } = await import('../../../utils/post-helpers.js');
  const { queryPostsByAuthor: qpa } = await import('../../../utils/blog-query.js');
  const { locales, defaultLocale: dl } = await import('parche:config/i18n');
  const allAuthors = await gc('authors');
  const allLocales: string[] = (locales as any) ?? [dl];
  const isDev = import.meta.env.DEV;
  const showDrafts = isDev && (blogConfig as any).showDraftsInDev;
  const pageSize = (blogConfig as any).postsPerPage ?? 12;

  // Deduplicate authors by key
  const seen = new Set<string>();
  const uniqueAuthors = allAuthors.filter((a: any) => {
    const { postKey } = epl(a.id);
    if (seen.has(postKey)) return false;
    seen.add(postKey);
    return true;
  });

  // For each author, compute max pages across all locales
  const authorMaxPages = new Map<string, number>();
  for (const author of uniqueAuthors) {
    const { postKey: authorKey } = epl(author.id);
    const slug = (author.data as any).slug ?? authorKey;
    const key = slug.toLowerCase();
    for (const locale of allLocales) {
      const result = await qpa({ authorKey, locale, page: 1, pageSize, showDrafts });
      authorMaxPages.set(key, Math.max(authorMaxPages.get(key) ?? 0, result.lastPage));
    }
  }

  const paths: { params: { author: string; page: string | undefined } }[] = [];
  for (const [author, maxPages] of authorMaxPages) {
    for (let i = 1; i <= maxPages; i++) {
      paths.push({ params: { author, page: i === 1 ? undefined : String(i) } });
    }
  }
  return paths;
}

// --- Render-time ---
const locale = Astro.currentLocale ?? defaultLocale;
const { author } = Astro.params;
const isDev = import.meta.env.DEV;
const showDrafts = isDev && cfg.showDraftsInDev;
const pageNum = parseInt(Astro.params.page ?? '') || 1;
const authorBaseUrl = resolveTaxonomyPermalink(permalinks.author, author!);

const page = await queryPostsByAuthor({
  authorKey: author!,
  locale,
  page: pageNum,
  pageSize: cfg.postsPerPage ?? 12,
  showDrafts,
  baseUrl: authorBaseUrl,
});

// Resolve author data (try locale-prefixed then bare)
let authorData: any = { name: author };
try {
  const authorEntry = await getEntry('authors', `${locale}/${author}`)
    ?? await getEntry('authors', author as any);
  if (authorEntry) authorData = authorEntry.data;
} catch { /* fallback to slug as name */ }

const layoutSections = await resolveLayout('default', locale, defaultLocale);

const posts = page.data.map((post: any) => {
  const rt = cfg.readingTime
    ? calculateReadingTime(post.body ?? '', cfg.wordsPerMinute)
    : null;
  return {
    title: post.data.title,
    description: post.data.description ?? post.data.excerpt,
    href: resolvePostPermalink(permalinks.post, post),
    image: post.data.image,
    publishDate: post.data.publishDate,
    category: post.data.category,
    tags: post.data.tags,
    readingTime: post.data.readingTime ?? rt?.minutes,
    categoryHref: post.data.category ? resolveTaxonomyPermalink(permalinks.category, post.data.category) : undefined,
    tagHrefs: post.data.tags?.map((t: string) => resolveTaxonomyPermalink(permalinks.tag, t)),
  };
});

const metadata = {
  title: `${authorData.name} — ${config.site.name}`,
  description: authorData.bio ?? `Posts by ${authorData.name}`,
  noindex: false,
  nofollow: false,
  ogType: 'profile' as const,
  twitterCard: 'summary_large_image' as const,
};

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: permalinks.listing },
  { label: authorData.name },
];
---

<BaseLayout metadata={metadata} config={config} lang={locale}>
  <LayoutRenderer layoutSections={layoutSections}>
    <Section class="!py-4">
      <Container class="max-w-6xl">
        <Breadcrumbs items={breadcrumbs} />
      </Container>
    </Section>

    <Section class="!py-8">
      <Container class="max-w-4xl">
        <AuthorCard
          name={authorData.name}
          bio={authorData.bio}
          avatar={authorData.avatar}
          role={authorData.role}
          social={authorData.social}
        />
      </Container>
    </Section>

    <BlogList
      title={`Posts by ${authorData.name}`}
      posts={posts}
      currentPage={page.currentPage}
      totalPages={page.lastPage}
      baseUrl={authorBaseUrl}
    />
  </LayoutRenderer>
  {showPanel && <ThemePanel />}
</BaseLayout>
