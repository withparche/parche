---
/**
 * Posts filtered by author, with pagination.
 * Works in both static and SSR modes.
 */
import { blogMetadata } from '../../../utils/page-metadata.js';
import BlogPage from '../../../components/BlogPage.astro';
import { baseContext, toCards, toPage, writersContext } from '../../../utils/context.js';
import config from 'parche:config';
import { generateItemListJsonLd, generatePersonJsonLd } from '../../../utils/blog-metadata.js';
import blogConfig from 'parche:app/blog';
import { getCollection, getEntry } from 'astro:content';
import { queryPostsByAuthor } from '../../../utils/blog-query.js';
import { resolveTaxonomyPermalink } from '../../../types.js';
import { defaultLocale, locales } from 'parche:config/i18n';
import { localizeSiteConfig } from 'parche:utils/site';
import { getRouteAlternates, toAbsolute } from '../../../utils/alternates.js';
import { resolveAssets } from 'parche:utils/assets';
import { resolveLabels, format } from '../../../labels.js';
import { extractPostLocale } from '../../../utils/post-helpers.js';

const cfg = blogConfig as any;
const permalinks = cfg.permalinks;

export async function getStaticPaths() {
  const { getCollection: gc } = await import('astro:content');
  const { extractPostLocale: epl } = await import('../../../utils/post-helpers.js');
  const { queryPostsByAuthor: qpa } = await import('../../../utils/blog-query.js');
  const { locales, defaultLocale: dl } = await import('parche:config/i18n');
  const allAuthors = await gc('authors');
  const allLocales: string[] = (locales as any) ?? [dl];
  const isDev = import.meta.env.DEV;
  const showDrafts = isDev && (blogConfig as any).showDraftsInDev;
  const pageSize = (blogConfig as any).postsPerPage ?? 12;

  // Deduplicate authors by key
  const seen = new Set<string>();
  const uniqueAuthors = allAuthors.filter((a: any) => {
    const { postKey } = epl(a.id);
    if (seen.has(postKey)) return false;
    seen.add(postKey);
    return true;
  });

  // For each author, compute max pages across all locales
  const authorMaxPages = new Map<string, number>();
  for (const author of uniqueAuthors) {
    const { postKey: authorKey } = epl(author.id);
    const slug = (author.data as any).urlSlug ?? authorKey;
    const key = slug.toLowerCase();
    for (const locale of allLocales) {
      const result = await qpa({ authorKey, locale, page: 1, pageSize, showDrafts });
      authorMaxPages.set(key, Math.max(authorMaxPages.get(key) ?? 0, result.lastPage));
    }
  }

  const paths: { params: { author: string; page: string | undefined } }[] = [];
  for (const [author, maxPages] of authorMaxPages) {
    for (let i = 1; i <= maxPages; i++) {
      paths.push({ params: { author, page: i === 1 ? undefined : String(i) } });
    }
  }
  return paths;
}

// --- Render-time ---
const locale = Astro.currentLocale ?? defaultLocale;
const { author } = Astro.params;
const isDev = import.meta.env.DEV;
const showDrafts = isDev && cfg.showDraftsInDev;
const pageNum = parseInt(Astro.params.page ?? '') || 1;
const authorBaseUrl = resolveTaxonomyPermalink(permalinks.author, author!, locale, defaultLocale);

const page = await queryPostsByAuthor({
  authorKey: author!,
  locale,
  page: pageNum,
  pageSize: cfg.postsPerPage ?? 12,
  showDrafts,
  baseUrl: authorBaseUrl,
});

// Resolve author data (try locale-prefixed then bare)
let authorData: any = { name: author };
try {
  const authorEntry = await getEntry('authors', `${locale}/${author}`)
    ?? await getEntry('authors', author as any);
  if (authorEntry) authorData = authorEntry.data;
} catch { /* fallback to slug as name */ }


// The entrypoint is shared by /author and /<locale>/author, and Astro caches
// getStaticPaths per component — so the generated path set is the union across
// locales. Anything absent in *this* locale is sent to 404 here instead of being
// rendered as an empty, indexable page.
if (page.data.length === 0 || pageNum > page.lastPage) {
  return Astro.redirect('/404');
}

const site = localizeSiteConfig(config, locale);
const labels = resolveLabels(cfg.labels, locale, defaultLocale);
const resolvedAuthor = await resolveAssets(authorData);
// An author page only exists in a locale where they have published something.
const alternates = toAbsolute(
  await getRouteAlternates({
    path: authorBaseUrl.replace(new RegExp(`^/${locale}(?=/)`), ''),
    locales: locales as string[],
    defaultLocale,
    hasContent: async (l) =>
      (await queryPostsByAuthor({ authorKey: author!, locale: l, page: 1, pageSize: 1, showDrafts })).total > 0,
  }),
  Astro.site,
);

const social = (authorData.social ?? {}) as Record<string, string | undefined>;
const links = [
  ...(authorData.website ? [{ label: 'Website', href: authorData.website }] : []),
  ...Object.entries(social).filter(([, href]) => href).map(([k, href]) => ({ label: k.charAt(0).toUpperCase() + k.slice(1), href: href! })),
];
const opts = { cfg, locale, defaultLocale, showDrafts };
const context = {
  ...(await baseContext('author', opts)),
  posts: await toCards(page.data, opts),
  page: toPage(page, authorBaseUrl),
  author: {
    name: authorData.name,
    ...(authorData.role ? { role: authorData.role } : {}),
    ...(authorData.bio ? { bio: authorData.bio } : {}),
    ...(resolvedAuthor.avatar ? { avatar: resolvedAuthor.avatar } : {}),
    links,
    count: page.total,
  },
  writers: await writersContext(opts),
};

const siteUrl = config.site || Astro.site?.href || '';
const metadata = blogMetadata(site, locale, {
  pageType: 'ProfilePage',
  jsonLd: [generatePersonJsonLd({ name: authorData.name, role: authorData.role, bio: authorData.bio, image: resolvedAuthor.avatar?.src, url: authorBaseUrl, sameAs: links.map((l) => l.href) }, siteUrl), generateItemListJsonLd(context.posts.map((c) => ({ name: c.title, url: c.href })), siteUrl)],
  title: `${authorData.name}${pageNum > 1 ? ` · ${pageNum}` : ''}`,
  description: authorData.bio ?? format(labels.authorTitle, { value: authorData.name }),
  noindex: false,
  ogType: 'profile' as const,
});
---

<BlogPage view="author" {context} {metadata} {site} {locale} {defaultLocale} {alternates} />
