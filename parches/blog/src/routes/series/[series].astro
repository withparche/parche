---
/**
 * Series overview page.
 * Works in both static and SSR modes.
 */
import BlogPage from '../../components/BlogPage.astro';
import { baseContext, seriesContext } from '../../utils/context.js';
import config from 'parche:config';
import blogConfig from 'parche:app/blog';
import { queryPostsBySeries, queryAllSeries } from '../../utils/blog-query.js';
import { defaultLocale, locales } from 'parche:config/i18n';
import { resolveTaxonomyPermalink } from '../../types.js';
import { getRouteAlternates, toAbsolute } from '../../utils/alternates.js';
import { localizeSiteConfig } from 'parche:utils/site';
import { resolveLabels, format } from '../../labels.js';

const cfg = blogConfig as any;
const permalinks = cfg.permalinks;

export async function getStaticPaths() {
  const { queryAllSeries: qas } = await import('../../utils/blog-query.js');
  const { locales, defaultLocale: dl } = await import('parche:config/i18n');
  const allLocales: string[] = (locales as any) ?? [dl];
  const isDev = import.meta.env.DEV;
  const showDrafts = isDev && (blogConfig as any).showDraftsInDev;

  // Collect all series names across all locales
  const allNames = new Set<string>();
  for (const locale of allLocales) {
    const names = await qas(locale, showDrafts);
    for (const name of names) allNames.add(name);
  }

  return [...allNames].map((name) => ({
    params: { series: name.toLowerCase().replace(/\s+/g, '-') },
    props: { seriesName: name },
  }));
}

// --- Render-time ---
const locale = Astro.currentLocale ?? defaultLocale;
const seriesName = Astro.props.seriesName ?? Astro.params.series;
const isDev = import.meta.env.DEV;
const showDrafts = isDev && cfg.showDraftsInDev;

const posts = await queryPostsBySeries({ seriesName, locale, showDrafts });

// Series names are unioned across locales in getStaticPaths (shared entrypoint),
// so a series that has no posts in *this* locale must 404 rather than render empty.
if (posts.length === 0) {
  return Astro.redirect('/404');
}

const site = localizeSiteConfig(config, locale);
const labels = resolveLabels(cfg.labels, locale, defaultLocale);
const alternates = toAbsolute(
  await getRouteAlternates({
    path: resolveTaxonomyPermalink(permalinks.series, seriesName),
    locales: locales as string[],
    defaultLocale,
    hasContent: async (l) => (await queryPostsBySeries({ seriesName, locale: l, showDrafts })).length > 0,
  }),
  Astro.site,
);

const opts = { cfg, locale, defaultLocale, showDrafts };
const series = await seriesContext(seriesName, posts, opts);
const context = { ...(await baseContext('series', opts)), posts: [], series };

const metadata = {
  title: `${series.title} — ${site.brand.name}`,
  description: series.description ?? format(labels.seriesDescription, { value: series.title }),
  noindex: false,
  nofollow: false,
  ogType: 'website' as const,
  twitterCard: 'summary_large_image' as const,
};
---

<BlogPage view="series" {context} {metadata} {site} {locale} {defaultLocale} {alternates} />
