---
/**
 * Posts filtered by category, with pagination.
 * Works in both static and SSR modes.
 */
import BlogPage from '../../../components/BlogPage.astro';
import { baseContext, toCards, toPage } from '../../../utils/context.js';
import config from 'parche:config';
import blogConfig from 'parche:app/blog';
import { queryPostsByCategory, queryAllCategories } from '../../../utils/blog-query.js';
import { resolveTaxonomyPermalink } from '../../../types.js';
import { defaultLocale, locales } from 'parche:config/i18n';
import { localizeSiteConfig } from 'parche:utils/site';
import { getRouteAlternates, toAbsolute } from '../../../utils/alternates.js';
import { resolveTerm, resolveSlug } from '../../../utils/taxonomy.js';
import { resolveLabels, format } from '../../../labels.js';

const cfg = blogConfig as any;
const permalinks = cfg.permalinks;

export async function getStaticPaths() {
  const { queryAllCategories: qac, queryPostsByCategory: qpc } = await import('../../../utils/blog-query.js');
  const { locales, defaultLocale: dl } = await import('parche:config/i18n');
  const allLocales: string[] = (locales as any) ?? [dl];
  const isDev = import.meta.env.DEV;
  const showDrafts = isDev && (blogConfig as any).showDraftsInDev;
  const pageSize = (blogConfig as any).postsPerPage ?? 12;

  // The path parameter is the term's resolved slug, as for tags: links go
  // through the same resolver, so a category with spaces, accents or a
  // declared slug is generated where its links point.
  const { resolveTerm: rt } = await import('../../../utils/taxonomy.js');
  const catMaxPages = new Map<string, number>();
  for (const locale of allLocales) {
    const cats = await qac(locale, showDrafts);
    for (const [cat, count] of cats) {
      const pages = Math.max(1, Math.ceil(count / pageSize));
      const { slug } = await rt('categories', cat, locale);
      catMaxPages.set(slug, Math.max(catMaxPages.get(slug) ?? 0, pages));
    }
  }

  const paths: { params: { category: string; page: string | undefined } }[] = [];
  for (const [category, maxPages] of catMaxPages) {
    for (let i = 1; i <= maxPages; i++) {
      paths.push({ params: { category, page: i === 1 ? undefined : String(i) } });
    }
  }
  return paths;
}

// --- Render-time ---
const locale = Astro.currentLocale ?? defaultLocale;
const { category } = Astro.params;
const isDev = import.meta.env.DEV;
const showDrafts = isDev && cfg.showDraftsInDev;
const pageNum = parseInt(Astro.params.page ?? '') || 1;
const knownCategories = [...(await queryAllCategories(locale, showDrafts)).keys()];
const term = await resolveSlug('categories', category!, locale, knownCategories);
if (!term) {
  return Astro.redirect('/404');
}

const categoryBaseUrl = resolveTaxonomyPermalink(permalinks.category, term.slug, locale, defaultLocale);

const page = await queryPostsByCategory({
  category: term.key,
  locale,
  page: pageNum,
  pageSize: cfg.postsPerPage ?? 12,
  showDrafts,
  baseUrl: categoryBaseUrl,
});


// The entrypoint is shared by /category and /<locale>/category, and Astro caches
// getStaticPaths per component — so the generated path set is the union across
// locales. Anything absent in *this* locale is sent to 404 here instead of being
// rendered as an empty, indexable page.
if (page.data.length === 0 || pageNum > page.lastPage) {
  return Astro.redirect('/404');
}

const site = localizeSiteConfig(config, locale);
const labels = resolveLabels(cfg.labels, locale, defaultLocale);
// A category only exists in a locale if some post there uses it.
const alternates = toAbsolute(
  await getRouteAlternates({
    pathFor: async (l) =>
      resolveTaxonomyPermalink(permalinks.category, (await resolveTerm('categories', term.key, l)).slug),
    locales: locales as string[],
    defaultLocale,
    hasContent: async (l) =>
      (await queryPostsByCategory({ category: term.key, locale: l, page: 1, pageSize: 1, showDrafts })).total > 0,
  }),
  Astro.site,
);

const opts = { cfg, locale, defaultLocale, showDrafts };
const context = {
  ...(await baseContext('taxonomy', opts)),
  posts: await toCards(page.data, opts),
  page: toPage(page, categoryBaseUrl),
  term: { kind: 'categories' as const, name: term.title, href: categoryBaseUrl, count: page.total, ...(term.description ? { description: term.description } : {}) },
};

const metadata = {
  title: `${format(labels.categoryTitle, { value: term.title })}${pageNum > 1 ? ` · ${pageNum}` : ''} — ${site.brand.name}`,
  description: term.description ?? format(labels.categoryDescription, { value: term.title }),
  noindex: false,
  nofollow: false,
  ogType: 'website' as const,
  twitterCard: 'summary_large_image' as const,
};
---

<BlogPage view="taxonomy" {context} {metadata} {site} {locale} {defaultLocale} {alternates} />
