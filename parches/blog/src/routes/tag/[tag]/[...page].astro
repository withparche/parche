---
/**
 * Posts filtered by tag, with pagination.
 * Works in both static and SSR modes.
 */
import BlogPage from '../../../components/BlogPage.astro';
import { baseContext, toCards, toPage } from '../../../utils/context.js';
import config from 'parche:config';
import { generateItemListJsonLd } from '../../../utils/blog-metadata.js';
import blogConfig from 'parche:app/blog';
import { queryPostsByTag, queryAllTags } from '../../../utils/blog-query.js';
import { resolveTaxonomyPermalink } from '../../../types.js';
import { defaultLocale, locales } from 'parche:config/i18n';
import { localizeSiteConfig } from 'parche:utils/site';
import { getRouteAlternates, toAbsolute } from '../../../utils/alternates.js';
import { resolveTerm, resolveSlug } from '../../../utils/taxonomy.js';
import { resolveLabels, format } from '../../../labels.js';

const cfg = blogConfig as any;
const permalinks = cfg.permalinks;

export async function getStaticPaths() {
  const { queryAllTags: qat, queryPostsByTag: qpt } = await import('../../../utils/blog-query.js');
  const { locales, defaultLocale: dl } = await import('parche:config/i18n');
  const allLocales: string[] = (locales as any) ?? [dl];
  const isDev = import.meta.env.DEV;
  const showDrafts = isDev && (blogConfig as any).showDraftsInDev;
  const pageSize = (blogConfig as any).postsPerPage ?? 12;

  // Collect all tags across all locales and compute max pages per tag. The path
  // parameter is the term's resolved slug, which a declared term can override —
  // link generation goes through the same resolver so the two cannot drift.
  const { resolveTerm: rt } = await import('../../../utils/taxonomy.js');
  const tagMaxPages = new Map<string, number>();
  for (const locale of allLocales) {
    const tags = await qat(locale, showDrafts);
    for (const [tag, count] of tags) {
      const pages = Math.max(1, Math.ceil(count / pageSize));
      const { slug } = await rt('tags', tag, locale);
      tagMaxPages.set(slug, Math.max(tagMaxPages.get(slug) ?? 0, pages));
    }
  }

  const paths: { params: { tag: string; page: string | undefined } }[] = [];
  for (const [tag, maxPages] of tagMaxPages) {
    for (let i = 1; i <= maxPages; i++) {
      paths.push({ params: { tag, page: i === 1 ? undefined : String(i) } });
    }
  }
  return paths;
}

// --- Render-time ---
const locale = Astro.currentLocale ?? defaultLocale;
const { tag } = Astro.params;
const isDev = import.meta.env.DEV;
const showDrafts = isDev && cfg.showDraftsInDev;
const pageNum = parseInt(Astro.params.page ?? '') || 1;

// The parameter is a slug; the queries match on the value as written in
// frontmatter, so resolve it back. A slug with no term in this locale means the
// page was generated for another language and must 404, not render empty.
const knownTags = [...(await queryAllTags(locale, showDrafts)).keys()];
const term = await resolveSlug('tags', tag!, locale, knownTags);
if (!term) {
  return Astro.redirect('/404');
}

const tagBaseUrl = resolveTaxonomyPermalink(permalinks.tag, term.slug, locale, defaultLocale);

const page = await queryPostsByTag({
  tag: term.key,
  locale,
  page: pageNum,
  pageSize: cfg.postsPerPage ?? 12,
  showDrafts,
  baseUrl: tagBaseUrl,
});


// The entrypoint is shared by /tag and /<locale>/tag, and Astro caches
// getStaticPaths per component — so the generated path set is the union across
// locales. Anything absent in *this* locale is sent to 404 here instead of being
// rendered as an empty, indexable page.
if (page.data.length === 0 || pageNum > page.lastPage) {
  return Astro.redirect('/404');
}

const site = localizeSiteConfig(config, locale);
const labels = resolveLabels(cfg.labels, locale, defaultLocale);
// A tag only exists in a locale if some post there carries it.
const alternates = toAbsolute(
  await getRouteAlternates({
    pathFor: async (l) =>
      resolveTaxonomyPermalink(permalinks.tag, (await resolveTerm('tags', term.key, l)).slug),
    locales: locales as string[],
    defaultLocale,
    hasContent: async (l) =>
      (await queryPostsByTag({ tag: term.key, locale: l, page: 1, pageSize: 1, showDrafts })).total > 0,
  }),
  Astro.site,
);

const opts = { cfg, locale, defaultLocale, showDrafts };
const context = {
  ...(await baseContext('taxonomy', opts)),
  posts: await toCards(page.data, opts),
  page: toPage(page, tagBaseUrl),
  term: { kind: 'tags' as const, name: term.title, href: tagBaseUrl, count: page.total, ...(term.description ? { description: term.description } : {}) },
};

const siteUrl = config.site || Astro.site?.href || '';
const metadata = {
  pageType: 'CollectionPage',
  jsonLd: [generateItemListJsonLd(context.posts.map((c) => ({ name: c.title, url: c.href })), siteUrl)],
  title: `${format(labels.tagTitle, { value: term.title })}${pageNum > 1 ? ` · ${pageNum}` : ''} — ${site.brand.name}`,
  description: term.description ?? format(labels.tagDescription, { value: term.title }),
  // A tag with only a post or two is a thin page: kept for readers, out of the index.
  noindex: page.total < (cfg.tagIndexThreshold ?? 3),
  nofollow: false,
  ogType: 'website' as const,
  twitterCard: 'summary_large_image' as const,
};
---

<BlogPage view="taxonomy" {context} {metadata} {site} {locale} {defaultLocale} {alternates} />
