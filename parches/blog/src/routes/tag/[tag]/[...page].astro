---
/**
 * Posts filtered by tag, with pagination.
 * Works in both static and SSR modes.
 */
import 'parche:config/styles';
import BaseLayout from 'parche:layouts/BaseLayout';
import LayoutRenderer from 'parche:LayoutRenderer';
import { showPanel } from 'parche:config/themes';
import ThemePanel from 'parche:components/ThemePanel';
import BlogList from 'parche:widgets/blog/BlogList';
import Breadcrumbs from 'parche:widgets/blog/Breadcrumbs';
import config from 'parche:config';
import blogConfig from 'parche:app/blog';
import { queryPostsByTag, queryAllTags } from '../../../utils/blog-query.js';
import { calculateReadingTime } from '../../../utils/reading-time.js';
import { resolvePostPermalink, resolveTaxonomyPermalink, localizePath } from '../../../types.js';
import { resolveLayout } from 'parche:utils/layout';
import { defaultLocale, locales } from 'parche:config/i18n';
import { localizeSiteConfig } from 'parche:utils/site';
import { getRouteAlternates, toAbsolute } from '../../../utils/alternates.js';
import { resolveTerm, resolveSlug, createTaxonomyResolver } from '../../../utils/taxonomy.js';
import { resolveAssets } from 'parche:utils/assets';
import { resolveLabels, format } from '../../../labels.js';
import Container from 'parche:primitives/Container';
import Section from 'parche:primitives/Section';

const cfg = blogConfig as any;
const permalinks = cfg.permalinks;

export async function getStaticPaths() {
  const { queryAllTags: qat, queryPostsByTag: qpt } = await import('../../../utils/blog-query.js');
  const { locales, defaultLocale: dl } = await import('parche:config/i18n');
  const allLocales: string[] = (locales as any) ?? [dl];
  const isDev = import.meta.env.DEV;
  const showDrafts = isDev && (blogConfig as any).showDraftsInDev;
  const pageSize = (blogConfig as any).postsPerPage ?? 12;

  // Collect all tags across all locales and compute max pages per tag. The path
  // parameter is the term's resolved slug, which a declared term can override —
  // link generation goes through the same resolver so the two cannot drift.
  const { resolveTerm: rt } = await import('../../../utils/taxonomy.js');
  const tagMaxPages = new Map<string, number>();
  for (const locale of allLocales) {
    const tags = await qat(locale, showDrafts);
    for (const [tag, count] of tags) {
      const pages = Math.max(1, Math.ceil(count / pageSize));
      const { slug } = await rt('tags', tag, locale);
      tagMaxPages.set(slug, Math.max(tagMaxPages.get(slug) ?? 0, pages));
    }
  }

  const paths: { params: { tag: string; page: string | undefined } }[] = [];
  for (const [tag, maxPages] of tagMaxPages) {
    for (let i = 1; i <= maxPages; i++) {
      paths.push({ params: { tag, page: i === 1 ? undefined : String(i) } });
    }
  }
  return paths;
}

// --- Render-time ---
const locale = Astro.currentLocale ?? defaultLocale;
const { tag } = Astro.params;
const isDev = import.meta.env.DEV;
const showDrafts = isDev && cfg.showDraftsInDev;
const pageNum = parseInt(Astro.params.page ?? '') || 1;

// The parameter is a slug; the queries match on the value as written in
// frontmatter, so resolve it back. A slug with no term in this locale means the
// page was generated for another language and must 404, not render empty.
const tax = await createTaxonomyResolver(locale);
const knownTags = [...(await queryAllTags(locale, showDrafts)).keys()];
const term = await resolveSlug('tags', tag!, locale, knownTags);
if (!term) {
  return Astro.redirect('/404');
}

const tagBaseUrl = resolveTaxonomyPermalink(permalinks.tag, term.slug, locale, defaultLocale);

const page = await queryPostsByTag({
  tag: term.key,
  locale,
  page: pageNum,
  pageSize: cfg.postsPerPage ?? 12,
  showDrafts,
  baseUrl: tagBaseUrl,
});


// The entrypoint is shared by /tag and /<locale>/tag, and Astro caches
// getStaticPaths per component — so the generated path set is the union across
// locales. Anything absent in *this* locale is sent to 404 here instead of being
// rendered as an empty, indexable page.
if (page.data.length === 0 || pageNum > page.lastPage) {
  return Astro.redirect('/404');
}

const site = localizeSiteConfig(config, locale);
const labels = resolveLabels(cfg.labels, locale, defaultLocale);
// A tag only exists in a locale if some post there carries it.
const alternates = toAbsolute(
  await getRouteAlternates({
    pathFor: async (l) =>
      resolveTaxonomyPermalink(permalinks.tag, (await resolveTerm('tags', term.key, l)).slug),
    locales: locales as string[],
    defaultLocale,
    hasContent: async (l) =>
      (await queryPostsByTag({ tag: term.key, locale: l, page: 1, pageSize: 1, showDrafts })).total > 0,
  }),
  Astro.site,
);
Astro.locals.parche = { ...(Astro.locals.parche ?? {}), locale, alternates };

const layoutSections = await resolveLayout('default', locale, defaultLocale);

const posts = await resolveAssets(page.data.map((post: any) => {
  const rt = cfg.readingTime
    ? calculateReadingTime(post.body ?? '', cfg.wordsPerMinute)
    : null;
  return {
    title: post.data.title,
    description: post.data.description ?? post.data.excerpt,
    href: resolvePostPermalink(permalinks.post, post, locale, defaultLocale),
    image: post.data.image,
    publishDate: post.data.publishDate,
    category: post.data.category,
    tags: post.data.tags,
    readingTime: post.data.readingTime ?? rt?.minutes,
    categoryHref: post.data.category
      ? resolveTaxonomyPermalink(permalinks.category, tax.slugFor('categories', post.data.category), locale, defaultLocale)
      : undefined,
    tagHrefs: post.data.tags?.map((t: string) =>
      resolveTaxonomyPermalink(permalinks.tag, tax.slugFor('tags', t), locale, defaultLocale)),
  };
}));

const displayTag = term.title;

const metadata = {
  title: `${format(labels.tagTitle, { value: displayTag })} — ${site.site.name}`,
  description: term.description ?? format(labels.tagDescription, { value: displayTag }),
  noindex: false,
  nofollow: false,
  ogType: 'website' as const,
  twitterCard: 'summary_large_image' as const,
};

const breadcrumbs = [
  { label: labels.home, href: localizePath('/', locale, defaultLocale) },
  { label: labels.blog, href: localizePath(permalinks.listing, locale, defaultLocale) },
  { label: format(labels.tagTitle, { value: displayTag }) },
];
---

<BaseLayout metadata={metadata} config={site} lang={locale}>
  {alternates.length > 1 && (
    <Fragment slot="head">
      {alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.locale} href={alt.href} />
      ))}
      <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.locale === defaultLocale)?.href} />
    </Fragment>
  )}
  <LayoutRenderer layoutSections={layoutSections}>
    <Section class="!py-4">
      <Container class="max-w-6xl">
        <Breadcrumbs items={breadcrumbs} />
      </Container>
    </Section>

    <BlogList
      title={format(labels.tagTitle, { value: displayTag })}
      posts={posts}
      currentPage={page.currentPage}
      totalPages={page.lastPage}
      baseUrl={tagBaseUrl}
      emptyText={labels.emptyState}
      readingTimeText={labels.readingTime}
      prevText={labels.newerPosts}
      nextText={labels.olderPosts}
    />
  </LayoutRenderer>
  {showPanel && <ThemePanel />}
</BaseLayout>
