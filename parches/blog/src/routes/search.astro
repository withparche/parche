---
/**
 * The search page: the `search` view over the Pagefind index the blog builds
 * with the site. Result pages are noindex: a search box is not content.
 */
import BlogPage from '../components/BlogPage.astro';
import { baseContext } from '../utils/context.js';
import config from 'parche:config';
import blogConfig from 'parche:app/blog';
import { defaultLocale, locales } from 'parche:config/i18n';
import { localizeSiteConfig } from 'parche:utils/site';
import { getRouteAlternates, toAbsolute } from '../utils/alternates.js';
import { localizePath } from '../types.js';
import { resolveLabels } from '../labels.js';

const cfg = blogConfig as any;
const locale = Astro.currentLocale ?? defaultLocale;
const showDrafts = import.meta.env.DEV && cfg.showDraftsInDev;
const opts = { cfg, locale, defaultLocale, showDrafts };
const site = localizeSiteConfig(config, locale);
const labels = resolveLabels(cfg.labels, locale, defaultLocale);
const alternates = toAbsolute(await getRouteAlternates({ path: cfg.search.path, locales: locales as string[], defaultLocale }), Astro.site);
const context = {
  ...(await baseContext('search', opts)),
  posts: [],
  ...(cfg.archive ? { archiveHref: localizePath(cfg.permalinks.archive, locale, defaultLocale) } : {}),
};

const metadata = {
  pageType: 'SearchResultsPage',
  title: `${labels.searchTitle} — ${site.brand.name}`,
  description: site.brand.description,
  noindex: true,
  nofollow: false,
  ogType: 'website' as const,
  twitterCard: 'summary' as const,
};
---

<BlogPage view="search" {context} {metadata} {site} {locale} {defaultLocale} {alternates} />
