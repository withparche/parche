---
/**
 * A blog post at a prefixed permalink (`/blog/%slug%`, the default).
 * Works in both static (output: 'static') and SSR (output: 'server') modes.
 *
 * getStaticPaths enumerates all valid slugs across all locales. At render
 * time the post is resolved by the same function core calls for root-level
 * permalinks (resolver.ts): one assembly of the post's page — its authors,
 * metadata, structured data, assets and translations — for both paths.
 */
import Page from 'parche:Page';
import { loadTemplate } from 'parche:registry/templates';
import config from 'parche:config';
import blogConfig from 'parche:app/blog';
import { getEntry, render } from 'astro:content';
import { defaultLocale } from 'parche:config/i18n';
import { localizeSiteConfig } from 'parche:utils/site';
import { resolve } from '../../resolver.js';

export async function getStaticPaths() {
  const { extractPostLocale: epl } = await import('../../utils/post-helpers.js');
  const { postIndex } = await import('../../utils/posts.js');
  const isDev = import.meta.env.DEV;
  const showDrafts = isDev && (blogConfig as any).showDraftsInDev;
  const published = (await postIndex(showDrafts)).all;

  // Enumerate all valid slugs. Multiple locales may share the same slug.
  // We deduplicate so each slug appears once in params.
  const seen = new Set<string>();
  const paths: { params: { slug: string } }[] = [];
  for (const post of published) {
    const { postKey } = epl(post.id);
    const slug = post.data.urlSlug ?? postKey;
    if (!seen.has(slug)) {
      seen.add(slug);
      paths.push({ params: { slug } });
    }
  }
  return paths;
}

// --- Render-time (both static & SSR) ---
const locale = Astro.currentLocale ?? defaultLocale;
const site = localizeSiteConfig(config, locale);
const showDrafts = import.meta.env.DEV && (blogConfig as any).showDraftsInDev;

const resolved = await resolve(Astro.params.slug!, locale, {
  showDrafts,
  siteUrl: config.site || Astro.site?.href || '',
  siteName: site.brand.name,
});
if (!resolved) {
  return Astro.redirect('/404');
}

const alternates = resolved.alternates.map((alt) => ({ locale: alt.locale, href: Astro.site ? new URL(alt.path, Astro.site).href : alt.path }));
Astro.locals.parche = { ...(Astro.locals.parche ?? {}), locale, alternates };

const entry = await getEntry('posts', resolved.entryId);
const { Content } = await render(entry!);
const TemplateComponent = await loadTemplate(resolved.template);
---

<Page metadata={resolved.metadata} site={site} locale={locale} alternates={alternates} layout={resolved.layout}>
  {TemplateComponent ? (
    <TemplateComponent {...resolved.templateProps}>
      <Content />
    </TemplateComponent>
  ) : (
    <article class="prose max-w-4xl mx-auto py-16 px-4">
      <Content />
    </article>
  )}
</Page>
