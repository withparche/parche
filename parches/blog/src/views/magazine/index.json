{
  "sections": [
    {
      "widget": "Section",
      "slots": {
        "default": [
          {
            "widget": "blog/Featured",
            "props": {
              "layout": "lead"
            }
          },
          {
            "widget": "AdSlot",
            "props": {
              "slot": "indexLeaderboard",
              "size": "leaderboard"
            }
          }
        ]
      }
    },
    {
      "widget": "Section",
      "slots": {
        "default": [
          {
            "widget": "blog/TaxonomyNav",
            "props": {
              "kind": "categories",
              "label": {
                "$label": "sectionsLabel"
              }
            }
          }
        ]
      }
    },
    {
      "widget": "Columns",
      "props": {
        "ratio": "wide-start",
        "gap": "lg",
        "align": "start"
      },
      "slots": {
        "default": [
          {
            "widget": "Column",
            "slots": {
              "default": [
                {
                  "widget": "blog/PostList",
                  "props": {
                    "layout": "rows",
                    "density": "compact"
                  },
                  "slots": {
                    "inFeed": [
                      {
                        "widget": "AdSlot",
                        "props": {
                          "slot": "inFeed",
                          "size": "rectangle"
                        }
                      }
                    ]
                  }
                },
                {
                  "widget": "blog/Pagination",
                  "props": {
                    "more": true
                  }
                }
              ]
            }
          },
          {
            "widget": "Column",
            "slots": {
              "default": [
                {
                  "widget": "blog/Picks",
                  "props": {
                    "title": {
                      "$label": "editorsPicks"
                    },
                    "from": "featured"
                  }
                },
                {
                  "widget": "AdSlot",
                  "props": {
                    "slot": "indexSidebar",
                    "size": "half-page"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
