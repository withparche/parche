{
  "sections": [
    {
      "widget": "Section",
      "slots": {
        "default": [
          {
            "widget": "blog/ArticleHeader"
          },
          {
            "widget": "blog/ArticleBody",
            "slots": {
              "before": [
                {
                  "widget": "blog/SeriesBox"
                }
              ],
              "after": [
                {
                  "widget": "blog/SeriesBox",
                  "props": {
                    "variant": "next"
                  }
                },
                {
                  "widget": "blog/AuthorBox"
                },
                {
                  "widget": "blog/Comments"
                }
              ],
              "aside": [
                {
                  "widget": "AdSlot",
                  "props": {
                    "slot": "articleSidebar",
                    "size": "half-page"
                  }
                }
              ],
              "inArticle": [
                {
                  "widget": "AdSlot",
                  "props": {
                    "slot": "inArticle",
                    "size": "large-rectangle"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "widget": "Section",
      "slots": {
        "default": [
          {
            "widget": "blog/ReadNext"
          }
        ]
      }
    },
    {
      "widget": "Section",
      "slots": {
        "default": [
          {
            "widget": "AdSlot",
            "props": {
              "slot": "articleEnd",
              "size": "leaderboard"
            }
          }
        ]
      }
    }
  ]
}
