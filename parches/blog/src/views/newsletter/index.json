{
  "sections": [
    {
      "widget": "Section",
      "props": {
        "width": "sm"
      },
      "slots": {
        "default": [
          {
            "widget": "blog/PageHeader",
            "props": {
              "align": "center"
            }
          },
          {
            "widget": "blog/Subscribe",
            "props": {
              "layout": "field"
            }
          },
          {
            "widget": "blog/Featured",
            "props": {
              "layout": "one",
              "label": {
                "$label": "latestIssueLabel"
              }
            }
          },
          {
            "widget": "blog/PostList",
            "props": {
              "layout": "list",
              "dateSide": "end"
            }
          },
          {
            "widget": "blog/Pagination"
          }
        ]
      }
    },
    {
      "widget": "Section",
      "props": {
        "width": "sm"
      },
      "slots": {
        "default": [
          {
            "widget": "blog/Subscribe",
            "props": {
              "layout": "stack"
            }
          }
        ]
      }
    }
  ]
}
