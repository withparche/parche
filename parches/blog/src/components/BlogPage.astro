---
/**
 * A blog page: the site's layout around the view for this page type, with the
 * route's data in the blog context for the view's widgets (see ui's
 * lib/blog-context.ts). The view is rendered like a page's body: the layout's
 * outlet wraps its items, and the tree is validated like any other.
 */
import Page from 'parche:Page';
import { resolveView } from '../utils/views.js';

interface Props {
  view: string;
  context: { preset: string; labels: Record<string, string> } & Record<string, unknown>;
  metadata: any;
  site: any;
  locale: string;
  defaultLocale: string;
  alternates: { locale: string; href: string }[];
  layout?: string;
}

const { view, context, metadata, site, locale, defaultLocale, alternates, layout = 'default' } = Astro.props;
const tree = await resolveView(view, { locale, preset: context.preset, labels: context.labels });

// A post the view already features on the first page is not listed again
// under it: the view says how many it features (one, or a lead and three).
const featuring = (nodes: any[]): number => {
  for (const n of nodes ?? []) {
    if (n?.widget === 'blog/Featured' && !n.props?.posts) return n.props?.layout === 'lead' ? 4 : 1;
    for (const kids of Object.values(n?.slots ?? {})) {
      const found = featuring(kids as any[]);
      if (found) return found;
    }
  }
  return 0;
};
const page = (context as any).page;
const shown = (!page || page.current === 1) ? ((context as any).featured ?? []).slice(0, featuring(tree.sections)).map((c: any) => c.href) : [];
Astro.locals.parche = { ...(Astro.locals.parche ?? {}), locale, alternates, blog: { ...context, shown, brand: site?.brand?.name } };
---

<Page
  metadata={metadata}
  site={site}
  locale={locale}
  alternates={alternates}
  layout={layout}
  pageSlots={{ default: tree.sections }}
  pageWrappers={tree.wrapper !== undefined ? { default: tree.wrapper } : undefined}
/>
