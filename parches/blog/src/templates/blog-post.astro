---
/**
 * The blog post template: renders the post's view.
 *
 * The body is rendered once here (the Markdown the route passes as the default
 * slot), its outline read from it, and the article context built: the post,
 * its authors, its series, the related posts. The view for posts (the
 * preset's, or the site's `blog-post`) then lays it out: header, body with
 * its sidebar, series and author boxes, read next. Both post paths (a
 * prefixed permalink and the root-level resolver) come through here.
 *
 * A post's own `sections` (frontmatter) still render above it.
 */
import NodeRenderer from 'parche:NodeRenderer';
import blogConfig from 'parche:app/blog';
import { defaultLocale } from 'parche:config/i18n';
import { articleContext } from '../utils/context.js';
import { resolveView } from '../utils/views.js';

interface Props {
  data: { sections?: { widget: string; props?: Record<string, unknown> }[]; [key: string]: unknown };
  /** The post's content entry: its id, body and series. */
  entry?: any;
  [key: string]: unknown;
}

const { data, entry } = Astro.props;
const cfg = blogConfig as any;
const locale = Astro.currentLocale ?? defaultLocale;
const showDrafts = import.meta.env.DEV && cfg.showDraftsInDev;
const html = Astro.slots.has('default') ? await Astro.slots.render('default') : '';
const opts = { cfg, locale, defaultLocale, showDrafts };
const context = entry ? await articleContext(entry, html, Astro.url.href, opts) : undefined;
if (context) Astro.locals.parche = { ...(Astro.locals.parche ?? {}), blog: context };
const view = context ? await resolveView('post', { locale, preset: context.preset, labels: context.labels }) : undefined;
---

{data.sections && data.sections.length > 0 && <NodeRenderer nodes={data.sections} wrapper={{}} />}
{view ? <NodeRenderer nodes={view.sections} wrapper={view.wrapper ?? {}} base="post" /> : <article class="prose mx-auto max-w-3xl px-6 py-16" set:html={html} />}
