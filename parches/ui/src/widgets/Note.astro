---
import Icon from 'parche:elements/Icon';
import Container from 'parche:elements/Container';
import type { Props } from './Note.props';

const { icon = 'tabler:info-square', title, description } = Astro.props;
---

<div class="bg-surface-hover border-y border-border px-4 sm:px-6 py-4 text-center not-prose">
  <Container width="xl" padding={false}>
    <p>
      <Icon name={icon} size="md" class="inline-block -mt-0.5 text-muted" />
      {' '}
      {title && <span class="font-bold text-heading">{title}</span>}
      {' '}
      {description && <span class="text-muted" set:html={description} />}
    </p>
  </Container>
</div>
