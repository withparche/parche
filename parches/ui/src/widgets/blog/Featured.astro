---
/**
 * The post a blog leads with: the one marked `featured: true` in its
 * frontmatter, or the newest when none is. `lead` sets a lead story with the
 * next three beside it, as a magazine front does; `trio` a large post and two
 * smaller ones beside it, each with its picture at a social card's shape
 * (1.91:1), as company blogs do.
 */
import Avatar from 'parche:elements/Avatar';
import Image from 'parche:elements/Image';
import Placeholder from 'parche:elements/Placeholder';
import { blogContext, type BlogCard } from '../../lib/blog-context';
import { schema, type Props } from './Featured.props';

const p = schema.parse(Astro.props) as Props;
const ctx = blogContext(Astro.locals);
const posts: BlogCard[] = (p.posts as BlogCard[] | undefined) ?? ctx?.featured ?? [];
const [first, ...rest] = posts;
const label = p.label ?? ctx?.labels?.featuredLabel ?? 'Featured';
const bylines = ctx?.authors !== 'one';
const title = (c: BlogCard) => (c.issue ? `#${c.issue} · ${c.title}` : c.title);
const eyebrow = 'font-mono text-[10px] leading-none font-medium tracking-[0.16em] text-primary uppercase';
---

{first && (p.layout === 'lead' ? (
  <div class="parche-featured grid gap-[clamp(24px,3.5vw,48px)] lg:grid-cols-[minmax(0,1.9fr)_minmax(0,1fr)]" data-layout="lead">
    <article class="min-w-0">
      <a href={first.href} tabindex="-1" aria-hidden="true" class="mb-5 block">
        {first.image ? <Image src={first.image.src} alt="" width={1200} ratio="16/9" sizes="(min-width: 1024px) 66vw, 100vw" priority class="rounded-lg" /> : <Placeholder ratio="16/9" caption="lead photograph · 1600×900" />}
      </a>
      {first.category && <a href={first.category.href} class:list={[eyebrow, 'no-underline hover:underline']}>{first.category.name}</a>}
      <h2 class="mt-3 font-heading text-[clamp(30px,4vw,46px)] leading-[1.06] font-semibold tracking-[-0.03em] text-balance text-heading"><a href={first.href} class="text-inherit no-underline hover:underline">{title(first)}</a></h2>
      {first.excerpt && <p class="mt-4 max-w-[56ch] text-[clamp(17px,1.7vw,20px)] leading-[1.55] text-pretty text-muted">{first.excerpt}</p>}
      <p class="mt-4 flex flex-wrap gap-x-2 text-xs text-muted">
        {bylines && first.authors[0] && <span class="font-semibold text-heading">{first.authors[0].name}</span>}
        <time datetime={first.date}>{first.dateText}</time>
        {first.readingTime && <span>· {first.readingTime}</span>}
      </p>
    </article>
    <ul class="list-none p-0">
      {rest.slice(0, 3).map((c) => (
        <li class="border-b border-border py-4 first:pt-0">
          {c.category && <a href={c.category.href} class:list={[eyebrow, 'no-underline hover:underline']}>{c.category.name}</a>}
          <h3 class="mt-2 font-heading text-[19px] leading-[1.3] font-semibold text-balance text-heading"><a href={c.href} class="text-inherit no-underline hover:underline">{title(c)}</a></h3>
          {c.excerpt && <p class="mt-1.5 text-sm leading-[1.55] text-muted">{c.excerpt}</p>}
          <p class="mt-2 flex flex-wrap gap-x-2 text-xs text-muted">
            {bylines && c.authors[0] && <span class="font-semibold text-heading">{c.authors[0].name}</span>}
            {c.readingTime && <span>{c.readingTime}</span>}
          </p>
        </li>
      ))}
    </ul>
  </div>
) : p.layout === 'trio' ? (
  <div class="parche-featured grid gap-[clamp(24px,3vw,32px)] lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]" data-layout="trio">
    <article class="min-w-0">
      <a href={first.href} tabindex="-1" aria-hidden="true" class="mb-5 block">
        {first.image ? <Image src={first.image.src} alt="" width={1200} ratio="1.91/1" sizes="(min-width: 1024px) 66vw, 100vw" priority class="rounded-lg" /> : <Placeholder ratio="1.91/1" caption="featured · 1200×630" />}
      </a>
      <p class={eyebrow}>{label}{first.category && <> · <a href={first.category.href} class="text-inherit no-underline hover:underline">{first.category.name}</a></>}</p>
      <h2 class="mt-3 font-heading text-[clamp(26px,3vw,36px)] leading-[1.12] font-semibold tracking-[-0.025em] text-balance text-heading"><a href={first.href} class="text-inherit no-underline hover:underline">{title(first)}</a></h2>
      {first.excerpt && <p class="mt-3 max-w-[60ch] text-[17px] leading-[1.6] text-pretty text-muted">{first.excerpt}</p>}
      <p class="mt-4 flex flex-wrap items-center gap-x-2 text-xs text-muted">
        {bylines && first.authors[0] && <span class="flex items-center gap-2 font-semibold text-heading"><Avatar size="xs" name={first.authors[0].name} src={first.authors[0].avatar?.src} />{first.authors[0].name}</span>}
        <time datetime={first.date}>{first.dateText}</time>
        {first.readingTime && <span>· {first.readingTime}</span>}
      </p>
    </article>
    <div class="grid content-start gap-[clamp(24px,3vw,32px)] sm:grid-cols-2 lg:grid-cols-1">
      {rest.slice(0, 2).map((c) => (
        <article class="min-w-0">
          <a href={c.href} tabindex="-1" aria-hidden="true" class="mb-3 block">
            {c.image ? <Image src={c.image.src} alt="" width={640} ratio="1.91/1" sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="rounded-lg" /> : <Placeholder ratio="1.91/1" />}
          </a>
          {c.category && <a href={c.category.href} class:list={[eyebrow, 'no-underline hover:underline']}>{c.category.name}</a>}
          <h3 class="mt-2 font-heading text-[clamp(17px,1.5vw,20px)] leading-[1.3] font-semibold tracking-[-0.01em] text-balance text-heading"><a href={c.href} class="text-inherit no-underline hover:underline">{title(c)}</a></h3>
          <p class="mt-2 flex flex-wrap gap-x-2 text-xs text-muted">
            {bylines && c.authors[0] && <span class="font-semibold text-heading">{c.authors[0].name}</span>}
            <time datetime={c.date}>{c.dateText}</time>
            {c.readingTime && <span>· {c.readingTime}</span>}
          </p>
        </article>
      ))}
    </div>
  </div>
) : (
  <article class="parche-featured grid overflow-hidden rounded-xl border border-border bg-surface md:grid-cols-2" data-layout="one">
    <a href={first.href} tabindex="-1" aria-hidden="true" class="block">
      {first.image ? <Image src={first.image.src} alt="" width={960} ratio="16/10" sizes="(min-width: 768px) 50vw, 100vw" priority class="h-full w-full min-h-[240px]" /> : <Placeholder ratio="16/10" caption="featured · 1200×750" class="h-full rounded-none" />}
    </a>
    <div class="flex flex-col justify-center p-[clamp(22px,3vw,40px)]">
      <p class={eyebrow}>{label}{first.category && <> · <a href={first.category.href} class="text-inherit no-underline hover:underline">{first.category.name}</a></>}</p>
      <h2 class="mt-4 font-heading text-[clamp(26px,3vw,36px)] leading-[1.1] font-semibold tracking-[-0.025em] text-balance text-heading"><a href={first.href} class="text-inherit no-underline hover:underline">{title(first)}</a></h2>
      {first.excerpt && <p class="mt-4 text-base leading-[1.6] text-pretty text-muted">{first.excerpt}</p>}
      <p class="mt-5 flex flex-wrap items-center gap-x-2 text-xs text-muted">
        {bylines && first.authors[0] && <span class="flex items-center gap-2 font-semibold text-heading"><Avatar size="xs" name={first.authors[0].name} src={first.authors[0].avatar?.src} />{first.authors[0].name}</span>}
        <time datetime={first.date}>{first.dateText}</time>
        {first.readingTime && <span>· {first.readingTime}</span>}
      </p>
    </div>
  </article>
))}
