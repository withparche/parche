---
/** Table of contents sidebar: the Toc element, which tracks the visible heading. */
import Toc from 'parche:elements/Toc';

interface TOCItem {
  depth: number;
  text: string;
  slug: string;
  children: TOCItem[];
}

interface Props {
  items: TOCItem[];
  title?: string;
  class?: string;
}

const { items, title = 'Table of Contents', class: className } = Astro.props;
---

{items.length > 0 && <Toc items={items} title={title} class={className} />}
