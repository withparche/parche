---
/**
 * A series page's parts, numbered, each with its date. Published parts link
 * to the post; announced ones are muted, with their month marked, which is
 * what tells a reader the series is alive.
 */
import { blogContext } from '../../lib/blog-context';

const ctx = blogContext(Astro.locals);
const parts = ctx?.series?.parts ?? [];
---

{parts.length > 0 && (
  <ol class="parche-series-parts list-none border-b border-border p-0">
    {parts.map((part) => (
      <li class="grid grid-cols-[48px_minmax(0,1fr)_auto] items-baseline gap-4 border-t border-border py-4">
        <span class="font-heading text-2xl font-semibold text-primary">{part.n}</span>
        {part.href ? (
          <a href={part.href} class="font-heading text-[clamp(17px,1.6vw,19px)] font-semibold text-heading no-underline hover:underline">{part.title}</a>
        ) : (
          <span class="font-heading text-[clamp(17px,1.6vw,19px)] font-semibold text-muted">{part.title}</span>
        )}
        {part.dateText && (part.upcoming
          ? <span class="rounded-sm bg-warning-soft px-2 py-1 font-mono text-xs text-warning">{part.dateText}</span>
          : <span class="font-mono text-xs text-muted">{part.dateText}</span>)}
      </li>
    ))}
  </ol>
)}
