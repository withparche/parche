---
/**
 * The posts of a blog page. In a blog view it reads the page's posts from the
 * route (see lib/blog-context.ts); given `posts`, it shows those. The layout
 * decides what a post shows unless a toggle says otherwise, and bylines never
 * appear on a blog with one writer.
 */
import Avatar from 'parche:elements/Avatar';
import Image from 'parche:elements/Image';
import Placeholder from 'parche:elements/Placeholder';
import { blogContext, type BlogCard } from '../../lib/blog-context';
import { schema, type Props } from './PostList.props';

const p = schema.parse(Astro.props) as Props;
const ctx = blogContext(Astro.locals);
const posts: BlogCard[] = (p.posts as BlogCard[] | undefined) ?? (ctx?.posts ?? []).filter((c) => !ctx?.shown?.includes(c.href));
const { layout, density, columns } = p;

const defaults = {
  list: { date: true, excerpt: true, image: false, author: false, readingTime: true, category: false, tags: true },
  cards: { date: true, excerpt: true, image: true, author: true, readingTime: true, category: true, tags: false },
  rows: { date: true, excerpt: true, image: true, author: true, readingTime: true, category: true, tags: false },
  compact: { date: true, excerpt: false, image: false, author: false, readingTime: false, category: false, tags: false },
}[layout];
const show = Object.fromEntries(Object.entries(defaults).map(([k, v]) => [k, (p as any)[k] ?? v])) as typeof defaults;
if (ctx?.authors === 'one') show.author = false;
// On a category's own page every post is in it: the eyebrow would only repeat the title.
if (!p.posts && ctx?.term?.kind === 'categories') show.category = false;

const empty = p.empty ?? ctx?.labels?.emptyState ?? 'No posts yet.';
// Density is variables only: the markup is the same.
const vars = density === 'compact' ? '--row-y:13px;--card-pad:15px;--gap:14px;--list-title:17px' : '--row-y:22px;--card-pad:22px;--gap:22px;--list-title:21px';
// The in-feed slot, rendered once, goes after `inFeedAfter` posts: never first,
// and only in a list long enough to have something after it.
const inFeed = Astro.slots.has('inFeed') && posts.length > p.inFeedAfter ? await Astro.slots.render('inFeed') : '';
const feedAt = (i: number) => inFeed && i === p.inFeedAfter - 1;
const title = (c: BlogCard) => (c.issue ? `#${c.issue} · ${c.title}` : c.title);
const seriesLabel = ctx?.labels?.seriesChip ?? 'Series';
// The first picture is the page's main one only when nothing is featured
// above the list on the first page; the rest wait until they are near.
const lead = (i: number) => i === 0 && !ctx?.shown?.length && (ctx?.page?.current ?? 1) === 1 && !p.posts;
const cardSizes = columns === '2' ? '(min-width: 640px) 50vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw';
---

<div class="parche-post-list" data-layout={layout} data-density={density} style={vars}>
  {p.title && <h2 class="mb-4 font-heading text-[clamp(22px,2.4vw,28px)] font-semibold tracking-[-0.02em] text-heading">{p.title}</h2>}
  {posts.length === 0 ? (
    <p class="py-10 text-muted">{empty}</p>
  ) : layout === 'cards' ? (
    <ul data-load-more-list class:list={['grid list-none gap-(--gap) p-0', columns === '2' ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3']}>
      {posts.map((c, i) => (<>
        <li class="flex min-w-0 flex-col overflow-hidden rounded-lg border border-border bg-surface">
          {show.image && (
            <a href={c.href} tabindex="-1" aria-hidden="true" class="block">
              {c.image ? <Image src={c.image.src} alt="" width={640} ratio="16/10" sizes={cardSizes} priority={lead(i)} /> : <Placeholder ratio="16/10" class="rounded-none" />}
            </a>
          )}
          <div class="flex flex-1 flex-col p-(--card-pad)">
            {show.category && c.category && <a href={c.category.href} class="mb-2.5 w-fit font-mono text-[10px] leading-none font-medium tracking-[0.16em] text-primary uppercase no-underline hover:underline">{c.category.name}</a>}
            <h3 class="mb-2 font-heading text-[clamp(16px,1.4vw,18px)] leading-[1.3] font-semibold tracking-[-0.01em] text-balance text-heading"><a href={c.href} class="text-inherit no-underline hover:underline">{title(c)}</a></h3>
            {show.excerpt && c.excerpt && <p class="mb-4 text-sm leading-[1.55] text-pretty text-muted">{c.excerpt}</p>}
            <p class="mt-auto flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted">
              {show.author && c.authors[0] && (
                <span class="flex items-center gap-2 font-medium text-heading">
                  <Avatar size="xs" name={c.authors[0].name} src={c.authors[0].avatar?.src} />
                  {c.authors[0].href ? <a href={c.authors[0].href} class="text-inherit no-underline hover:underline">{c.authors[0].name}</a> : c.authors[0].name}
                </span>
              )}
              {show.date && <time datetime={c.date}>{c.dateText}</time>}
              {show.readingTime && c.readingTime && <span>· {c.readingTime}</span>}
            </p>
          </div>
        </li>
        {feedAt(i) && <li class="sm:col-span-full" data-placement="inFeed" set:html={inFeed} />}
      </>))}
    </ul>
  ) : (
    <ul data-load-more-list class="list-none border-b border-border p-0">
      {posts.map((c, i) => (<>
        <li
          class:list={[
            'grid gap-x-8 gap-y-1 border-t border-border py-(--row-y)',
            layout === 'list' && show.date && 'sm:grid-cols-[140px_minmax(0,1fr)]',
            layout === 'rows' && show.image && (p.thumbnail === 'wide' ? 'grid-cols-[minmax(0,1fr)_112px] sm:grid-cols-[minmax(0,1fr)_200px]' : 'grid-cols-[minmax(0,1fr)_96px] sm:grid-cols-[minmax(0,1fr)_120px]'),
            layout === 'compact' && 'grid-cols-[minmax(0,1fr)_auto] items-baseline',
          ]}
        >
          {layout === 'list' && show.date && <time datetime={c.date} class="pt-1 font-mono text-xs text-muted">{c.dateText}</time>}
          <div class="min-w-0 max-w-[68ch]">
            {layout === 'rows' && show.category && c.category && <a href={c.category.href} class="mb-1.5 inline-block font-mono text-[10px] leading-none font-medium tracking-[0.16em] text-primary uppercase no-underline hover:underline">{c.category.name}</a>}
            <h3 class:list={['font-heading leading-[1.3] font-semibold tracking-[-0.01em] text-balance text-heading', layout === 'compact' ? 'text-base' : 'text-(length:--list-title)']}>
              <a href={c.href} class="text-inherit no-underline hover:underline">{title(c)}</a>
            </h3>
            {show.excerpt && c.excerpt && <p class="mt-1.5 text-[15px] leading-[1.6] text-pretty text-muted">{c.excerpt}</p>}
            {layout !== 'compact' && (
              <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted">
                {show.author && c.authors[0] && (c.authors[0].href ? <a href={c.authors[0].href} class="font-semibold text-heading no-underline hover:underline">{c.authors[0].name}</a> : <span class="font-semibold text-heading">{c.authors[0].name}</span>)}
                {layout === 'rows' && show.date && <time datetime={c.date}>{c.dateText}</time>}
                {show.readingTime && c.readingTime && <span>{layout === 'rows' ? '· ' : ''}{c.readingTime}</span>}
                {c.series && <span class="rounded-full border border-primary/40 px-2 py-0.5 text-primary">{seriesLabel}</span>}
                {show.tags && c.tags.map((t) => <a href={t.href} class="font-mono text-muted no-underline hover:text-primary">#{t.name}</a>)}
              </p>
            )}
          </div>
          {layout === 'rows' && show.image && (
            <a href={c.href} tabindex="-1" aria-hidden="true" class="col-start-2 row-span-full row-start-1 block self-start">
              {p.thumbnail === 'wide'
                ? (c.image ? <Image src={c.image.src} alt="" width={400} ratio="3/2" sizes="(min-width: 640px) 200px, 112px" class="rounded-md" /> : <Placeholder ratio="3/2" />)
                : (c.image ? <Image src={c.image.src} alt="" width={120} ratio="1/1" layout="fixed" class="rounded-md" /> : <Placeholder ratio="1/1" />)}
            </a>
          )}
          {layout === 'compact' && show.date && <time datetime={c.date} class="font-mono text-xs whitespace-nowrap text-muted">{c.dateText}</time>}
        </li>
        {feedAt(i) && <li class="border-t border-border py-(--row-y)" data-placement="inFeed" set:html={inFeed} />}
      </>))}
    </ul>
  )}
</div>
