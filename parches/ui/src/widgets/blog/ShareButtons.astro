---
/** Social share buttons: the Share element (links that work with no script, copy link, native share). */
import Share from 'parche:elements/Share';

interface Props {
  /** Leading label, e.g. 'Share:'. */
  shareText?: string;
  url: string;
  title: string;
  description?: string;
  class?: string;
}

const { shareText = 'Share:', url, title, class: className } = Astro.props;
---

<Share url={url} title={title} label={shareText} class={className} />
