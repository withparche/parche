---
/**
 * Blog post grid card — vertical layout (v1 GridItem style).
 * Image on top, meta line, title and description. Used in grid listings and,
 * through it, by RelatedPosts / BlogLatestPosts / BlogHighlightedPosts.
 */
import Image from 'parche:elements/Image';
import Icon from 'parche:elements/Icon';
import Tag from 'parche:elements/Tag';

interface Props {
  /** Reading-time template, `{minutes}` substituted. Default: English. */
  readingTimeText?: string;
  /** How the date is rendered. Options for Intl.DateTimeFormat — the locale
   *  still decides word order; this decides the style. */
  dateFormat?: Intl.DateTimeFormatOptions;
  title: string;
  description?: string;
  href: string;
  image?: { src: string; alt: string };
  publishDate?: Date;
  category?: string;
  tags?: string[];
  readingTime?: number;
  featured?: boolean;
  draft?: boolean;
  categoryHref?: string;
  tagHrefs?: string[];
  class?: string;
}

const {
  readingTimeText = '{minutes} min read',
  dateFormat = { year: 'numeric', month: 'short', day: 'numeric' },
  title,
  description,
  href,
  image,
  publishDate,
  category,
  tags = [],
  readingTime,
  categoryHref,
  tagHrefs = [],
  class: className = '',
} = Astro.props;

// Format in the page's locale — a Spanish page must not read "Aug 23, 2026".
const dateLocale = Astro.currentLocale ?? 'en-US';
const formattedDate = publishDate ? publishDate.toLocaleDateString(dateLocale, dateFormat) : undefined;
---

<article class:list={['mb-6', className]}>
  {image && (
    href ? (
      <a href={href} class="block mb-6 rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" tabindex="-1" aria-hidden="true">
        <Image src={image.src} alt="" width={640} ratio="4/3" class="rounded shadow-lg" />
      </a>
    ) : (
      <Image src={image.src} alt={image.alt || title} width={640} ratio="4/3" class="mb-6 rounded shadow-lg" />
    )
  )}

  {(formattedDate || category || readingTime) && (
    <p class="mb-1 text-sm text-muted">
      {formattedDate && (
        <>
          <Icon name="tabler:clock" size="xs" class="inline-block -mt-0.5" />
          {' '}
          <time datetime={publishDate!.toISOString()} class="inline-block">{formattedDate}</time>
        </>
      )}
      {category && (
        <>
          {' · '}
          {categoryHref ? <a class="hover:underline" href={categoryHref}>{category}</a> : <span>{category}</span>}
        </>
      )}
      {readingTime && <>{' · '}<span>{readingTimeText.replace('{minutes}', String(readingTime))}</span></>}
    </p>
  )}

  <h3 class="text-xl sm:text-2xl font-bold leading-tight mb-2 font-heading text-heading">
    {href ? (
      <a class="inline-block hover:text-primary transition-colors" href={href}>{title}</a>
    ) : (
      title
    )}
  </h3>

  {description && <p class="text-muted text-lg">{description}</p>}

  {tags.length > 0 && (
    <footer class="mt-4 flex flex-wrap gap-1.5">
      {tags.map((tag, i) => <Tag href={tagHrefs[i]} class="lowercase">{tag}</Tag>)}
    </footer>
  )}
</article>
