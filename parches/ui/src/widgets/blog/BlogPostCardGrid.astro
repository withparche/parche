---
/**
 * Blog post grid card — vertical layout (v1 GridItem style).
 * Image on top, title + description below. Used in grid blog listings.
 */
interface Props {
  /** Reading-time template, `{minutes}` substituted. Default: English. */
  readingTimeText?: string;
  title: string;
  description?: string;
  href: string;
  image?: { src: string; alt: string };
  publishDate: Date;
  category?: string;
  tags?: string[];
  readingTime?: number;
  featured?: boolean;
  draft?: boolean;
  categoryHref?: string;
  tagHrefs?: string[];
  class?: string;
}

const {
  readingTimeText = '{minutes} min read',
  title,
  description,
  href,
  image,
  publishDate,
  category,
  tags = [],
  readingTime,
  categoryHref,
  tagHrefs = [],
  class: className = '',
} = Astro.props;

// Format in the page's locale — a Spanish page must not read "Aug 23, 2026".
const dateLocale = Astro.currentLocale ?? 'en-US';
const formattedDate = publishDate.toLocaleDateString(dateLocale, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class:list={['mb-6 transition', className]}>
  {image && (
    <div class="relative h-52 md:h-64 bg-gray-400 dark:bg-slate-700 rounded shadow-lg mb-6">
      {href ? (
        <a href={href} class="block h-full">
          <img
            src={image.src}
            alt={image.alt || title}
            class="w-full h-full rounded shadow-lg bg-gray-400 dark:bg-slate-700 object-cover"
            loading="lazy"
            decoding="async"
          />
        </a>
      ) : (
        <img
          src={image.src}
          alt={image.alt || title}
          class="w-full h-full rounded shadow-lg bg-gray-400 dark:bg-slate-700 object-cover"
          loading="lazy"
          decoding="async"
        />
      )}
    </div>
  )}

  <div class="mb-1">
    <span class="text-sm">
      <svg class="w-3.5 h-3.5 inline-block -mt-0.5 dark:text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <time datetime={publishDate.toISOString()} class="inline-block">{formattedDate}</time>
      {category && (
        <>
          {' · '}
          {categoryHref ? (
            <a class="hover:underline" href={categoryHref}>{category}</a>
          ) : (
            <span>{category}</span>
          )}
        </>
      )}
      {readingTime && (
        <>
          {' · '}
          <span>{readingTimeText.replace('{minutes}', String(readingTime))}</span>
        </>
      )}
    </span>
  </div>

  <h3 class="text-xl sm:text-2xl font-bold leading-tight mb-2 font-heading dark:text-slate-300">
    {href ? (
      <a class="inline-block hover:text-primary dark:hover:text-blue-700 transition ease-in duration-200" href={href}>
        {title}
      </a>
    ) : (
      title
    )}
  </h3>

  {description && <p class="text-muted dark:text-slate-400 text-lg">{description}</p>}

  {tags.length > 0 && (
    <footer class="mt-4">
      <ul class="text-sm">
        {tags.map((tag, i) => (
          <li class="bg-gray-100 dark:bg-slate-700 inline-block mr-2 rtl:mr-0 rtl:ml-2 mb-2 py-0.5 px-2 lowercase font-medium">
            {tagHrefs[i] ? (
              <a href={tagHrefs[i]} class="text-muted dark:text-slate-300 hover:text-primary dark:hover:text-gray-200">
                {tag}
              </a>
            ) : (
              <span class="text-muted dark:text-slate-300">{tag}</span>
            )}
          </li>
        ))}
      </ul>
    </footer>
  )}
</article>
