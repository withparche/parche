---
/**
 * Blog pagination — the adapter between the blog routes' props
 * (`currentPage`, `totalPages`, `baseUrl`, `prevText`, `nextText`) and the
 * Pagination element. Keeps the v1 look: previous/next only, no numbers.
 */
import Pagination from 'parche:elements/Pagination';

interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
  prevText?: string;
  nextText?: string;
  class?: string;
}

const {
  currentPage,
  totalPages,
  baseUrl,
  prevText = 'Newer posts',
  nextText = 'Older posts',
  class: className = '',
} = Astro.props;
---

{totalPages > 1 && (
  <Pagination current={currentPage} total={totalPages} base={baseUrl} numbers={false} prevLabel={prevText} nextLabel={nextText} class={className} />
)}
