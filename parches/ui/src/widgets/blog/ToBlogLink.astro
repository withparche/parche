---
/**
 * "Back to Blog" navigation link — v1 style.
 * A ghost button with a chevron, back to the blog listing.
 */
import Container from 'parche:elements/Container';
import Button from 'parche:elements/Button';

interface Props {
  href: string;
  text?: string;
  class?: string;
}

const {
  href,
  text = 'Back to Blog',
  class: className = '',
} = Astro.props;
---

<Container width="sm" class:list={['pt-8 md:pt-4 pb-12 md:pb-20', className]}>
  <Button variant="ghost" size="sm" href={href} icon="tabler:chevron-left" class="rounded-md rtl:flex-row-reverse">{text}</Button>
</Container>
