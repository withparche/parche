---
/**
 * Blog listing — supports list (v1 ListItem) and grid (v1 GridItem) variants.
 * Default is 'list' (vertical stack). 'grid' shows cards in a responsive grid.
 */
import BlogPostCard from 'parche:widgets/blog/BlogPostCard';
import BlogPostCardGrid from 'parche:widgets/blog/BlogPostCardGrid';
import Pagination from 'parche:widgets/blog/Pagination';

interface PostItem {
  title: string;
  description?: string;
  href: string;
  image?: { src: string; alt: string };
  publishDate: Date;
  category?: string;
  tags?: string[];
  readingTime?: number;
  featured?: boolean;
  draft?: boolean;
  categoryHref?: string;
  tagHrefs?: string[];
}

interface Props {
  title?: string;
  subtitle?: string;
  posts: PostItem[];
  /** 'list' = horizontal cards in vertical stack (default), 'grid' = vertical cards in grid */
  variant?: 'list' | 'grid';
  currentPage?: number;
  totalPages?: number;
  baseUrl?: string;
  /** Localizable UI strings. Defaults are English; the blog parche passes the
   *  site's per-locale labels. */
  emptyText?: string;
  readingTimeText?: string;
  dateFormat?: Intl.DateTimeFormatOptions;
  prevText?: string;
  nextText?: string;
  id?: string;
  class?: string;
}

const {
  title,
  subtitle,
  posts,
  variant = 'list',
  currentPage,
  totalPages,
  baseUrl,
  emptyText = 'No posts found.',
  readingTimeText,
  dateFormat,
  prevText,
  nextText,
  id,
  class: className = '',
} = Astro.props;

const isGrid = variant === 'grid';
---

<section {id} class:list={[isGrid ? 'px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl' : 'px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl', className]}>
  {(title || subtitle) && (
    <header class="mb-8 md:mb-16 text-center max-w-3xl mx-auto">
      {title && <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading" set:html={title} />}
      {subtitle && (
        <div class="mt-2 md:mt-3 mx-auto text-xl text-gray-500 dark:text-slate-400 font-medium" set:html={subtitle} />
      )}
    </header>
  )}

  {posts.length > 0 ? (
    isGrid ? (
      <div class="grid gap-6 row-gap-5 md:grid-cols-2 lg:grid-cols-3 -mb-6">
        {posts.map((post) => (
          <BlogPostCardGrid readingTimeText={readingTimeText} dateFormat={dateFormat} {...post} />
        ))}
      </div>
    ) : (
      <ul>
        {posts.map((post) => (
          <li class="mb-12 md:mb-20">
            <BlogPostCard readingTimeText={readingTimeText} dateFormat={dateFormat} {...post} />
          </li>
        ))}
      </ul>
    )
  ) : (
    <p class="text-center text-muted text-lg">{emptyText}</p>
  )}

  {currentPage && totalPages && totalPages > 1 && baseUrl && (
    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      baseUrl={baseUrl}
      prevText={prevText}
      nextText={nextText}
    />
  )}
</section>
