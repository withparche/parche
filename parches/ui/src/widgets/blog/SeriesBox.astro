---
/**
 * A post's place in its series. At the top: "Series · Part 2 of 4", the
 * series (linked to its page) and the part before. At the end: the next part,
 * linked, or announced with its date so readers know the series is alive.
 * Renders nothing for a post outside a series.
 */
import { blogContext } from '../../lib/blog-context';
import { schema, type Props } from './SeriesBox.props';

const p = schema.parse(Astro.props) as Props;
const ctx = blogContext(Astro.locals);
const s = ctx?.article?.series;
const labels = ctx?.labels ?? {};
const fill = (t: string | undefined, v: Record<string, string | number>) => Object.entries(v).reduce((a, [k, x]) => a.replaceAll(`{${k}}`, String(x)), t ?? '');
const eyebrow = 'font-mono text-[10px] leading-none font-medium tracking-[0.16em] text-primary uppercase';
---

{s && p.variant === 'top' && (
  <aside class="parche-series-box rounded-lg border border-border bg-surface px-5 py-4" aria-label={s.title}>
    <p class={eyebrow}>{fill(labels.seriesEyebrow ?? 'Series · Part {part} of {total}', { part: s.part, total: s.total })}</p>
    <p class="mt-2 font-heading text-[17px] font-semibold text-heading">{s.href ? <a href={s.href} class="text-inherit no-underline hover:underline">{s.title}</a> : s.title}</p>
    {s.prev && <p class="mt-1 text-sm text-muted">{labels.previously ?? 'Previously'}: <a href={s.prev.href} class="text-inherit hover:text-primary">{s.prev.title}</a></p>}
  </aside>
)}
{s && p.variant === 'next' && s.next && (
  <aside class="parche-series-box flex flex-wrap items-center justify-between gap-3 rounded-lg border border-border bg-surface px-5 py-4" aria-label={s.title}>
    <div>
      <p class="font-mono text-[10px] leading-none font-medium tracking-[0.16em] text-muted uppercase">{fill(labels.nextInSeries ?? 'Next in {series}', { series: s.title })}</p>
      <p class="mt-2 font-heading text-[17px] font-semibold text-heading">{s.next.href ? <a href={s.next.href} class="text-inherit no-underline hover:underline">{s.next.title}</a> : s.next.title}</p>
    </div>
    {!s.next.href && s.next.dateText && <p class="font-mono text-xs text-muted">{fill(labels.publishes ?? 'Publishes {date}', { date: s.next.dateText })}</p>}
  </aside>
)}
