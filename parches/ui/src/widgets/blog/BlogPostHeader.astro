---
/**
 * Blog post header — v1 SinglePost style.
 * Layout: metadata line → large title → excerpt → featured image.
 */
interface AuthorInfo {
  name: string;
  avatar?: { src: string; alt: string };
  href?: string;
}

interface Props {
  /** Reading-time template, `{minutes}` substituted. Default: English. */
  readingTimeText?: string;
  /** How the date is rendered. Options for Intl.DateTimeFormat — the locale
   *  still decides word order; this decides the style. */
  dateFormat?: Intl.DateTimeFormatOptions;
  title: string;
  description?: string;
  publishDate: Date;
  modifiedDate?: Date;
  category?: string;
  tags?: string[];
  readingTime?: number;
  image?: { src: string; alt: string; caption?: string };
  authors?: AuthorInfo[];
  categoryHref?: string;
  tagHrefs?: string[];
  id?: string;
  class?: string;
}

const {
  readingTimeText = '{minutes} min read',
  dateFormat = { year: 'numeric', month: 'short', day: 'numeric' },
  title,
  description,
  publishDate,
  category,
  readingTime,
  image,
  authors = [],
  categoryHref,
  id,
  class: className = '',
} = Astro.props;

// Format in the page's locale — a Spanish page must not read "Aug 23, 2026".
const dateLocale = Astro.currentLocale ?? 'en-US';
const formattedDate = publishDate.toLocaleDateString(dateLocale, dateFormat);
---

<header {id} class:list={[className]}>
  {/* Metadata line: date · author · category · reading time */}
  <div class="flex justify-between flex-col sm:flex-row max-w-3xl mx-auto mt-0 mb-2 px-4 sm:px-6 sm:items-center">
    <p>
      <svg class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <time datetime={publishDate.toISOString()} class="inline-block">{formattedDate}</time>
      {authors.length > 0 && authors.map((author) => (
        <>
          {' · '}
          <svg class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          {author.href ? (
            <a class="hover:underline inline-block" href={author.href}>{author.name}</a>
          ) : (
            <span class="inline-block">{author.name}</span>
          )}
        </>
      ))}
      {category && (
        <>
          {' · '}
          {categoryHref ? (
            <a class="hover:underline inline-block" href={categoryHref}>{category}</a>
          ) : (
            <span class="inline-block">{category}</span>
          )}
        </>
      )}
      {readingTime && (
        <>
          {' · '}
          <span>{readingTimeText.replace('{minutes}', String(readingTime))}</span>
        </>
      )}
    </p>
  </div>

  {/* Title */}
  <h1 class="px-4 sm:px-6 max-w-3xl mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
    {title}
  </h1>

  {/* Excerpt / description */}
  {description && (
    <p class="max-w-3xl mx-auto mt-4 mb-8 px-4 sm:px-6 text-xl md:text-2xl text-muted dark:text-slate-400 text-justify">
      {description}
    </p>
  )}

  {/* Featured image */}
  {image ? (
    <div class="max-w-full lg:max-w-[900px] mx-auto mb-6">
      <img
        src={image.src}
        alt={image.alt || title}
        class="w-full sm:rounded-md bg-gray-400 dark:bg-slate-700"
        loading="eager"
        decoding="async"
      />
    </div>
  ) : (
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="border-t dark:border-slate-700" />
    </div>
  )}
</header>
