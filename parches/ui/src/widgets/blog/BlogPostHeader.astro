---
/**
 * Blog post header — v1 SinglePost style.
 * Layout: metadata line → large title → excerpt → featured image.
 */
import Container from 'parche:elements/Container';
import Icon from 'parche:elements/Icon';
import Image from 'parche:elements/Image';
import Divider from 'parche:elements/Divider';

interface AuthorInfo {
  name: string;
  avatar?: { src: string; alt: string };
  href?: string;
}

interface Props {
  /** Reading-time template, `{minutes}` substituted. Default: English. */
  readingTimeText?: string;
  /** How the date is rendered. Options for Intl.DateTimeFormat — the locale
   *  still decides word order; this decides the style. */
  dateFormat?: Intl.DateTimeFormatOptions;
  title: string;
  description?: string;
  publishDate: Date;
  modifiedDate?: Date;
  category?: string;
  tags?: string[];
  readingTime?: number;
  image?: { src: string; alt: string; caption?: string };
  authors?: AuthorInfo[];
  categoryHref?: string;
  tagHrefs?: string[];
  id?: string;
  class?: string;
}

const {
  readingTimeText = '{minutes} min read',
  dateFormat = { year: 'numeric', month: 'short', day: 'numeric' },
  title,
  description,
  publishDate,
  category,
  readingTime,
  image,
  authors = [],
  categoryHref,
  id,
  class: className = '',
} = Astro.props;

// Format in the page's locale — a Spanish page must not read "Aug 23, 2026".
const dateLocale = Astro.currentLocale ?? 'en-US';
const formattedDate = publishDate.toLocaleDateString(dateLocale, dateFormat);
---

<header {id} class:list={[className]}>
  {/* Metadata line: date · author · category · reading time */}
  <Container width="sm" class="mb-2">
    <p class="text-muted">
      <Icon name="tabler:clock" size="sm" class="inline-block -mt-0.5" />
      {' '}
      <time datetime={publishDate.toISOString()} class="inline-block">{formattedDate}</time>
      {authors.map((author) => (
        <>
          {' · '}
          <Icon name="tabler:user" size="sm" class="inline-block -mt-0.5" />
          {' '}
          {author.href ? <a class="hover:underline inline-block" href={author.href}>{author.name}</a> : <span class="inline-block">{author.name}</span>}
        </>
      ))}
      {category && (
        <>
          {' · '}
          {categoryHref ? <a class="hover:underline inline-block" href={categoryHref}>{category}</a> : <span class="inline-block">{category}</span>}
        </>
      )}
      {readingTime && <>{' · '}<span>{readingTimeText.replace('{minutes}', String(readingTime))}</span></>}
    </p>
  </Container>

  {/* Title */}
  <Container width="sm">
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading">{title}</h1>
  </Container>

  {/* Excerpt / description */}
  {description && (
    <Container width="sm" class="mt-4 mb-8">
      <p class="text-xl md:text-2xl text-muted text-justify">{description}</p>
    </Container>
  )}

  {/* Featured image */}
  {image ? (
    <div class="max-w-full lg:max-w-[900px] mx-auto mb-6">
      <Image src={image.src} alt={image.alt || title} width={900} loading="eager" class="sm:rounded-md" />
    </div>
  ) : (
    <Container width="sm"><Divider /></Container>
  )}
</header>
