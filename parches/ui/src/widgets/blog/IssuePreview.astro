---
/**
 * The latest post as an email in an inbox: who it is from, the subject, a
 * few lines of it and a link to read the whole thing. On a subscribe page it
 * answers "what will I actually get?" without a promise.
 */
import { blogContext } from '../../lib/blog-context';
import { schema, type Props } from './IssuePreview.props';

const p = schema.parse(Astro.props) as Props;
const ctx = blogContext(Astro.locals);
const post = ctx?.posts?.[0];
const labels = ctx?.labels ?? {};
const from = ctx?.brand ?? ctx?.listing.title;
---

{post && (
  <figure class="parche-issue-preview">
    <div class="overflow-hidden rounded-xl border border-border bg-surface">
      <div class="flex items-center gap-2 border-b border-border bg-background px-4 py-2.5">
        <span aria-hidden="true" class="size-2 rounded-full bg-border" /><span aria-hidden="true" class="size-2 rounded-full bg-border" />
        <span class="ml-2 font-mono text-xs text-muted">{labels.issuePreview ?? 'Inbox · a recent issue'}</span>
      </div>
      <div class="p-[clamp(20px,2.6vw,30px)]">
        {from && <p class="font-mono text-xs text-muted">{from}</p>}
        <p class="mt-3 font-heading text-xl leading-[1.3] font-semibold text-heading">{post.issue ? `#${post.issue} · ${post.title}` : post.title}</p>
        {post.excerpt && <p class="mt-3 text-sm leading-[1.6] text-muted">{post.excerpt}</p>}
        <div aria-hidden="true" class="mt-4 flex flex-col gap-2"><span class="h-2 w-11/12 rounded bg-border/70" /><span class="h-2 w-10/12 rounded bg-border/70" /><span class="h-2 w-8/12 rounded bg-border/70" /></div>
        <a href={post.href} class="mt-5 inline-block text-sm font-semibold text-primary no-underline hover:underline">{labels.readInBrowser ?? 'Read the whole issue in the browser'} →</a>
      </div>
    </div>
    {p.caption && <figcaption class="mt-3 text-sm leading-[1.6] text-muted">{p.caption}</figcaption>}
  </figure>
)}
