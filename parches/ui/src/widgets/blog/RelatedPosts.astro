---
/**
 * Related posts — 4-column grid of post cards (v1 style).
 */
import Container from 'parche:elements/Container';
import Section from 'parche:elements/Section';
import Link from 'parche:elements/Link';
import BlogPostCardGrid from 'parche:widgets/blog/BlogPostCardGrid';

interface PostItem {
  title: string;
  description?: string;
  href: string;
  image?: { src: string; alt: string };
  publishDate: Date;
  category?: string;
  tags?: string[];
  readingTime?: number;
}

interface Props {
  title?: string;
  linkText?: string;
  linkUrl?: string;
  posts: PostItem[];
  id?: string;
  class?: string;
  background?: string;
}

const {
  title = 'Related Posts',
  linkText = 'View All Posts',
  linkUrl,
  posts,
  id,
  class: className = '',
} = Astro.props;
---

{posts.length > 0 && (
  <Section {id} class={className}>
    <Container>
      <div class="flex flex-col lg:justify-between lg:flex-row mb-8">
        {title && (
          <div class="md:max-w-sm">
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl sm:leading-none font-heading text-heading mb-2">{title}</h2>
            {linkText && linkUrl && <Link href={linkUrl} variant="arrow" class="mb-6 lg:mb-0">{linkText}</Link>}
          </div>
        )}
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 -mb-6">
        {posts.map((post) => (
          <BlogPostCardGrid title={post.title} description={post.description} href={post.href} image={post.image} />
        ))}
      </div>
    </Container>
  </Section>
)}
