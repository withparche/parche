---
/**
 * The blog's search: the Search element over the index the blog builds with
 * the site. A search with no result is the one time a reader said exactly
 * what they want, so the empty state offers a way on: the most used topics,
 * the archive, and the subscription when there is one.
 */
import Search from 'parche:elements/Search';
import { blogContext } from '../../lib/blog-context';
import { schema, type Props } from './Search.props';

const p = schema.parse(Astro.props) as Props;
const ctx = blogContext(Astro.locals);
const labels = ctx?.labels ?? {};
const topics = [...(ctx?.terms.categories ?? []), ...(ctx?.terms.tags ?? []).map((t) => ({ ...t, name: `#${t.name}` }))].slice(0, p.topics);
const archive = (ctx as { archiveHref?: string } | undefined)?.archiveHref;
const chip = 'inline-flex rounded-full border border-border bg-surface px-3 py-1.5 text-[13px] text-text no-underline hover:border-primary hover:text-primary';
---

<Search
  placeholder={labels.searchPlaceholder ?? 'Search the posts'}
  label={labels.searchTitle ?? 'Search'}
  button={labels.searchButton ?? 'Search'}
  clear={labels.searchClear ?? 'Clear'}
  loading={labels.searchLoading ?? 'Searching…'}
  results={labels.searchResults ?? '{n} results for “{q}”'}
  result={labels.searchResult ?? '1 result for “{q}”'}
  none={labels.searchNone ?? 'Nothing matches “{q}”.'}
  noScript={labels.searchNoScript ?? 'Search runs in the browser.'}
>
  <div class="flex flex-col gap-5">
    {topics.length > 0 && (
      <div>
        <p class="mb-3 font-mono text-[10px] tracking-[0.16em] text-muted uppercase">{labels.searchSuggest ?? 'Try a topic'}</p>
        <ul class="flex list-none flex-wrap gap-2 p-0">{topics.map((t) => <li><a href={t.href} class={chip}>{t.name}</a></li>)}</ul>
      </div>
    )}
    <p class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
      {archive && <a href={archive} class="font-semibold text-primary no-underline hover:underline">{labels.searchArchive ?? 'Browse the archive'} →</a>}
      {ctx?.subscribe && <a href={ctx.subscribe.href} class="font-semibold text-primary no-underline hover:underline">{labels.subscribeNext ?? 'Get the next one by email'} →</a>}
    </p>
  </div>
</Search>
