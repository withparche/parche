---
/**
 * Blog post list item — horizontal layout (v1 ListItem style).
 * Image on the left, content on the right. Stacks on mobile.
 */
import Image from 'parche:elements/Image';
import Icon from 'parche:elements/Icon';
import Tag from 'parche:elements/Tag';

interface Props {
  /** Reading-time template, `{minutes}` substituted. Default: English. */
  readingTimeText?: string;
  /** How the date is rendered. Options for Intl.DateTimeFormat — the locale
   *  still decides word order; this decides the style. */
  dateFormat?: Intl.DateTimeFormatOptions;
  title: string;
  description?: string;
  href: string;
  image?: { src: string; alt: string };
  publishDate: Date;
  category?: string;
  tags?: string[];
  readingTime?: number;
  featured?: boolean;
  draft?: boolean;
  categoryHref?: string;
  tagHrefs?: string[];
  class?: string;
}

const {
  readingTimeText = '{minutes} min read',
  dateFormat = { year: 'numeric', month: 'short', day: 'numeric' },
  title,
  description,
  href,
  image,
  publishDate,
  category,
  tags = [],
  readingTime,
  categoryHref,
  tagHrefs = [],
  class: className = '',
} = Astro.props;

// Format in the page's locale — a Spanish page must not read "Aug 23, 2026".
const dateLocale = Astro.currentLocale ?? 'en-US';
const formattedDate = publishDate.toLocaleDateString(dateLocale, dateFormat);
---

<article class:list={['max-w-md mx-auto md:max-w-none grid gap-6 md:gap-8', image ? 'md:grid-cols-2' : '', className]}>
  {image && href && (
    <a class="block rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" href={href} tabindex="-1" aria-hidden="true">
      <Image src={image.src} alt="" width={800} ratio="16/9" class="rounded shadow-lg md:aspect-[4/3] lg:aspect-video" />
    </a>
  )}

  <div class="mt-2">
    <header>
      <p class="mb-1 text-sm text-muted">
        <Icon name="tabler:clock" size="xs" class="inline-block -mt-0.5" />
        {' '}
        <time datetime={publishDate.toISOString()} class="inline-block">{formattedDate}</time>
        {category && (
          <>
            {' · '}
            {categoryHref ? <a class="hover:underline" href={categoryHref}>{category}</a> : <span>{category}</span>}
          </>
        )}
        {readingTime && <>{' · '}<span>{readingTimeText.replace('{minutes}', String(readingTime))}</span></>}
      </p>
      <h2 class="text-xl sm:text-2xl font-bold leading-tight mb-2 font-heading text-heading">
        {href ? (
          <a class="inline-block hover:text-primary transition-colors" href={href}>{title}</a>
        ) : (
          title
        )}
      </h2>
    </header>

    {description && <p class="flex-grow text-muted text-lg">{description}</p>}

    {tags.length > 0 && (
      <footer class="mt-5 flex flex-wrap gap-1.5">
        {tags.map((tag, i) => <Tag href={tagHrefs[i]} class="lowercase">{tag}</Tag>)}
      </footer>
    )}
  </div>
</article>
