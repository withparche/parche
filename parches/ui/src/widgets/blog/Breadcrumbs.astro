---
/** Breadcrumb trail for blog pages — the Breadcrumb element with the blog's item shape. */
import Breadcrumb from 'parche:elements/Breadcrumb';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<Breadcrumb items={items} class={className} />
