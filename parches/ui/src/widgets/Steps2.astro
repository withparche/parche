---
import type { Props } from './Steps2.props';
import Heading from 'parche:elements/Heading';
import Icon from 'parche:elements/Icon';
import Button from 'parche:elements/Button';

const {
  title,
  subtitle,
  tagline,
  items = [],
  callToAction,
  isReversed = false,
} = Astro.props as Props;
---

<div class:list={['flex flex-col gap-8 md:gap-12 md:flex-row', { 'md:flex-row-reverse': isReversed }]}>
  <!-- Headline + CTA column -->
  <div class:list={['w-full lg:w-1/2', isReversed ? 'lg:ml-16 md:ml-8' : 'lg:mr-16 md:mr-8']}>
    {(title || subtitle || tagline) && (
      <Heading {title} {subtitle} {tagline} spacing={false} class="md:text-left rtl:md:text-right mb-4 md:mb-8" />
    )}

    {callToAction && callToAction.text && callToAction.href && (
      <div class="text-center md:text-left rtl:md:text-right">
        <Button href={callToAction.href} icon={callToAction.icon} class="rounded-md">{callToAction.text}</Button>
      </div>
    )}
  </div>

  <!-- Steps list column -->
  {items.length > 0 && (
    <div class="w-full lg:w-1/2">
      <ul class="space-y-10">
        {items.map(({ title: itemTitle, description, icon }, index) => (
          <li class="flex items-start gap-4">
            <span class="flex w-16 h-16 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary text-2xl font-bold">
              {icon
                ? <Icon name={icon} class="w-6 h-6" />
                : index + 1
              }
            </span>
            <div class="pt-1">
              {itemTitle && (
                <h3 class="type-label font-semibold text-heading mb-2" set:html={itemTitle} />
              )}
              {description && (
                <p class="type-body text-muted" set:html={description} />
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>
