---
/**
 * A section heading + a block of prose (About/bio). Full-bleed section (the
 * DynamicRenderer wrapper handles the section + background); content sits in a
 * narrower container. Override the width with `classes.container` (raw Tailwind).
 */
import { twMerge } from 'tailwind-merge';

interface Props {
  tagline?: string;
  title?: string;
  content?: string;
  classes?: Record<string, string>;
}

const { tagline, title, content, classes = {} } = Astro.props as Props;
---

<div class={twMerge('mx-auto max-w-3xl', classes.container)}>
  {tagline && <p class="mb-1.5 text-base font-medium text-primary">{tagline}</p>}
  {title && <h2 class="text-2xl font-bold text-heading">{title}</h2>}
  {content && (
    <div class="prose prose-neutral mt-4 max-w-none text-lg text-muted leading-relaxed" set:html={content} />
  )}
</div>
