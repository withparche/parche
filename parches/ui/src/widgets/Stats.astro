---
import Heading from 'parche:elements/Heading';
import Stat from 'parche:elements/Stat';
import type { Props } from './Stats.props';

const { title, subtitle, tagline, stats = [] } = Astro.props;
---

<Heading {title} {subtitle} {tagline} />

{stats.length > 0 && (
  <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
    {stats.map(({ amount, title: label, icon }) => amount && <Stat value={amount} label={label ?? ''} icon={icon} />)}
  </div>
)}
