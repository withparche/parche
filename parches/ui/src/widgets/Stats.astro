---
/**
 * Sourced numbers. As figures, the Stat element draws each large, with where
 * it comes from and when underneath. As cards, each is a compact bordered
 * card: the figure in the display face, the label under it.
 */
import { inline } from '../_shared/inline';
import SectionHeader from '../components/SectionHeader.astro';
import Card from 'parche:elements/Card';
import Stat from 'parche:elements/Stat';
import { schema, type Props } from './Stats.props';

const { title, subtitle, tagline, link, align, items, layout, note } = schema.parse(Astro.props) as Props;
const tones = { default: 'text-heading', success: 'text-success', warning: 'text-warning' } as const;
const where = (s: (typeof items)[number]) => [s.source, s.date].filter(Boolean).join(' · ');
---

<SectionHeader {tagline} {title} {subtitle} {link} {align} spacing="xl" />

{items.length > 0 && layout === 'panels' ? (
  <ul class="parche-stats grid grid-cols-[repeat(auto-fit,minmax(min(200px,100%),1fr))] gap-[clamp(14px,1.8vw,18px)]" data-layout="panels">
    {items.map((s) => (
      <Card as="li" padding="md" shadow="none" class="parche-stat-item">
        <p class:list={['font-heading text-[clamp(1.75rem,3vw,2.125rem)] leading-none font-semibold tracking-[-0.03em]', tones[s.tone]]}>{s.value}{s.unit}</p>
        <p class="mt-3 text-sm leading-[1.35] font-semibold text-heading">{s.label}</p>
        {(s.description || s.source || s.date) && (
          <p class="mt-2 text-[13px] leading-[1.55] text-muted [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-2" set:html={inline(s.description) ?? inline([s.source, s.date].filter(Boolean).join(' · '))} />
        )}
      </Card>
    ))}
  </ul>
) : items.length > 0 && layout === 'cards' ? (
  <dl class="parche-stats grid grid-cols-[repeat(auto-fit,minmax(130px,1fr))] gap-2.5" data-layout="cards">
    {items.map((s) => (
      <div class="parche-stat-item flex flex-col rounded-md border border-border bg-surface p-3.5" title={where(s) || undefined}>
        <dt class="order-2 mt-[5px] text-xs leading-[1.3] text-muted">{s.label}</dt>
        <dd class:list={['order-1 type-figure-sm', tones[s.tone]]}>
          {s.href ? <a href={s.href} class="text-inherit no-underline">{s.value}{s.unit}</a> : <>{s.value}{s.unit}</>}
        </dd>
      </div>
    ))}
  </dl>
) : items.length > 0 ? (
  <div class="parche-stats grid grid-cols-[repeat(auto-fit,minmax(11rem,1fr))] gap-x-8 gap-y-6" data-layout="figures">
    {items.map(({ value, unit, label, icon, source, date, href }) => (
      <div class="parche-stat-item">
        <Stat value={unit ? `${value}${unit}` : value} label={label} icon={icon} />
        {(source || date) && (
          <p class="type-meta mt-1">
            {href ? <a href={href} class="underline underline-offset-2 hover:text-heading">{[source, date].filter(Boolean).join(' · ')}</a> : [source, date].filter(Boolean).join(' · ')}
          </p>
        )}
      </div>
    ))}
  </div>
) : null}

{note && <p class="type-caption text-muted mt-6 text-center" set:html={inline(note)} />}
