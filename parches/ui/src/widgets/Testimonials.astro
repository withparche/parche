---
import { inline } from '../_shared/inline';
import * as Carousel from 'parche:elements/Carousel';
import Command from 'parche:elements/Command';
import Actions from '../components/Actions.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { schema, type Props } from './Testimonials.props';

const { title, subtitle, tagline, link, align, items, layout, actions, openSlot } = schema.parse(Astro.props) as Props;
---

<SectionHeader {tagline} {title} {subtitle} {link} {align} spacing="tight" />

{items.length > 0 && layout === 'carousel' ? (
  <Carousel.Root count={items.length} label={title ?? 'Testimonials'} perView={3}>
    {items.map((item, i) => (
      <Carousel.Slide index={i} total={items.length}>
        <TestimonialCard {...item} />
      </Carousel.Slide>
    ))}
  </Carousel.Root>
) : (items.length > 0 || openSlot) ? (
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(280px,100%),1fr))] gap-[clamp(16px,2vw,22px)]">
    {items.map((item) => <TestimonialCard {...item} />)}
    {openSlot && (
      <div class="flex flex-col gap-3 rounded-md border border-dashed border-border bg-background p-[clamp(22px,3vw,30px)]">
        <span class="font-mono text-[10px] leading-none font-medium tracking-[0.12em] text-muted uppercase">{openSlot.label}</span>
        <p class="text-[15px] leading-[1.6] text-muted" set:html={inline(openSlot.text)} />
        {openSlot.copy && (
          <Command variant="button" command={openSlot.copy.text} copyLabel={openSlot.copy.label} copiedLabel={openSlot.copy.copiedLabel ?? 'Copied'} class="mt-auto self-start" />
        )}
      </div>
    )}
  </div>
) : null}

<Actions {actions} class="mt-8 justify-center md:mt-12" />
