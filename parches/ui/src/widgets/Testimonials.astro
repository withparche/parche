---
import type { Props } from './Testimonials.props';
import Heading from 'parche:elements/Heading';
import Button from 'parche:elements/Button';
import * as Carousel from 'parche:elements/Carousel';
import TestimonialCard from '../components/TestimonialCard.astro';

const { title, subtitle, tagline, testimonials = [], layout = 'grid', callToAction } = Astro.props;
---

<Heading {title} {subtitle} {tagline} />

{testimonials.length > 0 && layout === 'carousel' ? (
  <Carousel.Root count={testimonials.length} label={title ?? 'Testimonials'} perView={3}>
    {testimonials.map((item, i) => (
      <Carousel.Slide index={i} total={testimonials.length}>
        <TestimonialCard {...item} />
      </Carousel.Slide>
    ))}
  </Carousel.Root>
) : testimonials.length > 0 ? (
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {testimonials.map((item) => <TestimonialCard {...item} />)}
  </div>
) : null}

{callToAction?.text && callToAction?.href && (
  <div class="flex justify-center mt-8 md:mt-12">
    <Button href={callToAction.href}>{callToAction.text}</Button>
  </div>
)}
