---
import Button from 'parche:elements/Button';
import { schema, type Props } from './Newsletter.props';

const { title, text, action, placeholder, button, note } = schema.parse(Astro.props) as Props;
---

<form action={action} method={action ? 'post' : undefined} class="parche-newsletter rounded-lg border border-border bg-background p-[clamp(22px,3vw,30px)] text-left">
  <p class="mb-1.5 font-heading text-base leading-[1.4] font-semibold text-heading">{title}</p>
  {text && <p class="mb-4 text-sm leading-[1.55] text-muted">{text}</p>}
  <div class="flex flex-wrap gap-2">
    <label class="sr-only" for="parche-newsletter-email">Email</label>
    <input
      id="parche-newsletter-email"
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder={placeholder}
      class="min-w-[180px] flex-1 rounded-sm border border-border bg-surface px-3.5 py-3 text-[15px] leading-none text-heading placeholder:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
    />
    <Button type="submit" variant="contrast" class="px-[18px] py-3 text-[15px] leading-none">{button}</Button>
  </div>
  {note && <p class="mt-3 text-xs leading-[1.5] text-muted">{note}</p>}
</form>
