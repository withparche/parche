---
import Card from 'parche:elements/Card';
import { inline } from '../_shared/inline';
import Button from 'parche:elements/Button';
import { schema, type Props } from './Newsletter.props';

const { title, subtitle, endpoint, placeholder, submit, note } = schema.parse(Astro.props) as Props;
---

<Card as="form" action={endpoint} method={endpoint ? 'post' : undefined} variant="canvas" radius="lg" padding="lg" shadow="none" class="parche-newsletter text-left">
  <p class="mb-1.5 type-title" set:html={inline(title)} />
  {subtitle && <p class="mb-4 text-sm leading-[1.55] text-muted" set:html={inline(subtitle)} />}
  <div class="flex flex-wrap gap-2">
    <label class="sr-only" for="parche-newsletter-email">Email</label>
    <input
      id="parche-newsletter-email"
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder={placeholder}
      class="min-w-[180px] flex-1 rounded-sm border border-border bg-surface px-3.5 py-3 text-[15px] leading-none text-heading placeholder:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
    />
    <Button type="submit" variant="contrast" class="px-[18px] py-3 text-[15px] leading-none">{submit}</Button>
  </div>
  {note && <p class="mt-3 text-xs leading-[1.5] text-muted" set:html={inline(note)} />}
</Card>
