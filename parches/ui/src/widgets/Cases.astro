---
/**
 * Case studies as evidence: client and sector, what was done, and the
 * measured results; a featured case leads full width with its quote; rows put
 * the image beside the text; results can lead each case.
 */
import SectionHeader from '../components/SectionHeader.astro';
import CaseCard from '../components/CaseCard.astro';
import { schema, type Props } from './Cases.props';

const { tagline, title, subtitle, link, align, items, layout, results } = schema.parse(Astro.props) as Props;
const rows = layout === 'rows';
---

<!-- One root, so a Section stacks this widget as one block. -->
<div class="parche-cases-section">
<SectionHeader {tagline} {title} {subtitle} {link} {align} />

{items.length > 0 && (
  <div class:list={['parche-cases grid gap-[clamp(18px,2.5vw,28px)]', rows ? 'grid-cols-1' : 'grid-cols-[repeat(auto-fill,minmax(min(300px,100%),1fr))]']} data-layout={layout}>
    {items.map((c) => <CaseCard item={c} shape={c.featured ? 'featured' : rows ? 'row' : 'card'} resultsFirst={results === 'top'} />)}
  </div>
)}
</div>
