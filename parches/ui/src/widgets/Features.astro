---
/**
 * The one features widget. `layout` picks how an item is drawn: an icon badge
 * beside the text, a card, or a compact list row. The `media` slot (or the
 * `image` prop) sits between the headline and the items.
 */
import SectionHeader from '../components/SectionHeader.astro';
import Icon from 'parche:elements/Icon';
import Image from 'parche:elements/Image';
import Card from 'parche:elements/Card';
import Button from 'parche:elements/Button';
import { schema, type Props } from './Features.props';

const { layout, align, title, subtitle, tagline, link, items, columns, defaultIcon, image } = schema.parse(Astro.props) as Props;
const hairline = layout === 'panels' || layout === 'tiles';
const hasMedia = Astro.slots.has('media') || Boolean(image);

const gridCols =
  columns === '4'
    ? 'lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2'
    : columns === '3'
      ? 'lg:grid-cols-3 sm:grid-cols-2'
      : 'sm:grid-cols-2';
const gap = layout === 'cards' ? 'gap-4 md:gap-6' : layout === 'list' ? 'gap-6 md:gap-8' : 'gap-8 md:gap-y-12';
---

<div class="parche-features" data-layout={layout}>
  <SectionHeader {tagline} {title} {subtitle} {link} {align} width={align === 'start' ? 'lg' : 'md'} spacing={layout === 'tiles' ? 'sm' : 'xl'} />

  {hasMedia && (
    <div class="parche-features-media mb-8 md:mb-12">
      <slot name="media">
        {image && <Image src={image.src} alt={image.alt} width={1024} ratio="21/9" class="rounded-xl shadow-lg" />}
      </slot>
    </div>
  )}

  {items.length > 0 && hairline ? (
    <div
      class:list={[
        'grid gap-px overflow-hidden rounded-lg border border-border bg-border',
        layout === 'panels' ? 'grid-cols-[repeat(auto-fit,minmax(min(270px,100%),1fr))]' : 'grid-cols-[repeat(auto-fill,minmax(min(180px,100%),1fr))]',
      ]}
    >
      {items.map((item, i) =>
        layout === 'panels' ? (
          <div class="bg-surface p-[clamp(22px,3vw,34px)]">
            <div class="mb-[18px] font-mono text-[11px] leading-none font-medium text-primary">{String(i + 1).padStart(2, '0')}</div>
            {item.title && <h3 class="mb-2.5 font-heading text-(length:--ds-sys-type-h3-size) leading-[1.3] font-semibold tracking-[-0.015em] text-heading" set:html={item.title} />}
            {item.description && <p class="text-[15px] leading-[1.6] text-muted" set:html={item.description} />}
          </div>
        ) : (
          <div class="bg-surface p-5">
            {item.title && <div class="mb-1.5 text-[15px] leading-[1.3] font-semibold text-heading" set:html={item.title} />}
            {item.description && <div class="text-[13px] leading-[1.5] text-muted" set:html={item.description} />}
          </div>
        ),
      )}
    </div>
  ) : items.length > 0 && (
    <div class:list={['grid mx-auto', gap, gridCols]}>
      {items.map((item) => {
        const iconName = item.icon || defaultIcon;
        const body = (
          <Fragment>
            {item.title && <h3 class:list={['text-heading', layout === 'list' ? 'text-lg font-semibold' : 'font-bold text-xl md:text-[1.3rem]', layout === 'cards' && 'mb-2']} set:html={item.title} />}
            {item.description && <p class:list={['text-muted type-body', layout === 'cards' ? 'grow' : item.title ? (layout === 'list' ? 'mt-0.5' : 'mt-3') : '']} set:html={item.description} />}
            {item.link?.text && (
              <div class:list={[layout === 'cards' ? 'mt-4' : layout === 'list' ? 'mt-2' : 'mt-3']}>
                <Button variant="link" href={item.link.href} class="font-semibold">{item.link.text}</Button>
              </div>
            )}
          </Fragment>
        );
        return layout === 'cards' ? (
          <Card padding="md" class="flex flex-col">
            {iconName && <Icon name={iconName} class="w-12 h-12 mb-6 text-primary" />}
            {body}
          </Card>
        ) : (
          <div class="flex flex-row max-w-full sm:max-w-md">
            {iconName && (
              layout === 'grid' ? (
                <div class="flex items-center justify-center rounded-full bg-primary text-on-primary w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0 shrink-0">
                  <Icon name={iconName} class="size-full" />
                </div>
              ) : (
                <div class="shrink-0 mt-1 mr-4 rtl:ml-4 rtl:mr-0">
                  <Icon name={iconName} size="lg" class="text-primary" />
                </div>
              )
            )}
            <div class:list={[layout === 'grid' && 'mt-0.5']}>{body}</div>
          </div>
        );
      })}
    </div>
  )}
</div>
