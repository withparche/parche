---
/**
 * The one features widget. `layout` picks how an item is drawn: an icon badge
 * beside the text, a card, a compact list row, a cell between hairlines, a
 * row with side columns, or an image tile. An item carries the design's
 * anatomy (eyebrow, title and aside, description, points, footer, image,
 * tone), and each layout draws what it has. The `media` slot (or the `image`
 * prop) sits between the headline and the items; `header: side` puts the
 * heading in a column beside them.
 */
import { inline } from '../_shared/inline';
import { pictureBox, plainPicture, screenshotOf } from '../_shared/content';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from 'parche:elements/Icon';
import Image from 'parche:elements/Image';
import Button from 'parche:elements/Button';
import List from 'parche:elements/List';
import FeatureCard from '../components/FeatureCard.astro';
import FeatureRow from '../components/FeatureRow.astro';
import Actions from '../components/Actions.astro';
import Placeholder from 'parche:elements/Placeholder';
import Screenshot from './Screenshot.astro';
import { schema, type Props } from './Features.props';

const { layout, header, align, title, subtitle, tagline, link, items, columns, card, accent, asideStyle, actions, defaultIcon, image } = schema.parse(Astro.props) as Props;
const side = header === 'side';
const rich = items.some((i) => i.points.length > 0 || i.footer);
// Cards wrap to fit, never more across than `columns`: each track is at least
// its minimum width and at least a 1/n share of the row.
const n = Number(columns);
const minimum = { 1: 0, 2: 280, 3: 250, 4: 220, 5: 180, 6: 160 }[n] ?? 250;
const fitStyle = n === 1 ? 'grid-template-columns:minmax(0,1fr)' : `grid-template-columns:repeat(auto-fit,minmax(max(min(${minimum}px,100%),calc((100% - ${n - 1} * 22px) / ${n})),1fr))`;
const hairline = layout === 'panels' || layout === 'tiles';
const hasMedia = Astro.slots.has('media') || Boolean(image);

const gridCols =
  columns === '1'
    ? 'grid-cols-1'
    : columns === '4'
    ? 'lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2'
    : columns === '3'
      ? 'lg:grid-cols-3 sm:grid-cols-2'
      : 'sm:grid-cols-2';
const gap = layout === 'list' ? 'gap-6 md:gap-8' : 'gap-8 md:gap-y-12';
---

<div class:list={['parche-features', side && 'grid grid-cols-[repeat(auto-fit,minmax(min(290px,100%),1fr))] gap-[clamp(24px,4vw,56px)]']} data-layout={layout}>
  {side ? (
    <div class="min-w-0">
      <SectionHeader {tagline} {title} {subtitle} {link} align="start" width="lg" spacing="none" />
    </div>
  ) : (
    <SectionHeader {tagline} {title} {subtitle} {link} {align} width={align === 'start' ? 'lg' : 'md'} spacing={layout === 'tiles' ? 'sm' : 'xl'} />
  )}
  <div class="min-w-0">

  {hasMedia && (
    <div class="parche-features-media mb-8 md:mb-12">
      <slot name="media">
        {image && (plainPicture(image)
          ? <Image src={image.src} alt={image.alt} {...pictureBox(1024, image.ratio ?? '21/9')} class="rounded-xl shadow-lg" />
          : <Screenshot {...screenshotOf(image, '21/9')} />)}
      </slot>
    </div>
  )}

  {items.length > 0 && hairline ? (
    <div
      class:list={[
        'grid gap-px overflow-hidden rounded-lg border border-border bg-border',
        // auto-fit, not auto-fill: an empty track would show the border colour as a grey cell.
        layout === 'panels' ? 'grid-cols-[repeat(auto-fit,minmax(min(270px,100%),1fr))]' : 'grid-cols-[repeat(auto-fit,minmax(min(180px,100%),1fr))]',
      ]}
    >
      {items.map((item, i) =>
        layout === 'panels' ? (
          <div class="bg-surface p-[clamp(22px,3vw,34px)]">
            <div class="mb-[18px] font-mono text-[11px] leading-none font-medium text-primary" set:html={inline(item.eyebrow) ?? String(i + 1).padStart(2, '0')} />
            {item.title && <h3 class="mb-2.5 font-heading text-(length:--ds-sys-type-h3-size) leading-[1.3] font-semibold tracking-[-0.015em] text-heading" set:html={inline(item.title)} />}
            {item.description && <p class="type-body-sm text-muted" set:html={inline(item.description)} />}
          </div>
        ) : (
          <div class="bg-surface p-5">
            {item.title && <div class="mb-1.5 type-title-sm" set:html={inline(item.title)} />}
            {item.description && <div class="type-small text-muted" set:html={inline(item.description)} />}
          </div>
        ),
      )}
    </div>
  ) : items.length > 0 && layout === 'strip' ? (
    <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(170px,100%),1fr))] gap-x-[clamp(20px,3vw,40px)] gap-y-5">
      {items.map((item) => (
        <li class:list={[item.tone === 'muted' && 'opacity-60']}>
          {item.title && <p class="mb-1 text-sm leading-[1.35] font-semibold text-heading" set:html={inline(item.title)} />}
          {item.description && <p class="text-[13px] leading-[1.5] text-muted" set:html={inline(item.description)} />}
          {item.footer && <p class="mt-1 font-mono text-[11px] leading-[1.4] text-muted" set:html={inline(item.footer)} />}
        </li>
      ))}
    </ul>
  ) : items.length > 0 && layout === 'cards' ? (
    <div class="grid gap-[clamp(16px,2.2vw,22px)]" style={fitStyle}>
      {items.map((item) => <FeatureCard {item} icon={item.icon || defaultIcon} {rich} {card} {accent} {asideStyle} />)}
    </div>
  ) : items.length > 0 && layout === 'gallery' ? (
    <div class="grid grid-cols-[repeat(auto-fill,minmax(min(200px,100%),1fr))] gap-[clamp(12px,1.8vw,18px)]">
      {items.map((item) => {
        const Tile = item.href ? 'a' : 'div';
        return (
          <Tile href={item.href} class="group block text-inherit no-underline">
            {item.image ? (
              <Image src={item.image.src} alt={item.image.alt} width={480} ratio="4/5" class="mb-3 block w-full rounded-md border border-border transition-colors group-hover:border-primary" />
            ) : item.placeholder && (
              <Placeholder caption={item.placeholder} label={item.title?.replace(/[*_`=]/g, '')} ratio="4/5" compact class="mb-3 rounded-md border border-border transition-colors group-hover:border-primary" />
            )}
            {item.title && <p class="font-heading text-base leading-[1.3] font-semibold text-heading group-hover:text-primary" set:html={inline(item.title)} />}
            {item.description && <p class="mt-1 type-small text-muted" set:html={inline(item.description)} />}
          </Tile>
        );
      })}
    </div>
  ) : items.length > 0 && layout === 'rows' ? (
    <List as="ul" padding={items.some((i) => i.description) ? 'lg' : 'md'}>
      {items.map((item) => <FeatureRow {item} {accent} hasEyebrow={items.some((i) => i.eyebrow)} hasAside={items.some((i) => i.aside)} />)}
    </List>
  ) : items.length > 0 && (
    <div class:list={['grid mx-auto', gap, gridCols]}>
      {items.map((item) => {
        const iconName = item.icon || defaultIcon;
        const body = (
          <Fragment>
            {item.title && <h3 class:list={['text-heading', layout === 'list' ? 'text-lg font-semibold' : 'font-bold text-xl md:text-[1.3rem]', layout === 'cards' && 'mb-2']} set:html={inline(item.title)} />}
            {item.description && <p class:list={['text-muted type-body', layout === 'cards' ? 'grow' : item.title ? (layout === 'list' ? 'mt-0.5' : 'mt-3') : '']} set:html={inline(item.description)} />}
            {item.link?.text && (
              <div class:list={[layout === 'cards' ? 'mt-4' : layout === 'list' ? 'mt-2' : 'mt-3']}>
                <Button variant="link" href={item.link.href} class="font-semibold">{item.link.text}</Button>
              </div>
            )}
          </Fragment>
        );
        return (
          <div class="flex flex-row max-w-full sm:max-w-md">
            {iconName && (
              layout === 'grid' ? (
                <div class="flex items-center justify-center rounded-full bg-primary text-on-primary w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0 shrink-0">
                  <Icon name={iconName} class="size-full" />
                </div>
              ) : (
                <div class="shrink-0 mt-1 mr-4 rtl:ml-4 rtl:mr-0">
                  <Icon name={iconName} size="lg" class="text-primary" />
                </div>
              )
            )}
            <div class:list={[layout === 'grid' && 'mt-0.5']}>{body}</div>
          </div>
        );
      })}
    </div>
  )}
  <Actions {actions} class="mt-8" />
  </div>
</div>
