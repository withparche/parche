---
/**
 * Blog highlighted posts grid — v1 style.
 * Fetches specific blog posts by ID and renders them in a 4-column grid.
 * Falls back to latest posts if no postIds provided.
 */
import { getCollection } from 'astro:content';
import { getBlogLinkContext, postHref, postLocale, localizePath } from '../lib/blog-links.js';
import Container from 'parche:primitives/Container';
import Section from 'parche:primitives/Section';

interface Props {
  title?: string;
  linkText?: string;
  linkUrl?: string;
  information?: string;
  postIds?: string[];
  id?: string;
  class?: string;
  background?: string;
}

const {
  title,
  linkText = 'View all posts',
  linkUrl,
  information,
  postIds = [],
  id,
  class: className = '',
  background,
} = Astro.props;

// Fetch posts — by ID if specified, otherwise latest
let resolvedLinkUrl = linkUrl ?? '/blog';
let posts: Array<{
  title: string;
  description?: string;
  href: string;
  image?: { src: string; alt: string };
}> = [];

try {
  const { postPattern, listing, defaultLocale } = await getBlogLinkContext();
  const locale = Astro.currentLocale ?? defaultLocale;
  resolvedLinkUrl = linkUrl ?? localizePath(listing, locale, defaultLocale);

  const allPosts = await getCollection('posts');
  const nonDraft = allPosts.filter((p: any) => !p.data.draft);
  const localePosts = nonDraft.filter((p: any) => postLocale(p.id, defaultLocale) === locale);

  let selected: typeof allPosts;

  if (postIds.length > 0) {
    // Find posts matching the given IDs, preserve order. A bare key resolves to
    // this locale's copy; a fully-qualified id (e.g. 'es/mi-post') still wins.
    const match = (pool: typeof allPosts, pid: string) =>
      pool.find((p: any) => p.id === pid || p.id.endsWith(`/${pid}`) || p.data.urlSlug === pid);
    selected = postIds
      .map((pid) => match(localePosts, pid) ?? match(nonDraft, pid))
      .filter(Boolean) as typeof allPosts;
  } else {
    // Fallback: this locale's latest 4 posts
    selected = localePosts
      .sort((a: any, b: any) => {
        const dateA = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0;
        const dateB = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0;
        return dateB - dateA;
      })
      .slice(0, 4);
  }

  posts = selected.map((post: any) => ({
    title: post.data.title,
    description: post.data.description ?? post.data.excerpt,
    // Honour the configured permalink pattern instead of assuming a root-level slug.
    href: postHref(postPattern, post, locale, defaultLocale),
    image: post.data.image,
  }));
} catch {
  // Blog collection may not exist — widget renders nothing
}
---

{posts.length > 0 && (
  <Section {id} class={className} {background}>
    <Container>
      <div class="flex flex-col lg:justify-between lg:flex-row mb-8">
        {title && (
          <div class="md:max-w-sm">
            <h2
              class="text-3xl font-bold tracking-tight sm:text-4xl sm:leading-none group font-heading mb-2"
              set:html={title}
            />
            {linkText && resolvedLinkUrl && (
              <a
                class="text-muted dark:text-slate-400 hover:text-primary transition ease-in duration-200 block mb-6 lg:mb-0"
                href={resolvedLinkUrl}
              >
                {linkText} »
              </a>
            )}
          </div>
        )}

        {information && (
          <p
            class="text-muted dark:text-slate-400 lg:text-sm lg:max-w-md"
            set:html={information}
          />
        )}
      </div>

      <div class="grid gap-6 row-gap-5 md:grid-cols-2 lg:grid-cols-4 -mb-6">
        {posts.map((post) => (
          <article class="mb-6 transition">
            {post.image && (
              <div class="relative h-52 md:h-64 bg-gray-400 dark:bg-slate-700 rounded shadow-lg mb-6">
                {post.href ? (
                  <a href={post.href} class="block h-full">
                    <img
                      src={post.image.src}
                      alt={post.image.alt || post.title}
                      class="w-full h-full rounded shadow-lg bg-gray-400 dark:bg-slate-700 object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                ) : (
                  <img
                    src={post.image.src}
                    alt={post.image.alt || post.title}
                    class="w-full h-full rounded shadow-lg bg-gray-400 dark:bg-slate-700 object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
            )}

            <h3 class="text-xl sm:text-2xl font-bold leading-tight mb-2 font-heading dark:text-slate-300">
              {post.href ? (
                <a
                  class="inline-block hover:text-primary dark:hover:text-blue-700 transition ease-in duration-200"
                  href={post.href}
                >
                  {post.title}
                </a>
              ) : (
                post.title
              )}
            </h3>

            {post.description && (
              <p class="text-muted dark:text-slate-400 text-lg">{post.description}</p>
            )}
          </article>
        ))}
      </div>
    </Container>
  </Section>
)}
