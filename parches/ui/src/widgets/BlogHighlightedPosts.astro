---
/**
 * Blog highlighted posts grid — v1 style.
 * Fetches specific blog posts by ID and renders them in a 4-column grid.
 * Falls back to latest posts if no postIds provided.
 */
import { entriesOf, memo } from 'parche:utils/entries';
import { resolveAssets } from 'parche:utils/assets';
import { getBlogLinkContext, postHref, postLocale, localizePath } from '../lib/blog-links.js';
import { urlFor } from 'parche:registry/urls';
import SectionHeader from '../components/SectionHeader.astro';
import BlogPostCardGrid from 'parche:widgets/blog/BlogPostCardGrid';
import { schema, type Props } from './BlogHighlightedPosts.props';

const { tagline, title, subtitle, link, align, postIds } = schema.parse(Astro.props) as Props;

// Fetch posts — by ID if specified, otherwise latest
let resolvedLinkUrl = (link && link.href) || '/blog';
let posts: Array<{
  title: string;
  description?: string;
  href: string;
  image?: { src: string; alt: string };
}> = [];

try {
  const { postPattern, listing, defaultLocale } = await getBlogLinkContext();
  const locale = Astro.currentLocale ?? defaultLocale;
  resolvedLinkUrl = (link && link.href) || localizePath(listing, locale, defaultLocale);

  // The blog says where its posts are served; the pattern below is only for a site without it.
  const postUrl = await urlFor('posts');
  // Read once per build or server (parche:utils/entries); this locale's
  // posts newest first, sorted once too, the list BlogLatestPosts shares.
  const allPosts = await entriesOf('posts');
  const nonDraft = memo('ui:posts', () => allPosts.filter((p: any) => !p.data.draft));
  const localePosts = memo(`ui:posts:${locale}`, () =>
    nonDraft
      .filter((p: any) => postLocale(p.id, defaultLocale) === locale)
      .sort((a: any, b: any) => {
        const dateA = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0;
        const dateB = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0;
        return dateB - dateA;
      }),
  );

  let selected: typeof allPosts;

  if (postIds.length > 0) {
    // Find posts matching the given IDs, preserve order. A bare key resolves to
    // this locale's copy; a fully-qualified id (e.g. 'es/mi-post') still wins.
    const match = (pool: typeof allPosts, pid: string) =>
      pool.find((p: any) => p.id === pid || p.id.endsWith(`/${pid}`) || p.data.urlSlug === pid);
    selected = postIds
      .map((pid) => match(localePosts, pid) ?? match(nonDraft, pid))
      .filter(Boolean) as typeof allPosts;
  } else {
    // Fallback: this locale's latest 4 posts
    selected = localePosts.slice(0, 4);
  }

  posts = await resolveAssets(selected.map((post: any) => ({
    title: post.data.title,
    description: post.data.description ?? post.data.excerpt,
    href: postUrl ? postUrl(post) : postHref(postPattern, post, locale, defaultLocale),
    image: post.data.image,
  })));
} catch {
  // Blog collection may not exist — widget renders nothing
}
---

{posts.length > 0 && (
  <div class="parche-blog-posts">
    <SectionHeader {tagline} {title} {subtitle} link={link ? { text: link.text, href: resolvedLinkUrl } : undefined} {align} spacing="lg" />
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {posts.map((post) => (
        <BlogPostCardGrid title={post.title} description={post.description} href={post.href} image={post.image} />
      ))}
    </div>
  </div>
)}
