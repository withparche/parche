---
/**
 * The Callout element in page content, with inline Markdown in its texts.
 */
import CalloutElement from 'parche:elements/Callout';
import { inline } from '../_shared/inline';
import Action from '../components/Action.astro';
import { schema, type Props } from './Callout.props';

const { label, title, description, items, rows, footer, actions, ...look } = schema.parse(Astro.props) as Props;
---

<CalloutElement
  {...look}
  label={inline(label)}
  title={inline(title)}
  description={inline(description)}
  items={items.map((i) => inline(i) ?? '')}
  rows={rows.map((r) => ({ label: inline(r.label) ?? '', value: inline(r.value) ?? '', tone: r.tone }))}
  footer={inline(footer)}
>
  {actions.length > 0 && <Fragment slot="actions">{actions.map((a) => <Action action={a} size="md" class="w-full" />)}</Fragment>}
</CalloutElement>
