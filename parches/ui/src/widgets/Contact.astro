---
/**
 * Contact: a form, and optionally the other path, bookable slots. Centered
 * puts the form under the heading; split puts the heading and the slots on
 * the left and the form, on a card, on the right.
 */
import Button from 'parche:elements/Button';
import Input from 'parche:elements/Input';
import Textarea from 'parche:elements/Textarea';
import Checkbox from 'parche:elements/Checkbox';
import SectionHeader from '../components/SectionHeader.astro';
import { schema, type Props } from './Contact.props';

const { tagline, title, subtitle, link, inputs, textarea, disclaimer, submit, endpoint, note, layout, booking } = schema.parse(Astro.props) as Props;
// Centred, the heading sits over the form unless the content says otherwise.
const align = (Astro.props as { align?: 'start' | 'center' }).align ?? (layout === 'split' ? 'start' : 'center');

// The content gives a free-form input type; the element takes a known one.
const inputTypes = ['text', 'email', 'url', 'tel', 'password', 'number', 'search', 'date', 'time'] as const;
type InputType = (typeof inputTypes)[number];
const typeOf = (type: string): InputType => (inputTypes.includes(type as InputType) ? (type as InputType) : 'text');
const humanize = (name: string) => name.charAt(0).toUpperCase() + name.slice(1).replace(/[-_]+/g, ' ');
const split = layout === 'split';
---

{split ? (
  <div class="parche-contact grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] items-start gap-[clamp(28px,4vw,56px)]" data-layout="split">
    <div class="min-w-0">
      <SectionHeader {tagline} {title} {subtitle} {link} {align} spacing="none" class="mb-[26px]" />
      {booking && (
        <div class="rounded-md border border-border bg-surface px-5 py-[18px]">
          <div class="mb-3.5 flex flex-wrap items-center justify-between gap-4">
            <span class="text-[15px] leading-none font-semibold text-heading">{booking.title}</span>
            {booking.badge && <span class="rounded-full bg-success-soft px-[9px] py-[5px] font-mono text-[11px] leading-none font-medium text-success">{booking.badge}</span>}
          </div>
          <ul class="flex flex-wrap gap-2">
            {booking.slots.map((s) => {
              const cls = s.selected
                ? 'border-primary bg-primary-soft text-primary'
                : 'border-border bg-background text-heading hover:border-primary';
              return (
                <li>
                  {s.href ? (
                    <a href={s.href} class:list={['block rounded-sm border px-3 py-[9px] font-mono text-[13px] leading-none font-medium no-underline', cls]} aria-current={s.selected ? 'true' : undefined}>{s.label}</a>
                  ) : (
                    <span class:list={['block rounded-sm border px-3 py-[9px] font-mono text-[13px] leading-none font-medium', cls]}>{s.label}</span>
                  )}
                </li>
              );
            })}
          </ul>
          {booking.note && <p class="mt-3.5 text-xs leading-[1.5] text-muted">{booking.note}</p>}
        </div>
      )}
    </div>
    <form action={endpoint} method={endpoint ? 'post' : undefined} class="min-w-0 rounded-lg border border-border bg-surface p-[clamp(22px,3vw,32px)]">
      <div class="flex flex-col gap-4">
        {inputs.map((input) => (
          <Input name={input.name} label={input.label ?? humanize(input.name)} type={typeOf(input.type ?? 'text')} placeholder={input.placeholder} autocomplete={input.autocomplete} />
        ))}
        {textarea && <Textarea name={textarea.name ?? 'message'} label={textarea.label ?? 'Message'} placeholder={textarea.placeholder} rows={textarea.rows ?? 3} grow={false} />}
        {disclaimer?.label && <Checkbox name="disclaimer" label={disclaimer.label} />}
        <Button type="submit" size="lg" block>{submit}</Button>
        {note && <p class="text-xs leading-[1.5] text-muted" set:html={note} />}
      </div>
    </form>
  </div>
) : (
  <>
    <SectionHeader {tagline} {title} {subtitle} {link} {align} spacing="xl" />
    {inputs.length > 0 && (
      <div class="flex flex-col max-w-xl mx-auto rounded-lg bg-surface border border-border shadow p-4 sm:p-6 lg:p-8 w-full">
        <form action={endpoint} method={endpoint ? 'post' : undefined}>
          <div class="flex flex-col gap-4">
            {inputs.map((input) => (
              <Input name={input.name} label={input.label ?? humanize(input.name)} type={typeOf(input.type ?? 'text')} placeholder={input.placeholder} autocomplete={input.autocomplete} />
            ))}
            {textarea && <Textarea name={textarea.name ?? 'message'} label={textarea.label ?? 'Message'} placeholder={textarea.placeholder} rows={textarea.rows ?? 4} />}
            {disclaimer?.label && <Checkbox name="disclaimer" label={disclaimer.label} />}
            <div>
              <Button type="submit" size="lg" block>{submit}</Button>
            </div>
            {note && <p class="text-center text-xs text-muted" set:html={note} />}
          </div>
        </form>
      </div>
    )}
  </>
)}
