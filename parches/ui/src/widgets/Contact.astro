---
/**
 * Contact: a form that says what happens next, and optionally the other
 * path, bookable slots. Centered puts the form on a card under the heading;
 * split puts the heading and the slots on the left and the form, on a card,
 * on the right; plain drops the card, for a column beside other content.
 */
import Card from 'parche:elements/Card';
import { inline } from '../_shared/inline';
import SectionHeader from '../components/SectionHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import { schema, type Props } from './Contact.props';

const { tagline, title, subtitle, link, fields, submit, endpoint, loading, error, success, note, layout, booking } = schema.parse(Astro.props) as Props;
// Centred, the heading sits over the form unless the content says otherwise.
const align = (Astro.props as { align?: 'start' | 'center' }).align ?? (layout === 'centered' ? 'center' : 'start');
const split = layout === 'split';
const form = { fields, submit, note, endpoint, loading, error, success, label: title?.replace(/<[^>]+>|[*_`=]/g, '') };
---

{split ? (
  <div class="parche-contact grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] items-start gap-[clamp(28px,4vw,56px)]" data-layout="split">
    <div class="min-w-0">
      <SectionHeader {tagline} {title} {subtitle} {link} {align} spacing="none" class="mb-[26px]" />
      {booking && (
        <Card padding="sm" shadow="none">
          <div class="mb-3.5 flex flex-wrap items-center justify-between gap-4">
            <span class="text-[15px] leading-none font-semibold text-heading">{booking.title}</span>
            {booking.badge && <span class="rounded-full bg-success-soft px-[9px] py-[5px] font-mono text-[11px] leading-none font-medium text-success">{booking.badge}</span>}
          </div>
          <ul class="flex flex-wrap gap-2">
            {booking.slots.map((s) => {
              const cls = s.selected
                ? 'border-primary bg-primary-soft text-primary'
                : 'border-border bg-background text-heading hover:border-primary';
              return (
                <li>
                  {s.href ? (
                    <a href={s.href} class:list={['block rounded-sm border px-3 py-[9px] font-mono text-[13px] leading-none font-medium no-underline', cls]} aria-current={s.selected ? 'true' : undefined}>{s.label}</a>
                  ) : (
                    <span class:list={['block rounded-sm border px-3 py-[9px] font-mono text-[13px] leading-none font-medium', cls]}>{s.label}</span>
                  )}
                </li>
              );
            })}
          </ul>
          {booking.note && <p class="mt-3.5 text-xs leading-[1.5] text-muted" set:html={inline(booking.note)} />}
        </Card>
      )}
    </div>
    <Card radius="lg" padding="lg" shadow="none" class="min-w-0">
      <ContactForm {...form} />
    </Card>
  </div>
) : layout === 'plain' ? (
  <div class="parche-contact" data-layout="plain">
    <SectionHeader {tagline} {title} {subtitle} {link} {align} spacing="none" class="mb-[26px]" />
    {fields.length > 0 && <ContactForm {...form} />}
  </div>
) : (
  <div class="parche-contact" data-layout="centered">
    <SectionHeader {tagline} {title} {subtitle} {link} {align} spacing="xl" />
    {fields.length > 0 && (
      <Card radius="lg" padding="lg" shadow="none" class="mx-auto w-full max-w-xl">
        <ContactForm {...form} center />
      </Card>
    )}
  </div>
)}
