---
/**
 * Pricing: the tiers as cards, the recommended one marked, and a comparison
 * table under them with one column per plan. Cards sell, the table closes.
 *
 * With `periods` (monthly, yearly…) a control sits over the plans, with one
 * grid per period; a plan's field that changes is keyed by period
 * (`"price": { "monthly": "29", "yearly": "290" }`), one that does not is
 * written once. The control is the Tabs element, as Switch uses it, so the
 * chosen period can live in the URL and, without script, every period shows.
 */
import Tabs from 'parche:elements/Tabs';
import { inline } from '../_shared/inline';
import TableElement from 'parche:elements/Table';
import SectionHeader from '../components/SectionHeader.astro';
import PricingPlans, { type Plan } from '../components/PricingPlans.astro';
import { schema, periodFields, type Props } from './Pricing.props';

const { title, subtitle, tagline, link, align, level, periods, items, note, comparison } = schema.parse(Astro.props) as Props;

/** A plan with every field at one period's value. */
const at = (period?: string) => (plan: (typeof items)[number]): Plan => {
  const out: Record<string, unknown> = { ...plan };
  for (const field of periodFields) {
    const v = (plan as Record<string, unknown>)[field];
    if (v && typeof v === 'object' && !Array.isArray(v)) out[field] = period ? (v as Record<string, unknown>)[period] : undefined;
  }
  out.features ??= [];
  out.actions ??= [];
  out.noteTone ??= 'muted';
  return out as unknown as Plan;
};
const visible = (p: Plan) => Boolean(p.price || p.title);
const plans = items.map(at(periods?.options[0]?.value)).filter(visible);
const forPeriod = (i: number) => (periods?.options[i] ? items.map(at(periods.options[i].value)).filter(visible) : []);
const featured = plans.findIndex((p) => p.recommended);
const spaced = Boolean(comparison && !note);
const hasHeading = Boolean(title || tagline || subtitle);
const name = (i: number) => periods?.options[i]?.value ?? `__none-${i}`;
---

<!-- One root, so a Section stacks this widget as one block. -->
<div class:list={['parche-pricing', periods && !hasHeading && align === 'center' && 'text-center [&_.parche-tabs-list]:justify-center']}>
{periods ? (
  <Tabs items={periods.options} value={periods.value} syncKey={periods.syncKey} variant="pill" label={periods.label}>
    {hasHeading && <SectionHeader slot="header" {tagline} {title} {subtitle} {link} {level} width="sm" spacing="none" />}
    <Fragment slot={name(0)}>{periods.options[0] && <PricingPlans plans={forPeriod(0)} {spaced} />}</Fragment>
    <Fragment slot={name(1)}>{periods.options[1] && <PricingPlans plans={forPeriod(1)} {spaced} />}</Fragment>
    <Fragment slot={name(2)}>{periods.options[2] && <PricingPlans plans={forPeriod(2)} {spaced} />}</Fragment>
    <Fragment slot={name(3)}>{periods.options[3] && <PricingPlans plans={forPeriod(3)} {spaced} />}</Fragment>
    <Fragment slot={name(4)}>{periods.options[4] && <PricingPlans plans={forPeriod(4)} {spaced} />}</Fragment>
    <Fragment slot={name(5)}>{periods.options[5] && <PricingPlans plans={forPeriod(5)} {spaced} />}</Fragment>
  </Tabs>
) : (
  <>
    <SectionHeader {tagline} {title} {subtitle} {link} {align} {level} spacing="md" />
    {plans.length > 0 && <PricingPlans {plans} {spaced} />}
  </>
)}

{note && <p class:list={['mt-4 type-small text-muted [&_a]:text-primary', comparison && 'mb-[clamp(20px,3vw,32px)]']} set:html={inline(note)} />}

{comparison && plans.length > 0 && (
  <TableElement
    size="lg"
    radius="lg"
    minWidth={640}
    caption={comparison.label}
    columns={[{ label: comparison.label }, ...plans.map((p, i) => ({ label: p.title ?? '', highlight: i === featured }))]}
    rows={comparison.rows.map((row) => ({ cells: [row.feature, ...row.values.map((v) => ({ text: inline(v.text) ?? '', tone: v.tone }))] }))}
  />
)}
</div>
