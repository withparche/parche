---
/**
 * Pricing: the tiers as cards, the recommended one marked, and a comparison
 * table under them with one column per plan. Cards sell, the table closes.
 */
import Card from 'parche:elements/Card';
import { inline } from '../_shared/inline';
import Button from 'parche:elements/Button';
import TableElement from 'parche:elements/Table';
import SectionHeader from '../components/SectionHeader.astro';
import { schema, type Props } from './Pricing.props';

const { title, subtitle, tagline, link, align, items, note, comparison } = schema.parse(Astro.props) as Props;
const plans = items.filter((p) => p.price || p.title);
const featured = plans.findIndex((p) => p.recommended);
---

<!-- One root, so a Section stacks this widget as one block. -->
<div class="parche-pricing">
<SectionHeader {tagline} {title} {subtitle} {link} {align} spacing="md" />

{plans.length > 0 && (
  <div class:list={['grid grid-cols-[repeat(auto-fit,minmax(min(260px,100%),1fr))] gap-[clamp(16px,2vw,24px)]', comparison && !note && 'mb-[clamp(20px,3vw,32px)]']}>
    {plans.map((p) => {
      const numeric = /^[\d.,]/.test(String(p.price ?? ''));
      const shown = p.type === 'custom' ? (p.price || "Let's talk") : `${numeric ? (p.currency ?? '$') : ''}${p.price ?? ''}`;
      return (
        <Card
          as="article"
          variant="canvas"
          radius="lg"
          padding="lg"
          gap="md"
          shadow="none"
          class:list={['relative overflow-visible', p.recommended && 'border-primary shadow-lg']}
        >
          {p.badge && (
            <span class="absolute -top-[11px] left-[var(--ds-comp-card-padding-lg,clamp(1.5rem,2.8vw,2rem))] rounded-full bg-primary px-2.5 py-1.5 type-label text-on-primary">{p.badge}</span>
          )}
          <div>
            {p.title && <h3 class="mb-3 text-base leading-none font-semibold text-heading">{p.title}</h3>}
            <p class="type-figure text-heading">
              {shown}{(p.suffix || p.period) && <span class="font-body text-[15px] font-normal tracking-normal text-muted"> {p.suffix ?? p.period}</span>}
            </p>
            {(p.note || p.subtitle) && <p class:list={['mt-2 type-small', p.noteTone === 'success' ? 'text-success' : 'text-muted']} set:html={inline(p.note ?? p.subtitle)} />}
            {p.description && <p class="mt-2 type-small text-muted" set:html={inline(p.description)} />}
          </div>
          {p.features.length > 0 && (
            <ul class="flex flex-col gap-[9px] border-t border-border-soft pt-[18px] text-sm leading-[1.5] text-heading">
              {p.features.map((f) => <li set:html={inline(f)} />)}
            </ul>
          )}
          {p.actions.length > 0 && (
            <div class="mt-auto flex flex-col gap-2">
              {p.actions.map((a) => a.text && (
                <Button href={a.href} target={a.target} variant={a.variant === 'tertiary' ? 'secondary' : (a.variant ?? (p.recommended ? 'primary' : 'secondary'))} block class="p-3 text-[15px] leading-none">{a.text}</Button>
              ))}
            </div>
          )}
        </Card>
      );
    })}
  </div>
)}

{note && <p class:list={['mt-4 type-small text-muted [&_a]:text-primary', comparison && 'mb-[clamp(20px,3vw,32px)]']} set:html={inline(note)} />}

{comparison && plans.length > 0 && (
  <TableElement
    size="lg"
    radius="lg"
    minWidth={640}
    caption={comparison.label}
    columns={[{ label: comparison.label }, ...plans.map((p, i) => ({ label: p.title ?? '', highlight: i === featured }))]}
    rows={comparison.rows.map((row) => ({ cells: [row.feature, ...row.values.map((v) => ({ text: inline(v.text) ?? '', tone: v.tone }))] }))}
  />
)}
</div>
