---
/**
 * Pricing: the tiers as cards, the recommended one marked, and a comparison
 * table under them with one column per plan. Cards sell, the table closes.
 */
import Button from 'parche:elements/Button';
import SectionHeader from '../components/SectionHeader.astro';
import { schema, type Props } from './Pricing.props';

const { title, subtitle, tagline, prices, align, comparison } = schema.parse(Astro.props) as Props;
const plans = prices.filter((p) => p.price || p.title);
const featured = plans.findIndex((p) => p.hasRibbon);
const tone = { default: 'font-semibold text-heading', muted: 'text-muted', success: 'font-semibold text-success' } as const;
---

<SectionHeader {tagline} {title} {subtitle} align={align} spacing="md" />

{plans.length > 0 && (
  <div class:list={['grid grid-cols-[repeat(auto-fit,minmax(min(260px,100%),1fr))] gap-[clamp(16px,2vw,24px)]', comparison && 'mb-[clamp(20px,3vw,32px)]']}>
    {plans.map((p) => {
      const numeric = /^[\d.,]/.test(String(p.price ?? ''));
      const shown = p.type === 'custom' ? (p.price || "Let's talk") : `${numeric ? (p.currency ?? '$') : ''}${p.price ?? ''}`;
      return (
        <article
          class:list={[
            'relative flex flex-col gap-[18px] rounded-lg border bg-background p-[clamp(22px,2.5vw,30px)]',
            p.hasRibbon ? 'border-primary shadow-lg' : 'border-border',
          ]}
        >
          {p.hasRibbon && p.ribbonTitle && (
            <span class="absolute -top-[11px] left-[clamp(22px,2.5vw,30px)] rounded-full bg-primary px-2.5 py-1.5 font-mono text-[10px] leading-none font-medium tracking-[0.14em] text-on-primary uppercase">{p.ribbonTitle}</span>
          )}
          <div>
            {p.title && <h3 class="mb-3 text-base leading-none font-semibold text-heading">{p.title}</h3>}
            <p class="font-heading text-[40px] leading-none font-semibold tracking-[-0.03em] text-heading">
              {shown}{(p.suffix || p.period) && <span class="font-body text-[15px] font-normal tracking-normal text-muted"> {p.suffix ?? p.period}</span>}
            </p>
            {(p.note || p.subtitle) && <p class="mt-2 text-[13px] leading-[1.5] text-muted">{p.note ?? p.subtitle}</p>}
            {p.description && <p class="mt-2 text-[13px] leading-[1.5] text-muted">{p.description}</p>}
          </div>
          {p.items.length > 0 && (
            <ul class="flex flex-col gap-[9px] text-sm leading-[1.5] text-heading">
              {p.items.map((it) => (it.description || it.title) && <li>{it.description ?? it.title}</li>)}
            </ul>
          )}
          {p.callToAction?.href && p.callToAction?.text && (
            <Button href={p.callToAction.href} variant={p.hasRibbon ? 'primary' : 'secondary'} block class="mt-auto p-3 text-[15px] leading-none">{p.callToAction.text}</Button>
          )}
        </article>
      );
    })}
  </div>
)}

{comparison && plans.length > 0 && (
  <div class="overflow-auto rounded-lg border border-border bg-background">
    <table class="w-full min-w-[640px] border-collapse">
      <thead>
        <tr>
          <th scope="col" class="border-b border-border px-5 py-[15px] text-left font-mono text-[10px] leading-none font-medium tracking-[0.14em] text-muted uppercase">{comparison.label}</th>
          {plans.map((p, i) => (
            <th scope="col" class:list={['border-b border-border px-5 py-[15px] text-left text-sm leading-none font-semibold text-heading', i === featured && 'bg-primary-soft']}>{p.title}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {comparison.rows.map((row, r) => (
          <tr>
            <th scope="row" class:list={['px-5 py-3.5 text-left text-sm leading-[1.4] font-medium text-heading', r < comparison.rows.length - 1 && 'border-b border-border-soft']}>{row.feature}</th>
            {row.values.map((v) => (
              <td class:list={['px-5 py-3.5 text-sm leading-[1.4]', tone[v.tone], r < comparison.rows.length - 1 && 'border-b border-border-soft']}>{v.text}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
