---
import Heading from 'parche:elements/Heading';
import Icon from 'parche:elements/Icon';
import Card from 'parche:elements/Card';
import Button from 'parche:elements/Button';
import type { Props } from './Pricing.props';

const { title, subtitle, tagline, prices = [] } = Astro.props;
---

<Heading {title} {subtitle} {tagline} />

{prices.length > 0 && (
  <div class="flex items-stretch justify-center">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {prices.map(({ title, subtitle, description, price, period, currency = '$', type = 'standard', items = [], callToAction, hasRibbon = false, ribbonTitle }) => (
        (price || title) && (
          <Card as="article" padding="lg" class="relative mx-auto w-full max-w-sm overflow-visible rounded-lg text-center">
            {hasRibbon && ribbonTitle && (
              <div class="absolute right-[-5px] top-[-5px] z-[1] h-[100px] w-[100px] overflow-hidden text-right">
                <span class="absolute right-[-21px] top-[19px] block w-full rotate-45 bg-primary px-0 py-1 text-center text-[10px] font-bold uppercase leading-5 text-on-primary shadow-[0_3px_10px_-5px_rgba(0,0,0,0.3)]">
                  {ribbonTitle}
                </span>
              </div>
            )}

            <div class="px-2 py-0">
              {title && (
                <h3 class="type-label mb-2 text-center uppercase tracking-wider text-heading">
                  {title}
                </h3>
              )}
              {subtitle && (
                <p class="type-body text-muted">{subtitle}</p>
              )}

              {type === 'custom' ? (
                <div class="my-8">
                  <div class="text-3xl font-bold text-heading">{price || "Let's talk"}</div>
                  {description && (
                    <p class="type-body mx-auto mt-3 max-w-[16rem] text-muted">{description}</p>
                  )}
                </div>
              ) : (
                <div class="my-8">
                  <div class="mb-1 flex items-baseline justify-center text-center">
                    {/^[\d.,]/.test(String(price ?? '')) && (
                      <span class="text-5xl text-heading">{currency}</span>
                    )}
                    <span class="text-6xl font-extrabold text-heading">{price}</span>
                  </div>
                  {period && <span class="type-body lowercase text-muted">{period}</span>}
                </div>
              )}

              {items.length > 0 && (
                <ul class="my-8 space-y-2 text-left md:my-10">
                  {items.map(({ description, icon }) =>
                    description && (
                      <li class="mb-1.5 flex items-start space-x-3 leading-7">
                        <div class="mt-1 flex-shrink-0 rounded-full bg-primary p-1 text-on-primary">
                          <Icon name={icon ?? 'tabler:check'} size="xs" />
                        </div>
                        <span class="type-body text-heading">{description}</span>
                      </li>
                    )
                  )}
                </ul>
              )}
            </div>

            {callToAction?.href && callToAction?.text && (
              <div class="flex justify-center">
                <Button variant={hasRibbon ? 'primary' : 'secondary'} size="lg" href={callToAction.href} class="rounded-lg">{callToAction.text}</Button>
              </div>
            )}
          </Card>
        )
      ))}
    </div>
  </div>
)}
