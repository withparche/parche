---
/**
 * The one hero. `layout` picks the structure; the `media` slot takes whatever
 * sits beside or below the copy (the `image` prop is the fallback), stacked
 * when there are several pieces, and the `proof` slot takes what backs the
 * claim, under the actions. The measure, the gutter and the rhythm come from
 * the conf tokens, so a theme sets the page grid the hero sits on.
 */
import { inline } from '../_shared/inline';
import Image from 'parche:elements/Image';
import Action from '../components/Action.astro';
import { schema, type Props } from './Hero.props';

const { layout, align, size, badge, title, subtitle, tagline, content, points, valign, actions, note, proofFirst, image } = schema.parse(Astro.props) as Props;
const hasMedia = Astro.slots.has('media') || Boolean(image);
const side = layout === 'side';
const overlay = layout === 'overlay';
const showMedia = layout !== 'text' && !side && hasMedia;
const split = layout === 'split' && showMedia;
const centered = !split && !side && align === 'center';
const titleClass = size === 'md'
  ? 'font-heading text-[clamp(2.25rem,4.6vw,3.25rem)] leading-[1.05] font-semibold tracking-(--ds-sys-type-h1-tracking) text-heading'
  : 'type-h1';
const Badge = badge?.href ? 'a' : 'span';
---

<!-- Owns its measure and padding: it is never wrapped as a page root. -->
<div
  class="parche-hero mx-auto w-full max-w-(--ds-conf-width-xl) px-(--ds-conf-gutter) pt-[calc(var(--ds-conf-spacing-md)*0.75)] pb-[calc(var(--ds-conf-spacing-md)*0.39)]"
  data-layout={layout}
>
  {overlay ? (
    <div class="relative">
      <div class="parche-hero-media overflow-hidden rounded-lg">
        <slot name="media">
          {image && <Image src={image.src} alt={image.alt} width={1600} ratio="16/9" loading="eager" class="block w-full" />}
        </slot>
      </div>
      <div class="mt-4 md:absolute md:bottom-[clamp(20px,4vw,48px)] md:left-[clamp(20px,4vw,48px)] md:mt-0 md:max-w-[460px]">
        <div class="parche-hero-copy rounded-lg border border-border bg-surface p-[clamp(22px,3vw,32px)] shadow-lg">
          {tagline && <p class="type-label uppercase text-primary mb-2" set:html={inline(tagline)} />}
          {title && <h1 class="mb-3 font-heading text-[clamp(1.75rem,3vw,2.25rem)] leading-[1.1] font-semibold tracking-(--ds-sys-type-h1-tracking) text-balance text-heading" set:html={inline(title)} />}
          {subtitle && <p class="mb-5 text-[15px] leading-[1.6] text-pretty text-muted" set:html={inline(subtitle)} />}
          {proofFirst && Astro.slots.has('proof') && <div class="parche-hero-proof mb-5 flex flex-col gap-3"><slot name="proof" /></div>}
          {actions.length > 0 && <div class="grid grid-cols-[repeat(auto-fit,minmax(140px,1fr))] gap-2.5">{actions.map((a) => <Action action={a} size="md" class="w-full" />)}</div>}
          {note && <p class="mt-3 text-xs leading-[1.5] text-muted" set:html={inline(note)} />}
          {!proofFirst && Astro.slots.has('proof') && <div class="parche-hero-proof mt-4 flex flex-col gap-3"><slot name="proof" /></div>}
        </div>
      </div>
    </div>
  ) : (
  <div
    class:list={[
      'grid gap-[clamp(28px,4vw,56px)]', valign === 'start' ? 'items-start' : 'items-center',
      split || side ? 'grid-cols-[repeat(auto-fit,minmax(min(320px,100%),1fr))]' : 'grid-cols-1',
      side && 'items-end',
    ]}
  >
    <div class:list={['parche-hero-copy min-w-0', centered ? 'mx-auto max-w-5xl text-center' : !split && !side && 'max-w-[46rem]']}>
      {badge && (
        <Badge
          href={badge.href}
          class="mb-6 inline-flex items-center gap-[9px] rounded-full border border-border bg-surface py-[5px] pr-[5px] pl-3 no-underline"
          data-part="badge"
        >
          <span class="font-mono text-[11px] leading-none font-medium tracking-[0.1em] text-muted uppercase">{badge.text}</span>
          {badge.tag && <span class="rounded-full bg-primary-soft px-[9px] py-[5px] font-mono text-[11px] leading-none font-medium text-primary">{badge.tag}</span>}
        </Badge>
      )}
      {tagline && !badge && <p class="type-label uppercase text-primary mb-2" set:html={inline(tagline)} />}
      {title && <h1 class:list={[titleClass, 'text-balance', side ? 'mb-0' : 'mb-5']} set:html={inline(title)} />}
      {!side && subtitle && <p class:list={['type-lead mb-[30px] max-w-[36em] text-pretty', centered && 'mx-auto']} set:html={inline(subtitle)} />}
      {!side && points.length > 0 && (
        <ul class:list={['mb-7 flex flex-col gap-[11px] text-[15px] leading-[1.5] text-heading', centered && 'mx-auto w-fit text-left']}>
          {points.map((p) => <li class="flex gap-2.5"><span class="font-mono text-success" aria-hidden="true">✓</span><span set:html={inline(p)} /></li>)}
        </ul>
      )}
      {!side && content && <div class="text-muted mb-6 [&_pre]:max-w-full [&_pre]:overflow-x-auto [&_pre]:text-sm" set:html={content} />}
      {!side && proofFirst && Astro.slots.has('proof') && (
        <div class:list={['parche-hero-proof mb-[26px] flex flex-col gap-3', centered && 'items-center']}>
          <slot name="proof" />
        </div>
      )}
      {!side && actions.length > 0 && (
        <div class:list={['flex flex-wrap gap-3', centered && 'justify-center']}>
          {actions.map((a) => <Action action={a} />)}
        </div>
      )}
      {!side && note && <p class:list={['mt-3.5 text-[13px] leading-[1.5] text-muted', centered && 'text-center']} set:html={inline(note)} />}
      {!side && !proofFirst && Astro.slots.has('proof') && (
        <div class:list={['parche-hero-proof mt-[26px] flex flex-col gap-3', centered && 'items-center']}>
          <slot name="proof" />
        </div>
      )}
    </div>
    {side && (subtitle || actions.length > 0) && (
      <div class="parche-hero-aside min-w-0">
        {subtitle && <p class="type-lead mb-5 max-w-[36em] text-pretty" set:html={inline(subtitle)} />}
        {proofFirst && Astro.slots.has('proof') && <div class="parche-hero-proof mb-5 flex flex-col gap-3"><slot name="proof" /></div>}
        {actions.length > 0 && <div class="flex flex-wrap gap-3">{actions.map((a) => <Action action={a} />)}</div>}
        {note && <p class="mt-3.5 text-[13px] leading-[1.5] text-muted" set:html={inline(note)} />}
        {!proofFirst && Astro.slots.has('proof') && <div class="parche-hero-proof mt-5 flex flex-col gap-3"><slot name="proof" /></div>}
      </div>
    )}
    {showMedia && (
      <div class:list={['parche-hero-media flex min-w-0 flex-col gap-3', !split && (centered ? 'relative mx-auto w-full max-w-5xl' : 'relative w-full')]}>
        <slot name="media">
          {image && (
            <Image
              src={image.src}
              alt={image.alt}
              width={split ? 600 : 1024}
              ratio={split ? undefined : '16/9'}
              loading="eager"
              class:list={['rounded-md', split && 'mx-auto max-w-[600px]']}
            />
          )}
        </slot>
      </div>
    )}
  </div>
  )}
</div>
