---
import Heading from 'parche:elements/Heading';
import Image from 'parche:elements/Image';
import Action from '../components/Action.astro';
import type { Props } from './Hero.props';

const {
  title,
  subtitle,
  tagline,
  content,
  actions = [],
  image,
} = Astro.props;
---

<!-- Full-bleed widgets skip SectionWrapper, so the horizontal container is
     theirs to supply. Vertical padding alone left the copy flush against the
     viewport edge on every template in the repo. -->
<div class="mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-20">
  <div class="text-center pb-10 md:pb-16 max-w-5xl mx-auto">
    <Heading level={1} {tagline} {title} {subtitle} width="lg" spacing={false} class="mb-8" />
    <div class="max-w-3xl mx-auto">
      {actions.length > 0 && (
        <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4">
          {actions.map((action) => (
            <Action action={action} class="w-full sm:w-auto" />
          ))}
        </div>
      )}
    </div>
    {content && <div class="mt-6" set:html={content} />}
  </div>
  {image && (
    <div class="relative m-auto max-w-5xl">
      <Image
        src={typeof image === 'string' ? image : image.src}
        alt={typeof image === 'string' ? '' : (image.alt || '')}
        width={1024}
        ratio="16/9"
        loading="eager"
        class="rounded-md"
      />
    </div>
  )}
</div>
