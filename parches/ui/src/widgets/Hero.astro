---
import LegacyHeadline from '../components/LegacyHeadline.astro';
import Action from '../components/Action.astro';
import type { Props } from './Hero.props';

const {
  title,
  subtitle,
  tagline,
  content,
  actions = [],
  image,
} = Astro.props;
---

<div class="py-12 md:py-20">
  <div class="text-center pb-10 md:pb-16 max-w-5xl mx-auto">
    {tagline && (
      <p class="type-label uppercase text-primary mb-2" set:html={tagline} />
    )}
    {title && (
      <div class="max-w-4xl mx-auto">
        <h1 class="type-h1 mb-6" set:html={title} />
      </div>
    )}
    <div class="max-w-3xl mx-auto">
      {subtitle && (
        <p class="type-body text-xl text-muted mb-8" set:html={subtitle} />
      )}
      {actions.length > 0 && (
        <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4">
          {actions.map((action) => (
            <Action action={action} class="w-full sm:w-auto" />
          ))}
        </div>
      )}
    </div>
    {content && <div class="mt-6" set:html={content} />}
  </div>
  {image && (
    <div class="relative m-auto max-w-5xl">
      <img
        src={typeof image === 'string' ? image : image.src}
        alt={typeof image === 'string' ? '' : (image.alt || '')}
        class="mx-auto rounded-md w-full"
        loading="eager"
      />
    </div>
  )}
</div>
