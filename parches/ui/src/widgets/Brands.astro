---
import { schema, type Props } from './Brands.props';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from 'parche:elements/Icon';
import Card from 'parche:elements/Card';
import Image from 'parche:elements/Image';
import * as Carousel from 'parche:elements/Carousel';

const { tagline, title, subtitle, link, align, icons, images, names, label, note, layout } = schema.parse(Astro.props) as Props;
const named = names.map((n) => (typeof n === 'string' ? { name: n } : n));

const brands = [
  ...icons.map((icon) => ({ icon })),
  ...images.map((image) => ({ image })),
];
---

<!-- One root, so a Section stacks this widget as one block. -->
<div class="parche-brands">
{layout !== 'strip' && <SectionHeader {tagline} {title} {subtitle} {link} {align} spacing="xl" />}

{layout === 'strip' ? (
  <div class="parche-brands-strip flex flex-wrap items-center gap-[clamp(18px,3vw,44px)] py-5" data-layout="strip">
    {label && <span class="type-label text-muted">{label}</span>}
    <ul class="flex flex-1 flex-wrap items-center gap-[clamp(16px,3vw,40px)]" aria-label={label ?? title ?? 'Brands'}>
      {named.map((n) => (
        <li class="flex flex-col gap-1.5">
          {n.href ? <a href={n.href} class="font-heading text-[17px] leading-none font-semibold tracking-[-0.01em] text-muted no-underline hover:text-heading">{n.name}</a> : <span class="font-heading text-[17px] leading-none font-semibold tracking-[-0.01em] text-muted">{n.name}</span>}
          {n.note && <span class="font-mono text-[11px] leading-[1.3] text-muted">{n.note}</span>}
        </li>
      ))}
      {icons.map((icon) => <li><Icon name={icon} class="h-6 w-auto text-muted" /></li>)}
      {images.map((img) => <li><Image src={img.src} alt={img.alt} width={120} height={32} class="max-h-8" /></li>)}
    </ul>
    {note && <span class="text-[13px] leading-[1.4] text-muted">{note}</span>}
    {link && <a href={link.href} class="text-[13px] leading-none font-medium text-primary no-underline hover:text-heading">{link.text} →</a>}
  </div>
) : layout === 'carousel' && brands.length > 0 ? (
  <Carousel.Root count={brands.length} label={title ?? 'Brands'} perView={4} dots={false}>
    {brands.map((brand, i) => (
      <Carousel.Slide index={i} total={brands.length} class="flex items-center justify-center py-3">
        {'icon' in brand ? (
          <Icon name={brand.icon} class="w-12 h-auto text-muted" />
        ) : (
          <Image src={brand.image.src} alt={brand.image.alt} width={120} height={48} class="max-h-12" />
        )}
      </Carousel.Slide>
    ))}
  </Carousel.Root>
) : (
  <div class="flex flex-wrap justify-center gap-x-6 sm:gap-x-12 lg:gap-x-24">
    {icons.map((icon) => (
      <Icon name={icon} class="py-3 lg:py-5 w-12 h-auto mx-auto sm:mx-0 text-muted" />
    ))}
    {images.map((image) =>
      image.src && (
        <Card padding="none" shadow="none" class="my-2 lg:my-4 justify-center px-3 py-1">
          <Image src={image.src} alt={image.alt ?? ''} width={120} height={48} class="max-h-12" />
        </Card>
      )
    )}
  </div>
)}
</div>
