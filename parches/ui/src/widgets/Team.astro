---
import Image from 'parche:elements/Image';
import Placeholder from 'parche:elements/Placeholder';
import SectionHeader from '../components/SectionHeader.astro';
import { schema, type Props } from './Team.props';

const { tagline, title, subtitle, link, align, items, more, layout } = schema.parse(Astro.props) as Props;
const split = layout === 'split';
---

<div class:list={['parche-team', split && 'grid grid-cols-[repeat(auto-fit,minmax(min(290px,100%),1fr))] gap-[clamp(32px,5vw,72px)]']} data-layout={layout}>
  <div class="min-w-0">
    <SectionHeader {tagline} {title} {subtitle} {link} {align} spacing={split ? 'none' : 'md'} width="lg" />
  </div>
  <ul class="grid min-w-0 grid-cols-[repeat(auto-fill,minmax(min(150px,100%),1fr))] gap-[clamp(16px,2vw,22px)]">
    {items.map((m) => (
      <li>
        {m.image ? (
          <Image src={m.image.src} alt={m.image.alt || m.name} width={300} ratio="1/1" class="mb-3 block w-full rounded-md border border-border" />
        ) : (
          <Placeholder label={m.name} ratio="1/1" stripe={9} class="mb-3 rounded-md border border-border" />
        )}
        <p class="text-[15px] leading-[1.3] font-semibold text-heading">
          {m.href ? <a href={m.href} class="text-inherit no-underline hover:text-primary">{m.name}</a> : m.name}
        </p>
        <p class="mt-1 text-[13px] leading-[1.4] text-muted">{m.role}</p>
      </li>
    ))}
    {more && (
      <li>
        <div class="mb-3 flex aspect-square items-center justify-center rounded-md border border-border bg-background font-mono text-[13px] leading-none font-medium text-muted">{more.count}</div>
        <p class="text-[15px] leading-[1.3] font-semibold text-heading">{more.label}</p>
        {more.note && <p class="mt-1 text-[13px] leading-[1.4] text-muted">{more.note}</p>}
      </li>
    )}
  </ul>
</div>
