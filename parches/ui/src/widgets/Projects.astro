---
/**
 * Projects gallery — the portfolio centerpiece. A grid of cards: thumbnail,
 * title + date, description, tag chips and links (Website / Source / Case study).
 * Rendered in the single narrow column (resume style).
 */
import Container from 'parche:elements/Container';
import SectionHeader from '../components/SectionHeader.astro';
import Card from 'parche:elements/Card';
import Image from 'parche:elements/Image';
import Tag from 'parche:elements/Tag';
import Action from '../components/Action.astro';
import { schema, type Props } from './Projects.props';

const { tagline, title, subtitle, link, align, columns, items } = schema.parse(Astro.props) as Props;
const colClass = columns === '3' ? 'sm:grid-cols-3' : 'sm:grid-cols-2';
const containerClass = (Astro.props as { classes?: Record<string, string> }).classes?.container;
---

<Container width="sm" padding={false} class={containerClass}>
  <SectionHeader {tagline} {title} {subtitle} {link} {align} width="sm" spacing="none" />

  {items.length > 0 && (
    <div class:list={['mt-10 grid gap-4', colClass]}>
      {items.map((p) => (
        <Card as="article" padding="sm" shadow="none" interactive class="rounded-xl">
          {p.image?.src && (
            <Image slot="media" src={p.image.src} alt={p.image.alt ?? p.title ?? ''} width={640} ratio="16/9" class="border-b border-border" />
          )}
          <div class="flex items-baseline justify-between gap-2">
            {p.title && <h3 class="text-lg font-bold text-heading">{p.title}</h3>}
            {p.date && <p class="shrink-0 text-xs text-muted">{p.date}</p>}
          </div>
          {p.description && <p class="mt-1.5 text-muted leading-relaxed">{p.description}</p>}

          {p.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {p.tags.map((t) => <Tag>{t}</Tag>)}
            </div>
          )}

          {p.actions.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {p.actions.map((a) => a.href && <Action action={a} size="sm" />)}
            </div>
          )}
        </Card>
      ))}
    </div>
  )}
</Container>
