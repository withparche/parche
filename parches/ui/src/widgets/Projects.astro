---
/**
 * Projects gallery — the portfolio centerpiece. A grid of cards: thumbnail,
 * title + date, description, tag chips and links (Website / Source / Case study).
 * Rendered in the single narrow column (resume style).
 */
import { twMerge } from 'tailwind-merge';
import Icon from 'parche:primitives/Icon';
import type { Props } from './Projects.props';

const { tagline, title, subtitle, columns = '2', projects = [] } = Astro.props as Props;
const colClass = columns === '3' ? 'sm:grid-cols-3' : 'sm:grid-cols-2';
const containerClass = (Astro.props as { classes?: Record<string, string> }).classes?.container;
---

<div class={twMerge('mx-auto max-w-3xl', containerClass)}>
  <div class="mx-auto max-w-xl text-center">
    {tagline && <span class="inline-block rounded-lg bg-primary px-3 py-1 text-sm font-medium text-on-primary">{tagline}</span>}
    {title && <h2 class="mt-4 text-3xl font-bold tracking-tight text-heading sm:text-4xl">{title}</h2>}
    {subtitle && <p class="mt-3 text-lg text-muted">{subtitle}</p>}
  </div>

  {projects.length > 0 && (
    <div class:list={['mt-10 grid gap-4', colClass]}>
      {projects.map((p) => (
        <div class="flex flex-col overflow-hidden rounded-xl border border-border bg-surface transition-shadow hover:shadow-md">
          {p.image?.src && (
            <div class="overflow-hidden border-b border-border">
              <img
                src={p.image.src}
                alt={p.image.alt ?? p.title ?? ''}
                class="aspect-video w-full object-cover object-top transition-transform duration-500 ease-out hover:scale-[1.03]"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="flex flex-1 flex-col p-5">
            <div class="flex items-baseline justify-between gap-2">
              {p.title && <h3 class="text-lg font-bold text-heading">{p.title}</h3>}
              {p.date && <p class="shrink-0 text-xs text-muted">{p.date}</p>}
            </div>
            {p.description && <p class="mt-1.5 text-muted leading-relaxed">{p.description}</p>}

            {p.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {p.tags.map((t) => (
                  <span class="rounded-md bg-muted/10 px-2 py-0.5 text-xs font-medium text-muted">{t}</span>
                ))}
              </div>
            )}

            {p.links.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2 pt-0">
                {p.links.map((l) =>
                  l.href && l.label && (
                    <a
                      href={l.href}
                      class="inline-flex items-center gap-1.5 rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-on-primary transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                    >
                      {l.icon && <Icon name={l.icon} class="h-4 w-4" />}
                      {l.label}
                    </a>
                  )
                )}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  )}
</div>
