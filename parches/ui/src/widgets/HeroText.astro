---
import type { Props } from './HeroText.props';

const {
  title,
  subtitle,
  tagline,
  content,
  callToAction,
  callToAction2,
} = Astro.props;
---

<div class="py-12 md:py-20">
  <div class="text-center max-w-5xl mx-auto">
    {tagline && (
      <p class="type-label uppercase text-primary mb-2" set:html={tagline} />
    )}
    {title && (
      <h1 class="type-h1 md:text-6xl mb-4" set:html={title} />
    )}
    {subtitle && (
      <p class="type-body text-xl text-muted mb-6 max-w-3xl mx-auto" set:html={subtitle} />
    )}
    {content && <div class="text-muted mb-8" set:html={content} />}
    {(callToAction?.text || callToAction2?.text) && (
      <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4">
        {callToAction?.text && (
          <a
            href={callToAction.href}
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full font-semibold bg-primary text-on-primary hover:opacity-90 w-full sm:w-auto"
          >
            {callToAction.text}
          </a>
        )}
        {callToAction2?.text && (
          <a
            href={callToAction2.href}
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full font-semibold bg-surface border border-border text-heading hover:bg-muted/10 w-full sm:w-auto"
          >
            {callToAction2.text}
          </a>
        )}
      </div>
    )}
  </div>
</div>
