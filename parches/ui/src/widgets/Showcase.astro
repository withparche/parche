---
/**
 * The demo switcher. The Tabs element takes the heading into its header row,
 * so the segmented control sits at its right; each panel is one demo. Astro
 * cannot take a slot name from a loop variable, so up to six demos are
 * forwarded by position.
 */
import Tabs from 'parche:elements/Tabs';
import SectionHeader from '../components/SectionHeader.astro';
import ShowcasePanel from '../components/ShowcasePanel.astro';
import { schema, type Props } from './Showcase.props';

const { tagline, title, subtitle, link, align, items: demos, syncKey, label } = schema.parse(Astro.props) as Props;
const items = demos.map((d) => ({ value: d.value, label: d.label }));
const name = (i: number) => demos[i]?.value ?? `__none-${i}`;
---

<Tabs items={items} variant="pill" syncKey={syncKey} label={label} class="parche-showcase">
  <SectionHeader slot="header" {tagline} {title} {subtitle} {link} {align} width="sm" spacing="none" />
  <ShowcasePanel slot={name(0)} demo={demos[0]} />
  <ShowcasePanel slot={name(1)} demo={demos[1]} />
  <ShowcasePanel slot={name(2)} demo={demos[2]} />
  <ShowcasePanel slot={name(3)} demo={demos[3]} />
  <ShowcasePanel slot={name(4)} demo={demos[4]} />
  <ShowcasePanel slot={name(5)} demo={demos[5]} />
</Tabs>
