---
/**
 * A row of skill pills. Full-bleed section (wrapper handles it); content in a
 * narrower container, overridable via `classes.container`.
 */
import { twMerge } from 'tailwind-merge';

interface Props {
  tagline?: string;
  title?: string;
  skills?: string[];
  classes?: Record<string, string>;
}

const { tagline, title, skills = [], classes = {} } = Astro.props as Props;
---

<div class={twMerge('mx-auto max-w-3xl', classes.container)}>
  {tagline && <p class="mb-1.5 text-base font-medium text-primary">{tagline}</p>}
  {title && <h2 class="text-2xl font-bold text-heading">{title}</h2>}
  {skills.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {skills.map((s) => (
        <span class="rounded-md bg-primary px-3 py-1 text-sm font-medium text-on-primary">{s}</span>
      ))}
    </div>
  )}
</div>
