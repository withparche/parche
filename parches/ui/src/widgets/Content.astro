---
import type { Props } from './Content.props';
import LegacyHeadline from '../components/LegacyHeadline.astro';
import Icon from 'parche:primitives/Icon';

const {
  tagline,
  title,
  subtitle,
  content,
  image,
  items = [],
  columns = '1',
  isReversed = false,
  isAfterContent = false,
  callToAction,
} = Astro.props;

const colClass =
  columns === '2' ? 'grid-cols-2' : columns === '3' ? 'grid-cols-3' : 'grid-cols-1';
---

<div class={isAfterContent ? 'pt-0 md:pt-0 lg:pt-0' : ''}>
  <LegacyHeadline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      container: 'max-w-xl sm:mx-auto lg:max-w-2xl',
      title: 'text-4xl md:text-5xl',
    }}
  />

  <div class="mx-auto max-w-7xl p-4 md:px-8">
    <div class={`md:flex ${isReversed ? 'md:flex-row-reverse' : ''} md:gap-16`}>
      <!-- Text / items column. Full width when there's no image, so items fill
           the space (a balanced grid) instead of leaving an empty right half. -->
      <div class:list={['self-center', image ? 'md:basis-1/2' : 'w-full']}>
        {content && (
          <div class="mb-12 text-lg text-muted" set:html={content} />
        )}

        {callToAction?.href && (
          <div class="mb-8 text-primary">
            <a
              href={callToAction.href}
              class="inline-flex items-center gap-1 text-primary hover:underline"
            >
              {callToAction.icon && <Icon name={callToAction.icon} class="w-4 h-4" />}
              {callToAction.text}
            </a>
          </div>
        )}

        {items.length > 0 && (
          <ul class={`grid ${colClass} gap-y-4 md:gap-y-8 gap-x-8`}>
            {items.map((item) => (
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 flex h-7 w-7 items-center justify-center rounded-full bg-green-600 dark:bg-green-700 text-gray-50 p-1">
                  {item.icon
                    ? <Icon name={item.icon} class="w-4 h-4" />
                    : <Icon name="tabler:check" class="w-4 h-4" />
                  }
                </span>
                <div>
                  {item.title && (
                    <p class="text-lg font-medium leading-6 text-heading ml-2">{item.title}</p>
                  )}
                  {item.description && (
                    <p class="text-muted ml-2 mt-3">{item.description}</p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- Image column -->
      {image && (
        <div class="mt-10 md:mt-0 md:basis-1/2" aria-hidden="true">
          <div class="relative m-auto max-w-4xl">
            {typeof image === 'string' ? (
              <Fragment set:html={image} />
            ) : (
              <img
                src={image.src}
                alt={image.alt ?? ''}
                class="mx-auto w-full rounded-lg bg-gray-500 shadow-lg aspect-square object-cover"
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
        </div>
      )}
    </div>
  </div>
</div>
