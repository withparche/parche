---
/**
 * Text and a checklist beside a media area: the `media` slot, or the `image`
 * prop when the slot is empty. With neither, the text takes the full width.
 */
import Heading from 'parche:elements/Heading';
import Icon from 'parche:elements/Icon';
import Image from 'parche:elements/Image';
import Action from '../components/Action.astro';
import { schema, type Props } from './Content.props';

const { tagline, title, subtitle, content, image, items, columns, reversed, callToAction } = schema.parse(Astro.props) as Props;
const hasMedia = Astro.slots.has('media') || Boolean(image);
const colClass = columns === '2' ? 'grid-cols-2' : columns === '3' ? 'grid-cols-3' : 'grid-cols-1';
---

<div class="parche-content">
  <Heading {title} {subtitle} {tagline} width="sm" />

  <div class:list={['md:flex md:gap-16', reversed && 'md:flex-row-reverse']}>
    <div class:list={['self-center min-w-0', hasMedia ? 'md:basis-1/2' : 'w-full']}>
      {content && <div class="mb-12 text-lg text-muted [&_pre]:max-w-full [&_pre]:overflow-x-auto [&_pre]:text-sm" set:html={content} />}

      {callToAction?.text && (
        <div class="mb-8">
          <Action action={{ variant: 'link', ...callToAction }} />
        </div>
      )}

      {items.length > 0 && (
        <ul class:list={['grid gap-y-4 md:gap-y-8 gap-x-8', colClass]}>
          {items.map((item) => (
            <li class="flex items-start gap-3">
              <span class="shrink-0 flex h-7 w-7 items-center justify-center rounded-full bg-success text-on-success p-1">
                <Icon name={item.icon ?? 'tabler:check'} class="w-4 h-4" />
              </span>
              <div>
                {item.title && <p class="text-lg font-medium leading-6 text-heading ml-2">{item.title}</p>}
                {item.description && <p class="text-muted ml-2 mt-3" set:html={item.description} />}
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>

    {hasMedia && (
      <div class="parche-content-media mt-10 md:mt-0 md:basis-1/2">
        <div class="relative m-auto max-w-4xl">
          <slot name="media">
            {image && <Image src={image.src} alt={image.alt} width={640} ratio="1/1" class="mx-auto rounded-lg shadow-lg" />}
          </slot>
        </div>
      </div>
    )}
  </div>
</div>
