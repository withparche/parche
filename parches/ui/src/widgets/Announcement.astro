---
import type { Props } from './Announcement.props';
import Icon from 'parche:primitives/Icon';

const { badge, title, description, href } = Astro.props as Props;

const text = title || description;
const Tag = href ? 'a' : 'div';
---

<div class="bg-primary text-on-primary px-4 py-2.5 text-sm">
  <Tag
    {...href ? { href } : {}}
    class:list={[
      'mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-2.5 gap-y-1 text-center',
      href && 'group',
    ]}
  >
    {badge && (
      <span class="bg-surface text-heading shrink-0 rounded px-2 py-0.5 text-xs font-semibold uppercase tracking-wide">
        {badge}
      </span>
    )}

    {text && <span class="font-medium">{text}</span>}

    {href && (
      <Icon
        name="tabler:arrow-right"
        class="h-4 w-4 shrink-0 transition-transform group-hover:translate-x-0.5"
      />
    )}
  </Tag>
</div>
