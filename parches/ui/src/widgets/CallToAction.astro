---
import LegacyHeadline from '../components/LegacyHeadline.astro';
import type { Props } from './CallToAction.props';

const { title, subtitle, tagline, actions = [] } = Astro.props;
---

<div class="max-w-3xl mx-auto text-center p-6 rounded-md shadow-xl bg-surface border border-border">
  <LegacyHeadline
    {title}
    {subtitle}
    {tagline}
    classes={{ container: 'mb-0 md:mb-0', title: 'text-4xl md:text-4xl' }}
  />
  {actions.length > 0 && (
    <div class="flex flex-col sm:flex-row justify-center gap-4 mt-6">
      {actions.map((action) => (
        <a
          href={action.href}
          target={action.target}
          class:list={[
            'inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full font-semibold transition-colors',
            action.variant === 'primary' && 'bg-primary text-on-primary hover:opacity-90',
            action.variant === 'secondary' && 'bg-surface border border-border text-heading hover:bg-muted/10',
            action.variant === 'link' && 'text-primary hover:underline',
            (!action.variant || action.variant === 'tertiary') && 'bg-surface border border-border text-heading hover:bg-muted/10',
          ]}
        >
          {action.text}
        </a>
      ))}
    </div>
  )}
</div>
