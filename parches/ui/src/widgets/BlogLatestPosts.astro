---
/**
 * Blog latest posts grid — v1 BlogLatestPosts style.
 * Fetches latest blog posts and renders them in a 4-column grid.
 * Used on homepage sections.
 */
import { getCollection } from 'astro:content';
import { resolveAssets } from 'parche:utils/assets';
import { getBlogLinkContext, postHref, postLocale, localizePath } from '../lib/blog-links.js';
import Container from 'parche:elements/Container';
import Section from 'parche:elements/Section';
import Link from 'parche:elements/Link';
import BlogPostCardGrid from 'parche:widgets/blog/BlogPostCardGrid';

interface Props {
  title?: string;
  linkText?: string;
  linkUrl?: string;
  information?: string;
  count?: number;
  id?: string;
  class?: string;
  background?: string;
}

const {
  title = 'Latest Posts',
  linkText = 'View all posts',
  linkUrl,
  information,
  count = 4,
  id,
  class: className = '',
  background,
} = Astro.props;

// Fetch latest posts
let resolvedLinkUrl = linkUrl ?? '/blog';
let posts: Array<{
  title: string;
  description?: string;
  href: string;
  image?: { src: string; alt: string };
}> = [];

try {
  const { postPattern, listing, defaultLocale } = await getBlogLinkContext();
  const locale = Astro.currentLocale ?? defaultLocale;
  resolvedLinkUrl = linkUrl ?? localizePath(listing, locale, defaultLocale);

  const allPosts = await getCollection('posts');
  const sorted = allPosts
    // Only this locale's posts — otherwise a Spanish page lists English posts.
    .filter((p: any) => postLocale(p.id, defaultLocale) === locale)
    .filter((p: any) => !p.data.draft)
    .sort((a: any, b: any) => {
      const dateA = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0;
      const dateB = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0;
      return dateB - dateA;
    })
    .slice(0, count);

  posts = await resolveAssets(sorted.map((post: any) => ({
    title: post.data.title,
    description: post.data.description ?? post.data.excerpt,
    // Honour the configured permalink pattern instead of assuming a root-level slug.
    href: postHref(postPattern, post, locale, defaultLocale),
    image: post.data.image,
  })));
} catch {
  // Blog collection may not exist — widget renders nothing
}
---

{posts.length > 0 && (
  <Section {id} class={className} {background}>
    <Container>
      <div class="flex flex-col lg:justify-between lg:flex-row mb-8">
        {title && (
          <div class="md:max-w-sm">
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl sm:leading-none font-heading text-heading mb-2" set:html={title} />
            {linkText && resolvedLinkUrl && (
              <Link href={resolvedLinkUrl} variant="arrow" class="mb-6 lg:mb-0">{linkText}</Link>
            )}
          </div>
        )}

        {information && (
          <p class="text-muted lg:text-sm lg:max-w-md" set:html={information} />
        )}
      </div>

      <div class="grid gap-6 row-gap-5 md:grid-cols-2 lg:grid-cols-4 -mb-6">
        {posts.map((post) => (
          <BlogPostCardGrid title={post.title} description={post.description} href={post.href} image={post.image} />
        ))}
      </div>
    </Container>
  </Section>
)}
