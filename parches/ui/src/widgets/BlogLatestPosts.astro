---
/**
 * Blog latest posts grid — v1 BlogLatestPosts style.
 * Fetches latest blog posts and renders them in a 4-column grid.
 * Used on homepage sections.
 */
import { entriesOf, memo } from 'parche:utils/entries';
import { resolveAssets } from 'parche:utils/assets';
import { getBlogLinkContext, postHref, postLocale, localizePath } from '../lib/blog-links.js';
import { urlFor } from 'parche:registry/urls';
import SectionHeader from '../components/SectionHeader.astro';
import BlogPostCardGrid from 'parche:widgets/blog/BlogPostCardGrid';
import { schema, type Props } from './BlogLatestPosts.props';

const { tagline, title, subtitle, link, align, count } = schema.parse(Astro.props) as Props;

// Fetch latest posts
let resolvedLinkUrl = (link && link.href) || '/blog';
let posts: Array<{
  title: string;
  description?: string;
  href: string;
  image?: { src: string; alt: string };
}> = [];

try {
  const { postPattern, listing, defaultLocale } = await getBlogLinkContext();
  const locale = Astro.currentLocale ?? defaultLocale;
  resolvedLinkUrl = (link && link.href) || localizePath(listing, locale, defaultLocale);

  // The blog says where its posts are served; the pattern below is only for a site without it.
  const postUrl = await urlFor('posts');
  // This locale's posts, newest first — otherwise a Spanish page lists
  // English posts. Read and sorted once per build or server
  // (parche:utils/entries): a page pays for the posts it shows, not for
  // every post the site has.
  const allPosts = await entriesOf('posts');
  const sorted = memo(`ui:posts:${locale}`, () =>
    allPosts
      .filter((p: any) => postLocale(p.id, defaultLocale) === locale)
      .filter((p: any) => !p.data.draft)
      .sort((a: any, b: any) => {
        const dateA = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0;
        const dateB = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0;
        return dateB - dateA;
      }),
  ).slice(0, count);

  posts = await resolveAssets(sorted.map((post: any) => ({
    title: post.data.title,
    description: post.data.description ?? post.data.excerpt,
    href: postUrl ? postUrl(post) : postHref(postPattern, post, locale, defaultLocale),
    image: post.data.image,
  })));
} catch {
  // Blog collection may not exist — widget renders nothing
}
---

{posts.length > 0 && (
  <div class="parche-blog-posts">
    <SectionHeader {tagline} {title} {subtitle} link={link ? { text: link.text, href: resolvedLinkUrl } : undefined} {align} spacing="lg" />
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {posts.map((post) => (
        <BlogPostCardGrid title={post.title} description={post.description} href={post.href} image={post.image} />
      ))}
    </div>
  </div>
)}
