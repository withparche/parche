---
import Icon from 'parche:elements/Icon';
import Button from 'parche:elements/Button';
import Image from 'parche:elements/Image';
import Sheet from 'parche:elements/Sheet';
import Collapsible from 'parche:elements/Collapsible';
import Menu from 'parche:elements/Menu';
import Popover from 'parche:elements/Popover';
import Banner from 'parche:elements/Banner';
import ThemeToggle from 'parche:components/ThemeToggle';
import LocaleSwitcher from 'parche:components/LocaleSwitcher';

interface NavLink {
  label: string;
  href: string;
  icon?: string;
  description?: string;
}

interface NavGroup {
  title?: string;
  links: NavLink[];
}

interface MegaMenu {
  columns?: number;
  featured?: {
    title: string;
    description?: string;
    image?: string;
    href: string;
  };
  footer?: string;
}

interface HeaderLink {
  label: string;
  href?: string;
  children?: NavGroup[];
  mega?: MegaMenu;
}

interface HeaderAction {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  icon?: string;
}

interface Announcement {
  text: string;
  href?: string;
  icon?: string;
  dismissible?: boolean;
  aside?: string;
  class?: string;
}

type Logo = string | { src?: string; alt?: string; width?: number; height?: number; text?: string };

interface Props {
  links?: HeaderLink[];
  actions?: HeaderAction[];
  logo?: Logo;
  announcement?: Announcement;
  /**
   * Where the desktop navigation sits between the logo and the actions.
   * 'center' (default) keeps it in the middle; 'left' tucks it beside the logo;
   * 'right' pushes it next to the actions — useful on landing pages, where a
   * short menu centred in a wide bar reads as stranded.
   */
  position?: 'left' | 'center' | 'right';
}

const { links = [], actions = [], logo = 'AstroWind', announcement, position = 'center' } = Astro.props;

const navJustify =
  position === 'left' ? 'justify-start' : position === 'right' ? 'justify-end' : 'justify-center';

const homeHref = Astro.currentLocale && Astro.currentLocale !== 'en' ? `/${Astro.currentLocale}` : '/';
// A logo can be a bare string (wordmark), an object with `src` (image), or an
// object with `text` (wordmark). Falls back to a text mark, never a broken img.
const logoSrc = typeof logo === 'object' ? logo.src : undefined;
const logoText = typeof logo === 'string' ? logo : logo.text;

function linkType(link: HeaderLink): 'link' | 'dropdown' | 'mega' {
  if (!link.children?.length) return 'link';
  return link.mega ? 'mega' : 'dropdown';
}

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const navItemClass =
  'inline-flex items-center gap-1 text-[0.938rem] font-medium text-muted hover:text-heading transition-colors no-underline px-3 py-2 rounded-md hover:bg-surface-hover cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring aria-expanded:text-heading';

---

<!-- Skip to content (accessibility) -->
<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-primary focus:text-on-primary focus:rounded-md focus:outline-none">
  Skip to content
</a>

<!-- Announcement bar -->
{announcement && (
  <Banner
    text={announcement.text}
    href={announcement.href}
    icon={announcement.icon}
    aside={announcement.aside}
    dismissible={announcement.dismissible !== false}
    dismissLabel="Dismiss announcement"
    class={announcement.class}
  />
)}

<header
  class="sticky top-0 z-50 w-full bg-background/80 backdrop-blur-lg"
  data-header
  transition:animate="none"
>
  <div id="parche-header-bar" class="mx-auto max-w-6xl flex items-center justify-between px-4 md:px-6 h-[4.75rem]" style="anchor-name: --parche-header-bar">
    <!-- Logo -->
    <a href={homeHref} class="no-underline hover:opacity-80 transition-opacity shrink-0">
      {logoSrc ? (
        <img
          src={logoSrc}
          alt={(typeof logo === 'object' && logo.alt) || logoText || 'Logo'}
          width={typeof logo === 'object' ? logo.width : undefined}
          height={typeof logo === 'object' ? logo.height : undefined}
          class="h-8 w-auto"
        />
      ) : (
        <span class="type-h3 text-heading">{logoText || 'Logo'}</span>
      )}
    </a>

    <!-- Desktop nav -->
    <nav class={`hidden md:flex flex-1 items-center ${navJustify} gap-1`} aria-label="Main navigation">
      {links.map((link) => {
        const type = linkType(link);

        if (type === 'link') {
          return (
            <a
              href={link.href}
              class="text-[0.938rem] font-medium text-muted hover:text-heading transition-colors no-underline px-3 py-2 rounded-md hover:bg-surface-hover"
            >
              {link.label}
            </a>
          );
        }

        const id = `parche-nav-${slug(link.label)}`;
        const groups = (link.children ?? []).map((group) => ({
          title: group.title,
          items: group.links.map((item) => ({ label: item.label, href: item.href, icon: item.icon, description: item.description })),
        }));

        if (type === 'dropdown') {
          // A Menu: the APG menu button on the Popover API, hover-opened on desktop.
          return (
            <Menu id={id} groups={groups} openOnHover class="min-w-56">
              <button slot="trigger" type="button" popovertarget={id} aria-haspopup="menu" aria-expanded="false" class={navItemClass}>
                {link.label}
                <Icon name="tabler:chevron-down" size="xs" class="transition-transform [[aria-expanded=true]>&]:rotate-180" aria-hidden="true" />
              </button>
            </Menu>
          );
        }

        // Mega: a disclosure panel hung from the header bar, full width.
        const megaCols = link.mega?.columns ?? 3;
        return (
          <Popover id={id} anchor="parche-header-bar" placement="bottom" align="center" openOnHover class="w-[min(72rem,calc(100vw-2rem))] max-w-none p-6 text-base">
            <button slot="trigger" type="button" popovertarget={id} aria-expanded="false" class={navItemClass}>
              {link.label}
              <Icon name="tabler:chevron-down" size="xs" class="transition-transform [[aria-expanded=true]>&]:rotate-180" aria-hidden="true" />
            </button>
            <div class="flex gap-8">
              {/* Link columns */}
              <div class:list={[
                'flex-1 grid gap-x-8 gap-y-6',
                megaCols === 1 && 'grid-cols-1',
                megaCols === 2 && 'grid-cols-2',
                megaCols === 3 && 'grid-cols-3',
                megaCols === 4 && 'grid-cols-4',
              ]}>
                {(link.children ?? []).map((group) => (
                  <div>
                    {group.title && (
                      <div class="text-xs font-semibold uppercase tracking-wider text-muted/60 mb-3">{group.title}</div>
                    )}
                    <ul class="space-y-1">
                      {group.links.map((item) => (
                        <li>
                          <a
                            href={item.href}
                            class="group flex items-start gap-3 p-2 -mx-2 rounded-md hover:bg-surface-hover transition-colors no-underline"
                          >
                            {item.icon && (
                              <span class="mt-0.5 flex items-center justify-center w-8 h-8 rounded-md bg-primary/10 text-primary shrink-0">
                                <Icon name={item.icon} class="w-4 h-4" />
                              </span>
                            )}
                            <div>
                              <div class="text-sm font-medium text-heading group-hover:text-primary transition-colors">{item.label}</div>
                              {item.description && <div class="text-xs text-muted/60 mt-0.5 leading-relaxed">{item.description}</div>}
                            </div>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>

              {/* Featured card */}
              {link.mega?.featured && (
                <div class="w-64 shrink-0">
                  <a href={link.mega.featured.href} class="block rounded-lg overflow-hidden border border-border hover:border-primary/30 transition-colors no-underline group">
                    {link.mega.featured.image && (
                      <Image src={link.mega.featured.image} alt="" width={256} ratio="16/9" />
                    )}
                    <div class="p-4">
                      <div class="text-sm font-semibold text-heading group-hover:text-primary transition-colors">{link.mega.featured.title}</div>
                      {link.mega.featured.description && (
                        <div class="text-xs text-muted/60 mt-1 leading-relaxed">{link.mega.featured.description}</div>
                      )}
                    </div>
                  </a>
                </div>
              )}
            </div>

            {/* Mega footer */}
            {link.mega?.footer && (
              <div class="mt-6 pt-4 border-t border-border text-sm text-muted">
                <Fragment set:html={link.mega.footer} />
              </div>
            )}
          </Popover>
        );
      })}
    </nav>

    <!-- Desktop actions -->
    <div class="hidden md:flex items-center gap-2">
      <ThemeToggle />
      <LocaleSwitcher />
      {actions.length > 0 && (
        <div class="flex items-center gap-2 ml-5">
          {actions.map((action) => (
            <Button href={action.href} variant={action.variant || 'primary'} size="sm" class="px-4 py-2.5">
              {action.icon && <Icon name={action.icon} class="w-4 h-4" />}
              {action.label}
            </Button>
          ))}
        </div>
      )}
    </div>

    <!-- Mobile menu: a Sheet opened by an invoker, the platform does the rest -->
    <Button
      variant="ghost"
      size="sm"
      class="md:hidden size-10 p-0"
      command="show-modal"
      commandfor="parche-mobile-menu"
      icon="tabler:menu-2"
      label="Open menu"
    />
    <Sheet id="parche-mobile-menu" title="Menu" hideTitle closeLabel="Close menu">
      <nav class="flex flex-col" aria-label="Mobile navigation">
        {links.map((link) => {
          const type = linkType(link);

          if (type === 'link') {
            return (
              <a
                href={link.href}
                class="text-lg font-medium text-muted hover:text-heading py-3 border-b border-border transition-colors no-underline"
              >
                {link.label}
              </a>
            );
          }

          // Dropdown / mega groups collapse into disclosures
          return (
            <Collapsible title={link.label} class="border-b border-border">
              {(link.children ?? []).map((group) => (
                <div class="mb-2">
                  {group.title && (
                    <div class="text-xs font-semibold uppercase tracking-wider text-muted/60 px-3 py-1.5">{group.title}</div>
                  )}
                  {group.links.map((item) => (
                    <a
                      href={item.href}
                      class="flex items-center gap-3 px-3 py-2 text-base text-muted hover:text-heading transition-colors no-underline"
                    >
                      {item.icon && <Icon name={item.icon} class="w-4 h-4 shrink-0 text-muted/60" />}
                      <span>{item.label}</span>
                    </a>
                  ))}
                </div>
              ))}

              {/* Mobile featured card (compact) */}
              {link.mega?.featured && (
                <a
                  href={link.mega.featured.href}
                  class="flex items-center gap-3 mx-3 mt-2 p-3 rounded-lg bg-surface-hover no-underline"
                >
                  {link.mega.featured.image && (
                    <Image src={link.mega.featured.image} alt="" width={48} ratio="1/1" class="size-12 rounded" />
                  )}
                  <div>
                    <div class="text-sm font-semibold text-heading">{link.mega.featured.title}</div>
                    {link.mega.featured.description && (
                      <div class="text-xs text-muted/60 mt-0.5">{link.mega.featured.description}</div>
                    )}
                  </div>
                </a>
              )}
            </Collapsible>
          );
        })}
      </nav>

      <div class="flex items-center gap-3 pt-4">
        <LocaleSwitcher id="parche-locale-switcher-mobile" />
        <ThemeToggle />
      </div>

      {actions.length > 0 && (
        <Fragment slot="footer">
          {actions.map((action) => (
            <Button href={action.href} variant={action.variant || 'primary'} size="md" block icon={action.icon}>
              {action.label}
            </Button>
          ))}
        </Fragment>
      )}
    </Sheet>
  </div>
</header>

<style>
  /* The shadow appears once the page has scrolled: a scroll-driven animation
     over the first pixel of scroll, no script. Browsers without it show no
     shadow, which is fine. */
  @supports (animation-timeline: scroll()) {
    header[data-header] {
      animation: parche-header-scrolled linear both;
      animation-timeline: scroll(root);
      animation-range: 0 1px;
    }
    @keyframes parche-header-scrolled {
      to {
        box-shadow: var(--shadow-md);
      }
    }
  }
</style>
