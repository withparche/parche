---
import { inline } from '../_shared/inline';
import Icon from 'parche:elements/Icon';

interface FooterLink {
  label: string;
  href: string;
  icon?: string;
}

interface FooterColumn {
  title: string;
  links: Array<{ label: string; href: string }>;
}

interface Props {
  columns?: FooterColumn[];
  secondaryLinks?: FooterLink[];
  socialLinks?: FooterLink[];
  footNote?: string;
  copyright?: string;
  siteName?: string;
  theme?: string;
}

const {
  columns = [],
  secondaryLinks = [],
  socialLinks = [],
  footNote = '',
  copyright,
  siteName = 'AstroWind',
  theme = 'light',
  layout = 'classic',
  brand,
  note,
} = Astro.props as any;
---

{layout === 'brand' ? (
<footer class="relative border-t border-border bg-background not-prose" data-layout="brand">
  <div class="mx-auto grid max-w-(--ds-conf-width-xl) grid-cols-[repeat(auto-fit,minmax(min(170px,100%),1fr))] gap-[clamp(24px,3vw,40px)] px-(--ds-conf-gutter) pt-[clamp(44px,5vw,72px)] pb-7">
    <div class="min-w-0">
      <a href="/" class="mb-3.5 flex items-center gap-2.5 text-heading no-underline">
        {brand?.mark && <span class="block size-[22px] flex-none rounded-sm bg-primary" aria-hidden="true"></span>}
        <span class="font-heading text-[17px] leading-none font-semibold tracking-[-0.02em]">{brand?.text ?? siteName}</span>
      </a>
      {brand?.description && <p class="mb-3.5 max-w-[30ch] text-sm leading-[1.6] text-muted" set:html={inline(brand.description)} />}
      {brand?.links?.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {brand.links.map((l: { label: string; href: string }) => (
            <a href={l.href} class="rounded-sm border border-border px-2.5 py-[7px] font-mono text-xs leading-none text-muted no-underline hover:border-primary hover:text-heading">{l.label}</a>
          ))}
        </div>
      )}
    </div>
    {columns.map(({ title, links }: { title: string; links: Array<{ label: string; href: string }> }) => (
      <div class="min-w-0">
        <p class="mb-3.5 type-label text-muted">{title}</p>
        <ul class="flex flex-col gap-2.5 text-sm leading-[1.4]">
          {links.map(({ label, href }) => <li><a href={href} class="text-heading no-underline hover:text-primary">{label}</a></li>)}
        </ul>
      </div>
    ))}
  </div>
  <div class="mx-auto flex max-w-(--ds-conf-width-xl) flex-wrap justify-between gap-4 border-t border-border px-(--ds-conf-gutter) py-5 type-small text-muted">
    <span>{copyright ? <Fragment set:html={inline(copyright)} /> : <>&copy; {new Date().getFullYear()} {siteName}</>}</span>
    {note && <span set:html={inline(note)} />}
  </div>
</footer>
) : (

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-border not-prose']}>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-8 md:py-12">
      {/* Site name + secondary links */}
      <div class="col-span-12 lg:col-span-4">
        <div class="mb-2">
          <a class="inline-block font-bold text-xl text-heading" href="/">{siteName}</a>
        </div>
        {secondaryLinks.length > 0 && (
          <div class="text-sm text-muted flex gap-1">
            {secondaryLinks.map(({ label, href }, index) => (
              <>
                {index !== 0 ? ' · ' : ''}
                <a
                  class="text-muted hover:text-heading hover:underline transition duration-150 ease-in-out"
                  href={href}
                >
                  {label}
                </a>
              </>
            ))}
          </div>
        )}
      </div>

      {/* Link columns */}
      {columns.map(({ title, links }) => (
        <div class="col-span-6 md:col-span-3 lg:col-span-2">
          <div class="font-medium text-heading mb-2">{title}</div>
          {links.length > 0 && (
            <ul class="text-sm">
              {links.map(({ label, href }) => (
                <li class="mb-2">
                  <a
                    class="text-muted hover:text-heading hover:underline transition duration-150 ease-in-out"
                    href={href}
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>

    {/* Bottom bar: social links + footnote */}
    <div class="md:flex md:items-center md:justify-between py-6 md:py-8">
      {socialLinks.length > 0 && (
        <ul class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0 rtl:ml-0 rtl:-mr-2 rtl:md:ml-0 rtl:md:mr-4">
          {socialLinks.map(({ label, href, icon }) => (
            <li>
              <a
                class="text-muted hover:bg-surface-hover hover:text-heading focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring rounded-lg text-sm p-2.5 inline-flex items-center"
                aria-label={label}
                href={href}
              >
                {icon && <Icon name={icon} class="w-5 h-5" />}
              </a>
            </li>
          ))}
        </ul>
      )}

      <div class="text-sm text-muted mr-4">
        {footNote ? (
          <Fragment set:html={inline(footNote)} />
        ) : copyright ? (
          <Fragment set:html={inline(copyright)} />
        ) : (
          <span>&copy; {new Date().getFullYear()} {siteName}. All rights reserved.</span>
        )}
      </div>
    </div>
  </div>
</footer>
)}
