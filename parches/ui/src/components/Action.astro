---
/**
 * Action — the adapter between the widgets' JSON action shape
 * (`{ variant, text, href, target, icon }`, stable because content references
 * it) and the Button element. No styling of its own: every look comes from
 * Button, so a theme restyles all calls to action in one place.
 *
 * `tertiary` is the legacy name for a secondary button and maps to it.
 */
import Button from 'parche:elements/Button';

interface ActionData {
  variant?: 'primary' | 'secondary' | 'tertiary' | 'link';
  text?: string;
  href?: string;
  target?: string;
  icon?: string;
}

interface Props {
  action: ActionData;
  class?: string;
}

const { action, class: className } = Astro.props;
const { variant = 'primary', text, href, target, icon } = action;
const buttonVariant = variant === 'tertiary' ? 'secondary' : variant;
---

{(text || icon) && (
  <Button variant={buttonVariant} size="lg" href={href} target={target} icon={icon} iconPosition="end" label={text ? undefined : icon} class={className}>
    {text}
  </Button>
)}
