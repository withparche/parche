---
/**
 * One Features item as a row between hairlines: the eyebrow as a left column
 * (a week range, a year), the title and text in the middle, the aside as a
 * right column (a figure, a duration). A tone colours the eyebrow and footer.
 */
import { inline } from '../_shared/inline';
import type { Props as FeaturesProps } from '../widgets/Features.props';

interface Props {
  item: FeaturesProps['items'][number];
  hasEyebrow: boolean;
  hasAside: boolean;
  /** Eyebrows in the brand colour (a week range, a step number); quiet otherwise. */
  accent?: boolean;
}

const { item, hasEyebrow, hasAside, accent = false } = Astro.props;
const toneInk: Record<string, string> = { neutral: 'text-muted', muted: 'text-muted', primary: 'text-primary', success: 'text-success', warning: 'text-warning', danger: 'text-danger' };
const pill: Record<string, string> = { neutral: 'bg-surface-2 text-muted', muted: 'bg-surface-2 text-muted', primary: 'bg-primary-soft text-primary', success: 'bg-success-soft text-success', warning: 'bg-warning-soft text-warning', danger: 'bg-danger-soft text-danger' };
const eyebrowInk = item.eyebrowTone ? toneInk[item.eyebrowTone] : item.tone !== 'neutral' && item.tone !== 'muted' ? toneInk[item.tone] : accent ? 'text-primary' : 'text-muted';
const cols = hasEyebrow && hasAside ? 'grid-cols-[auto_1fr_auto]' : hasEyebrow ? 'grid-cols-[auto_1fr]' : hasAside ? 'grid-cols-[1fr_auto]' : 'grid-cols-1';
const Title = item.href ? 'a' : 'span';
---

<li class:list={['grid items-baseline gap-x-[clamp(14px,2vw,26px)]', cols, item.tone === 'muted' && 'opacity-55']}>
  {hasEyebrow && <span class:list={['font-mono text-xs leading-[1.6] font-medium whitespace-nowrap', eyebrowInk]} set:html={inline(item.eyebrow) ?? ''} />}
  <span class="min-w-0">
    {item.title && (
      <Title href={item.href} class:list={['block type-title', item.description && 'mb-1.5', item.href && 'no-underline hover:text-primary']} set:html={inline(item.title)} />
    )}
    {item.description && <span class="block type-body-sm text-muted" set:html={inline(item.description)} />}
    {item.points.length > 0 && (
      <ul class="mt-2 flex flex-col gap-1.5 text-sm leading-[1.55] text-heading">
        {item.points.map((p) => <li set:html={inline(p)} />)}
      </ul>
    )}
    {item.footer && <span class:list={['mt-2 block font-mono text-[13px] leading-[1.55]', toneInk[item.tone]]} set:html={inline(item.footer)} />}
  </span>
  {hasAside && (
    item.asideTone ? (
      <span class:list={['justify-self-end rounded-full px-2.5 py-1 font-mono text-[11px] leading-none font-medium whitespace-nowrap', pill[item.asideTone]]} set:html={inline(item.aside) ?? ''} />
    ) : (
      <span class="text-right font-mono text-[13px] leading-[1.4] whitespace-nowrap text-muted" set:html={inline(item.aside) ?? ''} />
    )
  )}
</li>
