---
/**
 * One case study, result first when asked: the client and sector, the title,
 * what was done, the measured results, a quote and a quiet footer. As a card
 * (image on top), a row (image beside), or the featured case (full width, a
 * wide image, results and quote beside the text).
 */
import Card from 'parche:elements/Card';
import Image from 'parche:elements/Image';
import Placeholder from 'parche:elements/Placeholder';
import { inline } from '../_shared/inline';
import type { Props as CasesProps } from '../widgets/Cases.props';

interface Props {
  item: CasesProps['items'][number];
  shape: 'card' | 'row' | 'featured';
  resultsFirst: boolean;
}

const { item: c, shape, resultsFirst } = Astro.props;
const tones = { default: 'text-heading', success: 'text-success', warning: 'text-warning' } as const;
const ratio = shape === 'featured' ? '21/9' : '16/10';
const lead = resultsFirst ? c.results[0] : undefined;
const rest = resultsFirst ? c.results.slice(1) : c.results;
---

<Card as="article" radius="lg" padding="none" shadow="none" class:list={['min-w-0', shape === 'featured' && 'col-span-full', shape === 'row' && 'md:grid md:grid-cols-[minmax(240px,42%)_1fr]']}>
  {shape === 'row' ? (
    <div class="overflow-hidden md:h-full">
      {c.image ? <Image src={c.image.src} alt={c.image.alt} width={900} ratio="16/10" class="block h-full w-full object-cover" /> : <Placeholder caption={c.caption} label={c.title ?? c.client} ratio="16/10" stripe={11} compact class="md:h-full" />}
    </div>
  ) : c.image ? (
    <Image slot="media" src={c.image.src} alt={c.image.alt} width={shape === 'featured' ? 1600 : 900} {ratio} class="block w-full" />
  ) : (
    <Placeholder slot="media" caption={c.caption} label={c.title ?? c.client} {ratio} stripe={11} compact />
  )}
  <div class:list={['flex flex-1 flex-col gap-4 p-[var(--ds-comp-card-padding-md,clamp(1rem,2.4vw,1.5rem))]', shape === 'featured' && 'md:grid md:grid-cols-[1.3fr_1fr] md:gap-[clamp(24px,4vw,56px)]']}>
    <div>
      {lead && <p class:list={['mb-3 font-heading text-[clamp(1.75rem,3vw,2.25rem)] leading-none font-semibold tracking-[-0.03em]', tones[lead.tone]]}>{lead.value}<span class="ml-2 align-middle font-body text-sm font-normal tracking-normal text-muted">{lead.label}</span></p>}
      <p class="mb-2.5 type-label text-muted">{[c.client, c.sector].filter(Boolean).join(' · ')}</p>
      {c.title && <h3 class="mb-2 font-heading text-(length:--ds-sys-type-h3-size) leading-[1.3] font-semibold tracking-[-0.015em] text-pretty text-heading">
        {c.href ? <a href={c.href} class="text-inherit no-underline hover:text-primary" set:html={inline(c.title)} /> : <Fragment set:html={inline(c.title)} />}
      </h3>}
      {c.description && <p class="type-body-sm text-muted" set:html={inline(c.description)} />}
      {c.footer && shape !== 'featured' && <p class="mt-3 font-mono text-xs leading-[1.4] text-muted" set:html={inline(c.footer)} />}
    </div>
    {(rest.length > 0 || c.quote || (c.footer && shape === 'featured')) && (
      <div class:list={['flex flex-col gap-4', shape !== 'featured' && 'mt-auto']}>
        {rest.length > 0 && (
          <dl class:list={['flex flex-wrap gap-[18px]', shape !== 'featured' && 'border-t border-border-soft pt-4']}>
            {rest.map((r) => (
              <div class="flex flex-col">
                <dd class:list={['order-1 font-heading text-xl leading-none font-semibold', tones[r.tone]]}>{r.value}</dd>
                <dt class="order-2 mt-[5px] text-xs leading-[1.3] text-muted">{r.label}</dt>
              </div>
            ))}
          </dl>
        )}
        {c.quote && (
          <figure class="rounded-r-sm border-l-[3px] border-primary bg-primary-soft px-4 py-3">
            <blockquote class="text-sm leading-[1.6] text-heading">“<Fragment set:html={inline(c.quote.text)} />”</blockquote>
            <figcaption class="mt-2 font-mono text-xs leading-[1.4] text-muted">{[c.quote.name, c.quote.role].filter(Boolean).join(' · ')}</figcaption>
          </figure>
        )}
        {c.footer && shape === 'featured' && <p class="font-mono text-xs leading-[1.4] text-muted" set:html={inline(c.footer)} />}
      </div>
    )}
  </div>
</Card>
