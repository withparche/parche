---
/**
 * One verified quote: the card Testimonials lays out in a grid or a carousel.
 * The name, the role, the date and where it was said travel with the quote;
 * the source is a link when there is one.
 */
import Card from 'parche:elements/Card';
import Avatar from 'parche:elements/Avatar';
import Divider from 'parche:elements/Divider';
import type { VerifiedQuote } from '../_shared/content';

type Props = VerifiedQuote & { title?: string };
const { title, text, name, role, avatar, date, source, href } = Astro.props;
const where = [date, source].filter(Boolean).join(' · ');
---

<Card as="article" class="h-full">
  {title && <h3 slot="header" class="type-label text-heading font-medium">{title}</h3>}

  <blockquote class="flex-auto">
    <p class="type-body text-muted">"{text}"</p>
  </blockquote>

  <Divider class="my-4" />

  <div class="flex items-center gap-3">
    {avatar?.src && <Avatar src={avatar.src} name={name} alt={avatar.alt} size="md" />}
    <div class="grow min-w-0">
      <p class="text-sm font-semibold text-heading">{name}</p>
      {role && <p class="text-xs text-muted">{role}</p>}
      {where && (
        <p class="text-xs text-muted font-mono mt-0.5">
          {href ? <a href={href} class="underline underline-offset-2 hover:text-heading">{where}</a> : where}
        </p>
      )}
    </div>
  </div>
</Card>
