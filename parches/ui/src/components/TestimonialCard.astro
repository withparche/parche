---
/**
 * One verified quote: the quote, who said it, and when and where, linked to
 * the original. Laid out in a grid or a carousel by Testimonials.
 */
import Avatar from 'parche:elements/Avatar';
import type { VerifiedQuote } from '../_shared/content';
import { inline } from '../_shared/inline';

type Props = VerifiedQuote & { title?: string };
const { title, text, name, role, avatar, date, source, href } = Astro.props;
---

<figure class="flex h-full flex-col gap-[18px] rounded-md border border-border bg-surface p-[clamp(22px,3vw,30px)]">
  {title && <p class="type-label text-heading">{title}</p>}
  <blockquote class="text-[17px] leading-[1.6] text-pretty text-heading">“<Fragment set:html={inline(text)} />”</blockquote>
  <figcaption class="mt-auto flex flex-col gap-3">
    <span class="flex items-center gap-3">
      {avatar?.src ? (
        <Avatar src={avatar.src} name={name} alt={avatar.alt} size="sm" class="size-[34px]" />
      ) : (
        <span class="block size-[34px] flex-none rounded-full border border-border bg-surface-2" aria-hidden="true"></span>
      )}
      <span>
        <span class="block text-sm leading-[1.3] font-semibold text-heading">{name}</span>
        {role && <span class="block text-[13px] leading-[1.3] text-muted">{role}</span>}
      </span>
    </span>
    {(date || source) && (
      <span class="flex flex-wrap items-center gap-2.5 border-t border-border-soft pt-3 font-mono text-xs leading-[1.4] text-muted">
        {date && <span>{date}</span>}
        {date && source && <span aria-hidden="true">·</span>}
        {source && (href ? <a href={href} class="text-primary no-underline hover:text-heading">{source}</a> : <span>{source}</span>)}
      </span>
    )}
  </figcaption>
</figure>
