---
/**
 * The fields of a form from content: each `type` to its element, with the
 * label, help and requirement wired through Field.
 */
import Input from 'parche:elements/Input';
import Textarea from 'parche:elements/Textarea';
import Select from 'parche:elements/Select';
import Checkbox from 'parche:elements/Checkbox';
import RadioGroup from 'parche:elements/RadioGroup';
import type { Field } from '../_shared/form';

interface Props {
  fields: Field[];
}

const { fields } = Astro.props;
const humanize = (name: string) => name.charAt(0).toUpperCase() + name.slice(1).replace(/[-_]+/g, ' ');
const options = (f: Field) => (f.options ?? []).map((o) => (typeof o === 'string' ? { value: o, label: o, disabled: false } : o));
---

{fields.map((f) => {
  const label = f.label ?? humanize(f.name);
  if (f.type === 'textarea') return <Textarea name={f.name} {label} placeholder={f.placeholder} rows={f.rows ?? 4} grow={false} required={f.required} description={f.help} />;
  if (f.type === 'select') return <Select name={f.name} {label} options={options(f)} placeholder={f.placeholder} required={f.required} description={f.help} />;
  if (f.type === 'radio') return <RadioGroup name={f.name} {label} options={options(f)} required={f.required} description={f.help} />;
  if (f.type === 'checkbox') return <Checkbox name={f.name} {label} required={f.required} description={f.help} />;
  return <Input name={f.name} {label} type={f.type} placeholder={f.placeholder} autocomplete={f.autocomplete} required={f.required} description={f.help} />;
})}
