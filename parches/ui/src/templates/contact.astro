---
import Container from 'parche:elements/Container';
import Section from 'parche:elements/Section';
import Button from 'parche:elements/Button';
import Input from 'parche:elements/Input';
import Textarea from 'parche:elements/Textarea';

interface Props {
  data: {
    formLabels: Record<string, string>;
  };
}

const { data } = Astro.props;
const labels = data.formLabels;
---

<Section>
  <Container class="max-w-2xl">
    <div class="text-center mb-12">
      <p class="type-label text-primary mb-4">{labels.tagline}</p>
      <h1 class="type-h1 mb-4" set:html={labels.heading} />
      <p class="type-body text-muted">{labels.subtitle}</p>
    </div>

    <form class="space-y-6" data-astro-reload>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <Input name="name" label={labels.name} placeholder={labels.namePlaceholder} autocomplete="name" required />
        <Input name="email" type="email" label={labels.email} placeholder={labels.emailPlaceholder} autocomplete="email" required />
      </div>
      <Input name="subject" label={labels.subject} placeholder={labels.subjectPlaceholder} />
      <Textarea name="message" label={labels.message} placeholder={labels.messagePlaceholder} rows={5} required />
      <Button class="w-full" type="submit">{labels.submit}</Button>
    </form>
  </Container>
</Section>
