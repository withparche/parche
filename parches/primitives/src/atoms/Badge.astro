---
interface Props {
  variant?: 'default' | 'primary' | 'success' | 'warning' | 'danger' | 'muted';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'default', size = 'md', class: className = '' } = Astro.props;

const variants: Record<string, string> = {
  default:  'bg-surface text-heading border border-border',
  primary:  'bg-primary/10 text-primary border border-primary/20',
  success:  'bg-green-500/10 text-green-600 dark:text-green-400 border border-green-500/20',
  warning:  'bg-yellow-500/10 text-yellow-600 dark:text-yellow-400 border border-yellow-500/20',
  danger:   'bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20',
  muted:    'bg-muted/50 text-muted border border-border',
};

const sizes: Record<string, string> = {
  sm: 'px-2 py-0.5 text-xs',
  md: 'px-2.5 py-1 text-xs',
};
---

<span class:list={[
  'inline-flex items-center gap-1 rounded-full font-medium',
  variants[variant],
  sizes[size],
  className,
]}>
  <slot />
</span>
