---
/**
 * Section wrapper for legacy widgets.
 * Handles: configurable HTML tag, background layer, isDark per-widget,
 * responsive container with padding, and class overrides via twMerge.
 */
import type { HTMLTag } from 'astro/types';
import { twMerge } from 'tailwind-merge';

interface Props {
  id?: string;
  isDark?: boolean;
  bg?: string;
  containerClass?: string;
  as?: HTMLTag;
}

const { id, isDark = false, containerClass = '', bg, as = 'section' } = Astro.props;

const Tag = as;
---

<Tag class="relative not-prose scroll-mt-[72px]" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none -z-[1]" aria-hidden="true">
    <slot name="bg">
      {bg ? (
        <Fragment set:html={bg} />
      ) : isDark ? (
        <div class="absolute inset-0 bg-neutral-900 dark:bg-transparent" />
      ) : null}
    </slot>
  </div>
  <div
    class:list={[
      twMerge(
        'relative mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20',
        containerClass,
      ),
      { dark: isDark },
    ]}
  >
    <slot />
  </div>
</Tag>
