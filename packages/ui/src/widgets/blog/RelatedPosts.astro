---
/**
 * Related posts — 4-column grid with simple cards (v1 style).
 */
import Container from 'parche:primitives/Container';
import Section from 'parche:primitives/Section';

interface PostItem {
  title: string;
  description?: string;
  href: string;
  image?: { src: string; alt: string };
  publishDate: Date;
  category?: string;
  tags?: string[];
  readingTime?: number;
}

interface Props {
  title?: string;
  linkText?: string;
  linkUrl?: string;
  posts: PostItem[];
  id?: string;
  class?: string;
  background?: string;
}

const {
  title = 'Related Posts',
  linkText = 'View All Posts',
  linkUrl,
  posts,
  id,
  class: className = '',
  background,
} = Astro.props;
---

{posts.length > 0 && (
  <Section {id} class={className} {background}>
    <Container>
      <div class="flex flex-col lg:justify-between lg:flex-row mb-8">
        {title && (
          <div class="md:max-w-sm">
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl sm:leading-none group font-heading mb-2">
              {title}
            </h2>
            {linkText && linkUrl && (
              <a
                class="text-muted dark:text-slate-400 hover:text-primary transition ease-in duration-200 block mb-6 lg:mb-0"
                href={linkUrl}
              >
                {linkText} &raquo;
              </a>
            )}
          </div>
        )}
      </div>

      <div class="grid gap-6 row-gap-5 md:grid-cols-2 lg:grid-cols-4 -mb-6">
        {posts.map((post) => (
          <article class="mb-6 transition">
            {post.image && (
              <div class="relative h-52 md:h-64 bg-gray-400 dark:bg-slate-700 rounded shadow-lg mb-6">
                {post.href ? (
                  <a href={post.href} class="block h-full">
                    <img
                      src={post.image.src}
                      alt={post.image.alt || post.title}
                      class="w-full h-full rounded shadow-lg bg-gray-400 dark:bg-slate-700 object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                ) : (
                  <img
                    src={post.image.src}
                    alt={post.image.alt || post.title}
                    class="w-full h-full rounded shadow-lg bg-gray-400 dark:bg-slate-700 object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
            )}

            <h3 class="text-xl sm:text-2xl font-bold leading-tight mb-2 font-heading dark:text-slate-300">
              {post.href ? (
                <a class="inline-block hover:text-primary dark:hover:text-blue-700 transition ease-in duration-200" href={post.href}>
                  {post.title}
                </a>
              ) : (
                post.title
              )}
            </h3>

            {post.description && <p class="text-muted dark:text-slate-400 text-lg">{post.description}</p>}
          </article>
        ))}
      </div>
    </Container>
  </Section>
)}
