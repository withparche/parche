{
  "$description": "System tokens: the roles every element and widget is styled from, and the only layer a theme is expected to override. A colour role carries its light value in $value and its dark value in $extensions.parche.dark. A reference {ref.color.primary.600} resolves to var(--ds-ref-color-primary-600), so a theme that replaces a ramp moves every role that points into it.",
  "color": {
    "$type": "color",
    "background": { "$value": "oklch(1 0 0)", "$extensions": { "parche": { "dark": "oklch(0.100 0.040 260)" } }, "$description": "The page canvas." },
    "foreground": { "$value": "oklch(0.07 0.01 260)", "$extensions": { "parche": { "dark": "oklch(0.960 0.005 260)" } }, "$description": "Default ink on the canvas." },
    "surface": { "$value": "oklch(1 0 0)", "$extensions": { "parche": { "dark": "oklch(0.140 0.040 260)" } }, "$description": "Cards, menus, dialogs, inputs." },
    "surface-hover": { "$value": "oklch(0.965 0.004 260)", "$extensions": { "parche": { "dark": "oklch(0.190 0.040 260)" } }, "$description": "Hover on a surface: menu items, ghost buttons." },
    "on-surface": { "$value": "oklch(0.25 0.008 260)", "$extensions": { "parche": { "dark": "oklch(0.800 0.010 250)" } }, "$description": "Text on a surface." },
    "primary": { "$value": "oklch(0.500 0.220 260)", "$extensions": { "parche": { "dark": "oklch(0.650 0.190 260)" } }, "$description": "The brand colour: primary buttons, links, active states." },
    "on-primary": { "$value": "oklch(1 0 0)", "$extensions": { "parche": { "dark": "oklch(0.130 0.040 260)" } }, "$description": "Text on primary." },
    "primary-soft": { "$value": "{ref.color.primary.50}", "$extensions": { "parche": { "dark": "oklch(0.200 0.060 260)" } }, "$description": "Tinted surface under primary text: badges, callouts, selected rows." },
    "muted": { "$value": "oklch(0.55 0.02 264.42)", "$extensions": { "parche": { "dark": "oklch(0.60 0.015 260)" } }, "$description": "Secondary text." },
    "border": { "$value": "oklch(0.90 0.006 260)", "$extensions": { "parche": { "dark": "oklch(0.200 0.030 260)" } }, "$description": "Hairlines and control borders." },
    "heading": { "$value": "oklch(0.07 0.01 260)", "$extensions": { "parche": { "dark": "oklch(0.970 0.003 260)" } }, "$description": "Headings." },
    "text": { "$value": "oklch(0.25 0.008 260)", "$extensions": { "parche": { "dark": "oklch(0.800 0.010 250)" } }, "$description": "Body text." },
    "highlight": { "$value": "oklch(0.420 0.270 295)", "$extensions": { "parche": { "dark": "oklch(0.660 0.220 295)" } }, "$description": "A second accent for emphasis (v1 purple)." },
    "ring": { "$value": "{sys.color.primary}", "$extensions": { "parche": { "dark": "{sys.color.primary}" } }, "$description": "Every focus-visible outline." },
    "overlay": { "$value": "oklch(0.07 0.01 260 / 0.5)", "$extensions": { "parche": { "dark": "oklch(0.02 0.01 260 / 0.7)" } }, "$description": "Dialog and sheet backdrop." },
    "success": { "$value": "{ref.color.success.700}", "$extensions": { "parche": { "dark": "{ref.color.success.400}" } } },
    "on-success": { "$value": "oklch(1 0 0)", "$extensions": { "parche": { "dark": "oklch(0.12 0.03 145)" } } },
    "success-soft": { "$value": "{ref.color.success.50}", "$extensions": { "parche": { "dark": "oklch(0.22 0.05 145)" } } },
    "warning": { "$value": "{ref.color.warning.700}", "$extensions": { "parche": { "dark": "{ref.color.warning.400}" } } },
    "on-warning": { "$value": "oklch(1 0 0)", "$extensions": { "parche": { "dark": "oklch(0.12 0.03 70)" } } },
    "warning-soft": { "$value": "{ref.color.warning.50}", "$extensions": { "parche": { "dark": "oklch(0.22 0.05 70)" } } },
    "danger": { "$value": "{ref.color.danger.700}", "$extensions": { "parche": { "dark": "{ref.color.danger.400}" } } },
    "on-danger": { "$value": "oklch(1 0 0)", "$extensions": { "parche": { "dark": "oklch(0.12 0.03 25)" } } },
    "danger-soft": { "$value": "{ref.color.danger.50}", "$extensions": { "parche": { "dark": "oklch(0.22 0.06 25)" } } }
  },
  "font": {
    "$type": "fontFamily",
    "heading": { "$value": "{ref.font.sans}", "$description": "Headings and display text." },
    "body": { "$value": "{ref.font.sans}", "$description": "Body and UI text." },
    "mono": { "$value": "{ref.font.mono}", "$description": "Code, eyebrows, meta." }
  },
  "type": {
    "$type": "typography",
    "$description": "The composed type styles. Each becomes four tokens (size, weight, tracking, leading) and one class, .type-<style>.",
    "h1": { "$value": { "fontSize": "3.75rem", "fontWeight": 700, "letterSpacing": "-1.26125px", "lineHeight": 1.08 } },
    "h2": { "$value": { "fontSize": "2.40rem", "fontWeight": 700, "letterSpacing": "-1.26125px", "lineHeight": 1.15 } },
    "h3": { "$value": { "fontSize": "1.5rem", "fontWeight": 600, "letterSpacing": "0", "lineHeight": 1.3 } },
    "body": { "$value": { "fontSize": "1rem", "fontWeight": 400, "letterSpacing": "0em", "lineHeight": 1.66 } },
    "caption": { "$value": { "fontSize": "0.875rem", "fontWeight": 400, "letterSpacing": "0.01em", "lineHeight": 1.5 } },
    "label": { "$value": { "fontSize": "0.875rem", "fontWeight": 600, "letterSpacing": "0.05em", "lineHeight": 1.4 } }
  }
}
