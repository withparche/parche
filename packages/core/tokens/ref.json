  "radius": {
    "$type": "dimension",
    "$description": "Corner radii. Bridged to Tailwind as rounded-xs … rounded-full.",
    "xs": { "$value": "0.25rem" },
    "sm": { "$value": "0.375rem" },
    "md": { "$value": "0.5rem" },
    "lg": { "$value": "0.75rem" },
    "xl": { "$value": "1rem" },
    "2xl": { "$value": "1.5rem" },
    "full": { "$value": "9999px" }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation. Bridged to Tailwind as shadow-xs … shadow-2xl. Written as CSS box-shadow strings.",
    "xs": { "$value": "0 1px 2px 0 oklch(0 0 0 / 0.05)" },
    "sm": { "$value": "0 1px 3px 0 oklch(0 0 0 / 0.1), 0 1px 2px -1px oklch(0 0 0 / 0.1)" },
    "md": { "$value": "0 4px 6px -1px oklch(0 0 0 / 0.1), 0 2px 4px -2px oklch(0 0 0 / 0.1)" },
    "lg": { "$value": "0 10px 15px -3px oklch(0 0 0 / 0.1), 0 4px 6px -4px oklch(0 0 0 / 0.1)" },
    "xl": { "$value": "0 20px 25px -5px oklch(0 0 0 / 0.1), 0 8px 10px -6px oklch(0 0 0 / 0.1)" },
    "2xl": { "$value": "0 25px 50px -12px oklch(0 0 0 / 0.25)" }
  },
  "font": {
    "$type": "fontFamily",
    "$description": "Font stacks. --font-sans and --font-mono are filled by Astro's Fonts API when a theme declares a typeface; the var() fallback is what applies when no theme does, so the stack must stay one string.",
    "sans": { "$value": "var(--font-sans, ui-sans-serif, system-ui, sans-serif)" },
    "mono": { "$value": "var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace)" }
  }
}
