---
import '../styles/base.css';
import { ClientRouter } from 'astro:transitions';
import Font from 'astro/components/Font.astro';
import { fonts as parcheFontDefs } from 'parche:config/fonts';
import type { ResolvedMetadata } from '../utils/metadata';
import { buildRobotsContent, buildBreadcrumbs, buildJsonLdGraph } from '../utils/metadata';
import type { SiteConfig } from '../types/config';
import { defaultTheme } from 'parche:config/themes';
import { resolveAssets } from '../utils/assets.js';

interface Props {
  metadata: ResolvedMetadata;
  config: SiteConfig;
  lang?: string;
}

const { metadata, config, lang } = Astro.props;

const locale = lang ?? metadata.locale ?? 'en';

/**
 * Text direction, derived rather than configured.
 *
 * Which languages read right-to-left is a fact about the language, not a choice
 * a site should have to restate — and `Intl` already knows it. Without this the
 * `rtl:` utilities the blog widgets already carry could never activate, so the
 * support was decorative.
 *
 * `getTextInfo` is recent, hence the guard; older runtimes get the common case.
 */
let dir: 'ltr' | 'rtl' = 'ltr';
try {
  dir = (new Intl.Locale(locale) as any).getTextInfo?.().direction === 'rtl' ? 'rtl' : 'ltr';
} catch {
  // Unrecognised locale tag — left-to-right is the safe assumption.
}
const canonicalURL = metadata.canonical
  || (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname);
// The share image can come from a page's frontmatter or the site config, and
// neither passes through DynamicRenderer — resolve '@/assets/…' before it is
// turned into an absolute URL, or the origin gets prefixed onto a raw path.
const ogImage = await resolveAssets(metadata.ogImage);
const ogImageURL = ogImage && Astro.site
  ? new URL(ogImage, Astro.site).href
  : ogImage;

const robotsContent = buildRobotsContent(metadata);
const siteUrl = Astro.site?.href ?? config.site ?? '';
const breadcrumbs = siteUrl ? buildBreadcrumbs(Astro.url.pathname, siteUrl, metadata.title) : undefined;
// Structured data is built from the config, which can name assets ('@/assets/…')
// and is another path that never sees DynamicRenderer. Absolute URLs matter here
// too: schema.org consumers cannot resolve a site-relative logo.
const resolvedConfig = await resolveAssets(config);
const absoluteConfig = Astro.site && (resolvedConfig as any).metadata?.organization?.logo
  ? {
      ...resolvedConfig,
      metadata: {
        ...(resolvedConfig as any).metadata,
        organization: {
          ...(resolvedConfig as any).metadata.organization,
          logo: new URL((resolvedConfig as any).metadata.organization.logo, Astro.site).href,
        },
      },
    }
  : resolvedConfig;
const jsonLdGraph = buildJsonLdGraph(metadata, canonicalURL, siteUrl, absoluteConfig, breadcrumbs);

const verification = config.metadata?.verification;
const preconnect = config.metadata?.preconnect ?? [];
const twitterHandle = config.metadata?.twitterHandle;
const article = metadata.ogType === 'article' ? metadata.article : undefined;
---

<html lang={locale} dir={dir} data-theme={defaultTheme || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{metadata.title}</title>
    {metadata.description && <meta name="description" content={metadata.description} />}
    {metadata.keywords && <meta name="keywords" content={metadata.keywords} />}
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={robotsContent} />

    {/* Verification tokens */}
    {verification?.google && <meta name="google-site-verification" content={verification.google} />}
    {verification?.bing && <meta name="msvalidate.01" content={verification.bing} />}
    {verification?.yandex && <meta name="yandex-verification" content={verification.yandex} />}
    {verification?.pinterest && <meta name="p:domain_verify" content={verification.pinterest} />}

    {/* Open Graph */}
    <meta property="og:title" content={metadata.ogTitle} />
    {metadata.ogDescription && <meta property="og:description" content={metadata.ogDescription} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={metadata.ogType} />
    <meta property="og:site_name" content={metadata.siteName} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta property="og:locale" content={locale} />

    {/* Article-specific OG tags */}
    {article?.author && <meta name="author" content={article.author} />}
    {article?.publishedDate && <meta property="article:published_time" content={article.publishedDate} />}
    {article?.modifiedDate && <meta property="article:modified_time" content={article.modifiedDate} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    {/* Twitter Card */}
    <meta name="twitter:card" content={metadata.twitterCard} />
    <meta name="twitter:title" content={metadata.ogTitle} />
    {metadata.ogDescription && <meta name="twitter:description" content={metadata.ogDescription} />}
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}

    {/* Resource hints */}
    {preconnect.map((url) => <link rel="preconnect" href={url} />)}

    {/* JSON-LD Structured Data (@graph) */}
    <script type="application/ld+json" set:html={jsonLdGraph} />

    {/* Fonts: driven by parcheFonts (single source of truth), never hardcoded here. */}
    {parcheFontDefs.map((f) => <Font cssVariable={f.cssVariable} preload={f.preload} />)}

    {/* Theme init: runs before body renders to prevent flash */}
    <script is:inline>
      (function() {
        var d = document.documentElement;
        var stored = localStorage.getItem('theme');
        if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          d.classList.add('dark');
        }
        // The server may already have rendered data-theme (themes.default), so a
        // first paint is correct with no script. A visitor's own choice wins, and
        // choosing the base look ('') must clear the attribute, not be ignored.
        var siteTheme = localStorage.getItem('site-theme');
        if (siteTheme !== null) {
          if (siteTheme) d.setAttribute('data-theme', siteTheme);
          else d.removeAttribute('data-theme');
        }

        // Preserve theme state across View Transitions
        document.addEventListener('astro:before-swap', function(e) {
          var html = document.documentElement;
          var newHtml = e.newDocument.documentElement;
          if (html.classList.contains('dark')) {
            newHtml.classList.add('dark');
          }
          var theme = html.getAttribute('data-theme');
          if (theme) {
            newHtml.setAttribute('data-theme', theme);
          }
        });
      })();
    </script>

    <ClientRouter />

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background text-text flex flex-col">
    <slot />
  </body>
</html>
