---
/**
 * Renders a tree of nodes: loads only the widgets the tree references, resolves
 * `@/assets/…` paths at any depth, and hands each root to `Node`, which wraps
 * it in the registry's wrapper widget when `wrap` is set (page roots) and
 * fills the widget's slots from the node's.
 */
import { loadWidgets } from 'parche:registry/widgets';
import { wrapper as wrapperName } from 'parche:config/layout';
import { resolveAssets } from '../utils/assets.js';
import { expandPresets } from '../utils/presets.js';
import type { Node as NodeData } from '../content/node';
import { widgetNames } from '../content/node';
import Node from './Node.astro';

interface Props {
  nodes: NodeData[];
  /** Wrap each root in the wrapper widget (page content). Layout chrome is not wrapped. */
  wrap?: boolean;
  /** Content for `Outlet` nodes, when rendering a layout. */
  outlets?: { nodes: Record<string, NodeData[]>; html: Record<string, string> };
}

const { nodes: givenNodes, wrap = false, outlets: givenOutlets } = Astro.props;

// Presets first: a `Preset` node becomes the saved tree it names, so what
// follows sees only real widgets.
const locale = (Astro.locals as any).parche?.locale as string | undefined;
const rawNodes = await expandPresets(givenNodes, locale);
const rawOutlets = givenOutlets
  ? {
      nodes: Object.fromEntries(await Promise.all(Object.entries(givenOutlets.nodes).map(async ([k, v]) => [k, await expandPresets(v, locale)]))),
      html: givenOutlets.html,
    }
  : undefined;

// Everything the render will touch, loaded once: the tree, the outlet trees
// and the wrapper. Widgets not referenced are never imported.
const outletTrees = Object.values(rawOutlets?.nodes ?? {}).flat();
const names = widgetNames([...rawNodes, ...outletTrees]);
if (wrapperName) names.push(wrapperName);
const widgets = await loadWidgets(names);

const nodes = await resolveAssets(rawNodes);
const outlets = rawOutlets
  ? { nodes: await resolveAssets(rawOutlets.nodes), html: rawOutlets.html }
  : undefined;

const wrapper = wrapperName && widgets[wrapperName] ? { name: wrapperName, component: widgets[wrapperName] } : null;
if (import.meta.env.DEV && wrapperName && !wrapper) {
  console.warn(`[parche] The wrapper widget "${wrapperName}" is declared but not registered; roots render bare.`);
}

// Check the trees against the catalog: slots a widget does not declare,
// widgets a slot does not allow, counts, depth, tones. In dev every issue is
// a warning with its path; in a build, a prerendered page with issues fails
// the build, which is the CI check. The catalog imports every widget's
// schema, so it is loaded only here and never on a server-rendered request.
if (import.meta.env.DEV || Astro.isPrerendered) {
  const [{ widgetMeta }, { tones }, { validateTree }] = await Promise.all([
    import('parche:registry/widgetSchemas'),
    import('parche:config/layout'),
    import('../content/validate.js'),
  ]);
  const ctx = { widgets: widgetMeta as any, tones: tones.map((t) => t.name), wrapper: wrapperName };
  const issues = [
    ...validateTree(rawNodes, ctx, wrap ? 'sections' : 'layout'),
    ...Object.entries(rawOutlets?.nodes ?? {}).flatMap(([name, tree]) => validateTree(tree, ctx, name === 'default' ? 'sections' : `slots.${name}`)),
  ];
  if (issues.length && !import.meta.env.DEV) {
    throw new Error(
      `[parche] ${issues.length} content issue(s) on ${Astro.url.pathname}:\n` + issues.map((i) => `  ${i.path}: ${i.message}`).join('\n'),
    );
  }
  for (const issue of issues) console.warn(`[parche] ${issue.path}: ${issue.message}`);
}
---

{nodes.map((node) => <Node node={node} widgets={widgets} wrapper={wrapper} wrap={wrap} outlets={outlets} />)}
