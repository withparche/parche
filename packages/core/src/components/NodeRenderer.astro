---
/**
 * Renders a tree of nodes: loads only the widgets the tree references, resolves
 * `@/assets/…` paths at any depth, and hands each root to `Node`, which fills
 * the widget's slots from the node's. Nothing is wrapped unless a list says
 * so: an Outlet's `wrapper`, a page's, or the `wrapper` given here for these
 * roots (see content/wrapper.ts).
 */
import { loadWidgets, widgetLoaders } from 'parche:registry/widgets';
import { wrapper as wrapperName, unwrapped } from 'parche:config/layout';
import { resolveAssets } from '../utils/assets.js';
import { expandPresets } from '../utils/presets.js';
import { resolveRefs } from '../utils/refs.js';
import { loadJsonWidgets } from '../utils/json-widgets.js';
import { usedJsonWidgets, checkDefinition, checkUses, type JsonWidget } from '../content/json-widgets';
import type { Node as NodeData } from '../content/node';
import { widgetNames } from '../content/node';
import { listWrapper, outletWrappers, type WrapperSpec } from '../content/wrapper';
import Node from './Node.astro';

interface Props {
  nodes: NodeData[];
  /** The wrapper of these roots as a list, as an Outlet would declare it. */
  wrapper?: WrapperSpec;
  /** Content for `Outlet` nodes, when rendering a layout, and a page's own wrappers for them. */
  outlets?: { nodes: Record<string, NodeData[]>; html: Record<string, string>; wrappers?: Record<string, WrapperSpec> };
  /** Where these nodes sit, for content issue paths: `sections` for page content, `layout` for a layout. */
  base?: string;
}

const { nodes: givenNodes, wrapper: rootSpec, outlets: givenOutlets, base: givenBase } = Astro.props;
const wrap = rootSpec !== undefined;

// Presets first: a `Preset` node becomes the saved tree it names, so what
// follows sees only real widgets.
// Then references: a `$ref` or `$collection` value becomes the content it names.
const locale = (Astro.locals as any).parche?.locale as string | undefined;
const expand = async (tree: NodeData[], base: string) => resolveRefs(await expandPresets(tree, locale), locale, base);
const base = givenBase ?? (givenOutlets ? 'layout' : 'sections');
const root = await expand(givenNodes, base);
const rawNodes = root.nodes;
const outletResults = givenOutlets
  ? await Promise.all(Object.entries(givenOutlets.nodes).map(async ([k, v]) => [k, await expand(v, k === 'default' ? 'sections' : `slots.${k}`)] as const))
  : [];
const rawOutlets = givenOutlets
  ? { nodes: Object.fromEntries(outletResults.map(([k, r]) => [k, r.nodes])), html: givenOutlets.html, wrappers: givenOutlets.wrappers }
  : undefined;
const refIssues = [...root.issues, ...outletResults.flatMap(([, r]) => r.issues)];

// The wrappers the lists declare: each Outlet's (or the page's over it), and
// the one given for these roots.
const outletDecls = outletWrappers(rawNodes).map((o) => ({ ...o, spec: rawOutlets?.wrappers?.[o.name] ?? o.spec }));
const declared = [
  ...outletDecls.map((o) => ({ path: `${o.path}.props.wrapper`, wrapper: listWrapper(o.spec, wrapperName) })),
  ...(wrap ? [{ path: 'wrapper', wrapper: listWrapper(rootSpec, wrapperName) }] : []),
];
const rootWrapper = wrap ? listWrapper(rootSpec, wrapperName) : null;

// JSON widgets the trees use (and the ones inside those), each tree made
// ready like a page's: presets, references, then asset paths.
const outletTrees = Object.values(rawOutlets?.nodes ?? {}).flat();
// The collection is read only when a tree names a widget no parche registers,
// so a site without JSON widgets never touches it.
const unregistered = widgetNames([...rawNodes, ...outletTrees]).some((n) => n !== 'Outlet' && !(n in widgetLoaders));
const json = unregistered ? await loadJsonWidgets() : { widgets: {}, issues: [] };
const usedJson = [...usedJsonWidgets([...rawNodes, ...outletTrees], json.widgets)];
const definitionRefs = await Promise.all(
  usedJson.map(async (name) => {
    const r = await expand(json.widgets[name].tree, `widgets/${name}.tree`);
    return [name, { ...json.widgets[name], tree: r.nodes }, r.issues] as const;
  }),
);
const rawDefinitions: Record<string, JsonWidget> = Object.fromEntries(definitionRefs.map(([n, d]) => [n, d]));
const definitionTrees = Object.values(rawDefinitions).flatMap((d) => d.tree);

// Everything the render will touch, loaded once: the tree, the outlet trees,
// the JSON widgets' trees and the wrappers. Widgets not referenced are never imported.
const names = widgetNames([...rawNodes, ...outletTrees, ...definitionTrees]).filter((n) => !(n in rawDefinitions));
for (const d of declared) if (d.wrapper) names.push(d.wrapper.name);
const widgets = await loadWidgets([...new Set(names)]);

const nodes = await resolveAssets(rawNodes);
const outlets = rawOutlets
  ? { nodes: await resolveAssets(rawOutlets.nodes), html: rawOutlets.html }
  : undefined;
const definitions: Record<string, JsonWidget> = Object.fromEntries(
  await Promise.all(Object.entries(rawDefinitions).map(async ([n, d]) => [n, { ...d, tree: await resolveAssets(d.tree) }] as const)),
);
const unwrappedAll = [...unwrapped, ...Object.values(definitions).filter((d) => !d.wrapper).map((d) => d.name)];


// Check the trees against the catalog: slots a widget does not declare,
// widgets a slot does not allow, counts, depth, tones. In dev every issue is
// a warning with its path; in a build, a prerendered page with issues fails
// the build, which is the CI check. The catalog imports every widget's
// schema, so it is loaded only here and never on a server-rendered request.
if (import.meta.env.DEV || Astro.isPrerendered) {
  const [{ widgetMeta }, { tones }, { validateTree }] = await Promise.all([
    import('parche:registry/widgetSchemas'),
    import('parche:config/layout'),
    import('../content/validate.js'),
  ]);
  // A JSON widget is a widget with no slots to the validator; its own tree is
  // checked from its root, once, and each use's props against its schema.
  const jsonShapes = Object.fromEntries(Object.values(rawDefinitions).map((d) => [d.name, { wrapper: d.wrapper }]));
  const ctx = { widgets: { ...(widgetMeta as any), ...jsonShapes }, tones: tones.map((t) => t.name), wrapper: wrapperName };
  const jsonIssues = [
    ...json.issues,
    ...Object.values(rawDefinitions).flatMap((d) => [
      ...(d.name in (widgetMeta as any) ? [{ path: `widgets/${d.name}`, message: `"${d.name}" is also a registered widget; rename the JSON one` }] : []),
      ...checkDefinition(d),
      ...validateTree(d.tree, ctx, `widgets/${d.name}.tree`),
    ]),
    ...definitionRefs.flatMap(([, , issues]) => issues),
    ...checkUses(rawNodes, rawDefinitions, base),
    ...Object.entries(rawOutlets?.nodes ?? {}).flatMap(([name, tree]) => checkUses(tree, rawDefinitions, name === 'default' ? 'sections' : `slots.${name}`)),
  ];
  // A list's wrapper is checked like a node of that widget: it must exist and
  // its tone must be registered.
  const wrapperIssues = declared.flatMap(({ path, wrapper: w }) =>
    w ? validateTree([{ widget: w.name, props: w.props }], { ...ctx, wrapper: w.name }, path).map((i) => ({ ...i, path })) : [],
  );
  const issues = [
    ...refIssues,
    ...jsonIssues,
    ...wrapperIssues,
    ...validateTree(rawNodes, ctx, base),
    ...Object.entries(rawOutlets?.nodes ?? {}).flatMap(([name, tree]) => validateTree(tree, ctx, name === 'default' ? 'sections' : `slots.${name}`)),
  ];
  if (issues.length && !import.meta.env.DEV) {
    throw new Error(
      `[parche] ${issues.length} content issue(s) on ${Astro.url.pathname}:\n` + issues.map((i) => `  ${i.path}: ${i.message}`).join('\n'),
    );
  }
  for (const issue of issues) console.warn(`[parche] ${issue.path}: ${issue.message}`);
}
---

{nodes.map((node) => <Node node={node} widgets={widgets} wrapper={rootWrapper} defaultWrapper={wrapperName} unwrapped={unwrappedAll} outlets={outlets} definitions={definitions} />)}
