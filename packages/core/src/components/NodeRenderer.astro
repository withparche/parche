---
/**
 * Renders a tree of nodes: loads only the widgets the tree references, resolves
 * `@/assets/…` paths at any depth, and hands each root to `Node`, which fills
 * the widget's slots from the node's. Nothing is wrapped unless a list says
 * so: an Outlet's `wrapper`, a page's, or the `wrapper` given here for these
 * roots (see content/wrapper.ts).
 */
import { loadWidgets } from 'parche:registry/widgets';
import { wrapper as wrapperName, unwrapped } from 'parche:config/layout';
import { resolveAssets } from '../utils/assets.js';
import { span } from '../utils/profile.js';
import { prepareTrees, checkPrepared } from '../utils/prepare.js';
import type { Pattern } from '../content/patterns';
import type { Node as NodeData } from '../content/node';
import { listWrapper, type WrapperSpec } from '../content/wrapper';
import Node from './Node.astro';

interface Props {
  nodes: NodeData[];
  /** The wrapper of these roots as a list, as an Outlet would declare it. */
  wrapper?: WrapperSpec;
  /** Content for `Outlet` nodes, when rendering a layout, and a page's own wrappers for them. */
  outlets?: { nodes: Record<string, NodeData[]>; html: Record<string, string>; wrappers?: Record<string, WrapperSpec> };
  /** Where these nodes sit, for content issue paths: `sections` for page content, `layout` for a layout. */
  base?: string;
}

const { nodes: givenNodes, wrapper: rootSpec, outlets: givenOutlets, base: givenBase } = Astro.props;
const locale = (Astro.locals as any).parche?.locale as string | undefined;

// References, patterns, declared wrappers and the widgets needed, the way the
// build's content check prepares a page too (utils/prepare.ts).
const prepared = await prepareTrees({
  nodes: givenNodes,
  outlets: givenOutlets ? { nodes: givenOutlets.nodes, wrappers: givenOutlets.wrappers } : undefined,
  wrapper: rootSpec,
  base: givenBase,
  locale,
});
const rootWrapper = rootSpec !== undefined ? listWrapper(rootSpec, wrapperName) : null;
const widgets = await span('widgets.load', () => loadWidgets(prepared.widgets));

const nodes = await span('assets', () => resolveAssets(prepared.nodes));
const outlets = givenOutlets
  ? { nodes: await resolveAssets(prepared.outlets!.nodes), html: givenOutlets.html }
  : undefined;
const definitions: Record<string, Pattern> = Object.fromEntries(
  await Promise.all(Object.entries(prepared.definitions).map(async ([n, d]) => [n, { ...d, tree: await resolveAssets(d.tree) }] as const)),
);

// Check the trees against the catalog: slots a widget does not declare,
// widgets a slot does not allow, counts, tones, patterns. In dev every issue is
// a warning with its path; in a build, a prerendered page with issues fails
// the build, which is the CI check. The catalog imports every widget's
// schema, so it is loaded only here and never on a server-rendered request
// (a server build checks its pages once, at build time: routes/check.ts).
if (import.meta.env.DEV || Astro.isPrerendered) {
  const [{ widgetMeta }, { tones }] = await Promise.all([import('parche:registry/widgetSchemas'), import('parche:config/layout')]);
  const issues = checkPrepared(prepared, { widgetMeta, tones });
  if (issues.length && !import.meta.env.DEV) {
    throw new Error(
      `[parche] ${issues.length} content issue(s) on ${Astro.url.pathname}:\n` + issues.map((i) => `  ${i.path}: ${i.message}`).join('\n'),
    );
  }
  for (const issue of issues) console.warn(`[parche] ${issue.path}: ${issue.message}`);
}
---

{nodes.map((node) => <Node node={node} widgets={widgets} wrapper={rootWrapper} defaultWrapper={wrapperName} unwrapped={unwrapped} outlets={outlets} definitions={definitions} />)}
