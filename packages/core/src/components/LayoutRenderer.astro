---
/**
 * Renders a layout around page content. A layout is a tree of nodes with
 * `Outlet` nodes where the page goes: the unnamed outlet takes the page's
 * `sections` (and whatever this component is given as children), a named one
 * takes the page's `slots[name]`. Layout roots are chrome and are not wrapped.
 */
import NodeRenderer from './NodeRenderer.astro';
import type { Node } from '../content/node';

interface Props {
  layoutSections: Node[];
  /** Page trees by outlet name; `default` is the page's `sections`. */
  pageSlots?: Record<string, Node[]>;
}

const { layoutSections, pageSlots = {} } = Astro.props;

// Children (a resolver's template, a Markdown body) go after the default
// outlet's nodes. Rendered here, once, and placed by the Outlet node.
const html: Record<string, string> = {};
if (Astro.slots.has('default')) html.default = await Astro.slots.render('default');
---

<NodeRenderer nodes={layoutSections} outlets={{ nodes: pageSlots, html }} />
