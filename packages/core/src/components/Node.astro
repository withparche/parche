---
/**
 * One node of a tree: the widget, its props, and the nodes that fill its
 * slots, rendered into the widget's Astro slots by name. Recursive and pure:
 * it receives the resolved widgets, so the same component renders a page, a
 * layout or a pattern, and a test can render it with any components at all.
 *
 * Astro collects slotted children at compile time, so a slot name cannot come
 * from a loop variable. The fixed set of fragments below covers up to six
 * filled slots per node, which is more than any widget declares.
 */
import type { Node } from '../content/node';
import { listWrapper, nodeWrapper, type ListWrapper, type WrapperSpec } from '../content/wrapper';
import { instantiate, parseUse, type Pattern } from '../content/patterns';
import { previewContext } from '../dev/preview';

interface Outlets {
  /** Page trees by outlet name. */
  nodes: Record<string, Node[]>;
  /** Pre-rendered content by outlet name, placed after the nodes. */
  html: Record<string, string>;
  /** A page's own wrapper for an outlet's list, over the one the layout declares. */
  wrappers?: Record<string, WrapperSpec>;
}

interface Props {
  node: Node;
  widgets: Record<string, any>;
  /**
   * The wrapper of the list this node is an item of, or null. Only an
   * outlet's list (or a renderer given one) has a wrapper; a node in a slot
   * never does, so nothing below the first level is wrapped.
   */
  wrapper?: ListWrapper | null;
  /** The widget a wrapper uses when it names none: the registry's. */
  defaultWrapper?: string | null;
  /** Widgets whose meta says `wrapper: false`: never wrapped, even in a wrapped list. */
  unwrapped?: string[];
  outlets?: Outlets;
  /** Patterns by the name they are used with: a use renders its tree. */
  definitions?: Record<string, Pattern>;
  /** The patterns this node sits inside, outermost first: one that reaches itself stops there. */
  chain?: string[];
}

const { node, widgets, wrapper = null, defaultWrapper = null, unwrapped = [], outlets, definitions = {}, chain = [] } = Astro.props;
const Self = Astro.self;

const isOutlet = node.widget === 'Outlet';
const outletName = (node.props?.name as string | undefined) ?? 'default';
const outletNodes = isOutlet ? (outlets?.nodes[outletName] ?? []) : [];
const outletHtml = isOutlet ? (outlets?.html[outletName] ?? '') : '';

// An outlet declares how the items of its list are wrapped: the page's own
// choice first, then the layout's. Absent, the items render bare.
const itemWrapper = isOutlet
  ? listWrapper(outlets?.wrappers?.[outletName] ?? (node.props?.wrapper as WrapperSpec | undefined), defaultWrapper)
  : null;

// A pattern renders its tree with this use's props (defaults applied). Its
// roots stand where the use stands: items of the same list, wrapped as that
// list wraps its items; the use's own wrapper, when it names one, is theirs.
// One that reaches itself renders nothing more (the check reports it).
const found = isOutlet ? undefined : definitions[node.widget];
const loops = !!found && chain.includes(found.name);
const definition = loops ? undefined : found;
const expanded = definition
  ? instantiate(definition.tree, parseUse(definition, node.props, '').props).map((n) => (node.wrapper !== undefined && n.wrapper === undefined ? { ...n, wrapper: node.wrapper } : n))
  : [];
const inside = definition ? [...chain, definition.name] : chain;

const Widget = isOutlet || definition ? null : widgets[node.widget];
// An item that is the wrapper widget itself is the explicit form: it is not
// wrapped again, and takes the list's wrapper props as its defaults.
const isWrapperItem = wrapper !== null && node.widget === wrapper.name;
const props = isWrapperItem ? { ...wrapper!.props, ...(node.props ?? {}) } : (node.props ?? {});

// Only filled slots become fragments; an empty list leaves the widget's own
// fallback content in place.
const filled = Object.entries(node.slots ?? {}).filter(([, kids]) => Array.isArray(kids) && kids.length > 0);
const MAX_SLOTS = 6;
if (filled.length > MAX_SLOTS) {
  throw new Error(`[parche] "${node.widget}" fills ${filled.length} slots; a node may fill at most ${MAX_SLOTS}.`);
}
const slotName = (i: number) => filled[i]?.[0] ?? `__unfilled-${i}`;
const slotNodes = (i: number) => filled[i]?.[1] ?? [];

// The node's own wrapper, when it names one, over the list's; an explicit one
// applies even to a widget that is not wrapped by default.
const own = isOutlet ? null : node.wrapper === undefined ? undefined : nodeWrapper(node.wrapper, wrapper, defaultWrapper);
const effective = definition ? null : own !== undefined ? own : wrapper !== null && !isOutlet && !isWrapperItem && !unwrapped.includes(node.widget) ? wrapper : null;
const Wrapper = effective ? widgets[effective.name] : null;
// Inside its wrapper the node renders bare: nothing wraps it twice (and is
// marked once, around the band, for a preview's overlay).
const inner = effective ? { ...node, wrapper: false as const, id: undefined } : node;

// In a development tool's preview, a node with an id marks where its output
// starts and ends, so the tool's overlay can outline it. Comments: they touch
// neither the layout nor selectors. Never outside such a request, never in a build.
const mark = import.meta.env.DEV && !isOutlet && typeof node.id === 'string' && /^[\w.-]{1,64}$/.test(node.id) && previewContext()?.markers === true;
const open = mark ? `<!--parche-node:${node.id}-->` : '';
const close = mark ? `<!--/parche-node:${node.id}-->` : '';
---

{mark && <Fragment set:html={open} />}
{isOutlet ? (
  outletName === 'default' ? (
    <main id="main-content" class="flex-1 [.parche-column>&]:flex [.parche-column>&]:flex-col [.parche-column>&]:gap-[inherit]">
      {outletNodes.map((child) => <Self node={child} widgets={widgets} wrapper={itemWrapper} defaultWrapper={defaultWrapper} unwrapped={unwrapped} outlets={outlets} definitions={definitions} />)}
      {outletHtml && <Fragment set:html={outletHtml} />}
    </main>
  ) : (
    <Fragment>
      {outletNodes.map((child) => <Self node={child} widgets={widgets} wrapper={itemWrapper} defaultWrapper={defaultWrapper} unwrapped={unwrapped} outlets={outlets} definitions={definitions} />)}
      {outletHtml && <Fragment set:html={outletHtml} />}
    </Fragment>
  )
) : loops ? null : !Widget && !definition ? (
  import.meta.env.DEV ? (
    <div
      data-parche-missing-widget={node.widget}
      style="margin:.5rem;padding:.75rem 1rem;border:2px dashed #dc2626;border-radius:.5rem;background:#fef2f2;color:#991b1b;font:14px/1.5 ui-monospace,SFMono-Regular,monospace"
    >
      ⚠ Parche: unknown widget <strong>{node.widget}</strong> — {node.widget.startsWith('pattern/') ? 'no such pattern in src/content/patterns' : 'not registered by any parche'}.
    </div>
  ) : null
) : Wrapper ? (
  <Wrapper {...effective!.props}>
    <Self node={inner} widgets={widgets} defaultWrapper={defaultWrapper} unwrapped={unwrapped} outlets={outlets} definitions={definitions} chain={chain} />
  </Wrapper>
) : definition ? (
  <Fragment>{expanded.map((child) => <Self node={child} widgets={widgets} wrapper={wrapper} defaultWrapper={defaultWrapper} unwrapped={unwrapped} outlets={outlets} definitions={definitions} chain={inside} />)}</Fragment>
) : filled.length === 0 ? (
  <Widget {...props} />
) : (
  <Widget {...props}>
    <Fragment slot={slotName(0)}>{slotNodes(0).map((child) => <Self node={child} widgets={widgets} defaultWrapper={defaultWrapper} unwrapped={unwrapped} outlets={outlets} definitions={definitions} chain={chain} />)}</Fragment>
    <Fragment slot={slotName(1)}>{slotNodes(1).map((child) => <Self node={child} widgets={widgets} defaultWrapper={defaultWrapper} unwrapped={unwrapped} outlets={outlets} definitions={definitions} chain={chain} />)}</Fragment>
    <Fragment slot={slotName(2)}>{slotNodes(2).map((child) => <Self node={child} widgets={widgets} defaultWrapper={defaultWrapper} unwrapped={unwrapped} outlets={outlets} definitions={definitions} chain={chain} />)}</Fragment>
    <Fragment slot={slotName(3)}>{slotNodes(3).map((child) => <Self node={child} widgets={widgets} defaultWrapper={defaultWrapper} unwrapped={unwrapped} outlets={outlets} definitions={definitions} chain={chain} />)}</Fragment>
    <Fragment slot={slotName(4)}>{slotNodes(4).map((child) => <Self node={child} widgets={widgets} defaultWrapper={defaultWrapper} unwrapped={unwrapped} outlets={outlets} definitions={definitions} chain={chain} />)}</Fragment>
    <Fragment slot={slotName(5)}>{slotNodes(5).map((child) => <Self node={child} widgets={widgets} defaultWrapper={defaultWrapper} unwrapped={unwrapped} outlets={outlets} definitions={definitions} chain={chain} />)}</Fragment>
  </Widget>
)}
{mark && <Fragment set:html={close} />}
