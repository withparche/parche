---
import Icon from 'parche:primitives/Icon';

interface FooterLink {
  label: string;
  href: string;
  icon?: string;
}

interface FooterColumn {
  title: string;
  links: Array<{ label: string; href: string }>;
}

interface Props {
  columns?: FooterColumn[];
  secondaryLinks?: FooterLink[];
  socialLinks?: FooterLink[];
  footNote?: string;
  copyright?: string;
  siteName?: string;
  theme?: string;
}

const {
  columns = [],
  secondaryLinks = [],
  socialLinks = [],
  footNote = '',
  copyright,
  siteName = 'AstroWind',
  theme = 'light',
} = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-border not-prose']}>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-8 md:py-12">
      {/* Site name + secondary links */}
      <div class="col-span-12 lg:col-span-4">
        <div class="mb-2">
          <a class="inline-block font-bold text-xl text-heading" href="/">{siteName}</a>
        </div>
        {secondaryLinks.length > 0 && (
          <div class="text-sm text-muted flex gap-1">
            {secondaryLinks.map(({ label, href }, index) => (
              <>
                {index !== 0 ? ' · ' : ''}
                <a
                  class="text-muted hover:text-heading hover:underline transition duration-150 ease-in-out"
                  href={href}
                >
                  {label}
                </a>
              </>
            ))}
          </div>
        )}
      </div>

      {/* Link columns */}
      {columns.map(({ title, links }) => (
        <div class="col-span-6 md:col-span-3 lg:col-span-2">
          <div class="font-medium text-heading mb-2">{title}</div>
          {links.length > 0 && (
            <ul class="text-sm">
              {links.map(({ label, href }) => (
                <li class="mb-2">
                  <a
                    class="text-muted hover:text-heading hover:underline transition duration-150 ease-in-out"
                    href={href}
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>

    {/* Bottom bar: social links + footnote */}
    <div class="md:flex md:items-center md:justify-between py-6 md:py-8">
      {socialLinks.length > 0 && (
        <ul class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0 rtl:ml-0 rtl:-mr-2 rtl:md:ml-0 rtl:md:mr-4">
          {socialLinks.map(({ label, href, icon }) => (
            <li>
              <a
                class="text-muted hover:bg-neutral-100 dark:hover:bg-neutral-800 focus:outline-none focus:ring-4 focus:ring-neutral-200 dark:focus:ring-neutral-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                aria-label={label}
                href={href}
              >
                {icon && <Icon name={icon} class="w-5 h-5" />}
              </a>
            </li>
          ))}
        </ul>
      )}

      <div class="text-sm text-muted mr-4">
        {footNote ? (
          <Fragment set:html={footNote} />
        ) : copyright ? (
          <Fragment set:html={copyright} />
        ) : (
          <span>&copy; {new Date().getFullYear()} {siteName}. All rights reserved.</span>
        )}
      </div>
    </div>
  </div>
</footer>
