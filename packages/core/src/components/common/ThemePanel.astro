---
/**
 * ThemePanel — a floating button that opens a panel to pick the site theme:
 * a Popover anchored to the button, a RadioGroup inside. The elements do the
 * opening, the placement, the keyboard and the semantics; the script here
 * only applies the chosen theme to <html> and remembers it. Requires the
 * elements parche (every Parche project has it).
 */
import { themes as configuredThemes } from 'parche:config/themes';
import Button from 'parche:elements/Button';
import Popover from 'parche:elements/Popover';
import RadioGroup from 'parche:elements/RadioGroup';

interface ThemeOption {
  label: string;
  value: string;
}

interface Props {
  themes?: ThemeOption[];
}

const { themes = configuredThemes } = Astro.props;
---

{themes.length > 1 && (
  <theme-panel>
    <Button
      variant="secondary"
      class="fixed bottom-5 right-5 z-50 size-11 p-0 shadow-lg"
      popovertarget="parche-theme-panel"
      icon="tabler:palette"
      label="Theme settings"
    />
    <Popover id="parche-theme-panel" placement="top" align="end" class="w-64">
      <RadioGroup
        name="site-theme"
        label="Theme"
        options={themes.map((theme) => ({ value: theme.value, label: theme.label }))}
      />
    </Popover>
  </theme-panel>
)}

<script>
  class ThemePanelElement extends HTMLElement {
    connectedCallback() {
      const radios = this.querySelectorAll<HTMLInputElement>('input[name="site-theme"]');
      const current = document.documentElement.getAttribute('data-theme') || '';
      radios.forEach((radio) => (radio.checked = radio.value === current));

      this.addEventListener('change', (event) => {
        const radio = event.target as HTMLInputElement;
        if (radio.name !== 'site-theme') return;
        if (radio.value) {
          document.documentElement.setAttribute('data-theme', radio.value);
          localStorage.setItem('site-theme', radio.value);
        } else {
          document.documentElement.removeAttribute('data-theme');
          localStorage.removeItem('site-theme');
        }
      });
    }
  }

  if (!customElements.get('theme-panel')) customElements.define('theme-panel', ThemePanelElement);
</script>
