---
import { locales, defaultLocale } from 'parche:config/i18n';
import { buildSlugMap, getAlternateUrls, resolvePageFromSlug } from 'parche:utils/i18n';
import Menu from 'parche:elements/Menu';

// Only render when there are multiple locales configured
const hasMultipleLocales = Array.isArray(locales) && locales.length > 1;

let alternates: Array<{ locale: string; href: string; path: string }> = [];
let hasAlternates = false;

if (hasMultipleLocales) {
  // The route may already know this URL's translations — a blog post's are
  // derived from the posts collection, which this component cannot see. Those
  // win, because only the route that rendered the content can pair it.
  const provided = (Astro.locals as any)?.parche?.alternates as
    | Array<{ locale: string; href: string; path?: string }>
    | undefined;

  if (provided?.length) {
    alternates = provided.map((alt) => ({
      locale: alt.locale,
      href: alt.href,
      path: alt.path ?? new URL(alt.href, 'http://localhost').pathname,
    }));
  } else {
    // Otherwise reverse-lookup the current page from the URL to find its pageKey.
    const pathname = Astro.url.pathname.replace(/\/$/, '') || '';
    const urlSlug = pathname.startsWith('/') ? pathname.slice(1) : pathname;

    const resolved = await resolvePageFromSlug(urlSlug || undefined, defaultLocale);

    if (resolved) {
      const slugMap = await buildSlugMap();
      alternates = getAlternateUrls(resolved.pageKey, slugMap, defaultLocale, Astro.site);
    }
  }

  hasAlternates = alternates.length > 1;
}

interface Props {
  /** The menu id; give each instance on a page its own. */
  id?: string;
}
const { id = 'parche-locale-switcher' } = Astro.props;

const currentLocale = Astro.currentLocale || defaultLocale;

/**
 * Get the native display name for a locale using Intl.DisplayNames.
 * e.g. 'es' → 'español', 'en' → 'English'
 */
function getLocaleName(locale: string): string {
  try {
    const display = new Intl.DisplayNames([locale], { type: 'language' });
    const name = display.of(locale) || locale;
    return name.charAt(0).toUpperCase() + name.slice(1);
  } catch {
    return locale.toUpperCase();
  }
}

const currentName = getLocaleName(currentLocale);

/**
 * Every configured locale, in the order the project declared them.
 *
 * The current one stays in its own position rather than being pinned to the top:
 * a list that reorders itself depending on which language you are reading is
 * disorienting, because the entry you want moves.
 */
const allLocales = hasMultipleLocales
  ? (locales as Array<string | { path: string; codes: string[] }>)
      .map((l) => (typeof l === 'string' ? l : l.codes[0]))
      .map((locale) => {
        const alt = alternates.find((a) => a.locale === locale);
        return {
          locale,
          href: alt?.path,
          current: locale === currentLocale,
          // No translation of this page exists — shown, but not offered.
          disabled: locale !== currentLocale && !alt,
        };
      })
  : [];
---

{hasMultipleLocales && (
  <Menu
    id={id}
    icon="tabler:world"
    triggerLabel={`Language: ${currentName}`}
    align="end"
    groups={[
      {
        items: allLocales.map((item) => ({
          label: getLocaleName(item.locale),
          value: item.locale,
          // The current locale is marked in place, not linked; a locale with
          // no translation of this page is shown but disabled.
          href: item.current ? undefined : item.href,
          hreflang: item.locale,
          checked: item.current,
          current: item.current,
          disabled: item.disabled,
        })),
      },
    ]}
  />
)}
