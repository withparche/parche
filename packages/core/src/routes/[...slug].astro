---
import 'parche:config/styles';
import BaseLayout from 'parche:layouts/BaseLayout';
import ThemePanel from 'parche:components/ThemePanel';
import LayoutRenderer from 'parche:LayoutRenderer';
import NodeRenderer from 'parche:NodeRenderer';
import config from 'parche:config';
import { templateMap } from 'parche:registry/templates';
import { defaultLocale, locales } from 'parche:config/i18n';
import { localizeSiteConfig } from 'parche:utils/site';
import { showPanel } from 'parche:config/themes';
import { resolveContent, getResolverPaths } from 'parche:registry/resolvers';
import { getEntry, render } from 'astro:content';
import {
  buildSlugMap,
  getAlternateUrls,
  resolvePageFromSlug,
} from 'parche:utils/i18n';
import { resolveMetadata } from 'parche:utils/metadata';
import { resolveLayout, outletWrapper } from 'parche:utils/layout';

export async function getStaticPaths() {
  const slugMap = await buildSlugMap();

  const pagePaths = slugMap.map((entry) => {
    const { locale, pageKey, slug, data, entryId } = entry;

    let urlSlug: string | undefined;
    if (pageKey === 'home') {
      urlSlug = locale === defaultLocale ? undefined : locale;
    } else if (locale === defaultLocale) {
      urlSlug = slug;
    } else {
      urlSlug = `${locale}/${slug}`;
    }

    return {
      params: { slug: urlSlug },
      props: { pageData: data, locale, pageKey, entryId },
    };
  });

  // Add paths from app resolvers (e.g. blog posts at root level)
  const isDev = import.meta.env.DEV;
  const resolverPaths = await getResolverPaths(locales, defaultLocale, { showDrafts: isDev });

  return [...pagePaths, ...resolverPaths];
}

/**
 * Split a leading locale segment off a slug. Resolver-backed URLs are prefixed
 * for non-default locales (e.g. 'es/mi-post'), and the app that resolves them
 * expects the bare key plus the locale, not the prefixed path.
 */
function splitLocale(slug: string | undefined): { locale: string; rest: string } {
  if (!slug) return { locale: defaultLocale, rest: '' };
  const idx = slug.indexOf('/');
  const head = idx === -1 ? slug : slug.slice(0, idx);
  if (head !== defaultLocale && locales.includes(head)) {
    return { locale: head, rest: idx === -1 ? '' : slug.slice(idx + 1) };
  }
  return { locale: defaultLocale, rest: slug };
}

// ---- Render-time ----
// Determine what we're rendering: app content (via resolver) or page content.
let mode: 'resolver' | 'page' = 'page';
let resolvedApp: Awaited<ReturnType<typeof resolveContent>> = null;

// Page-mode variables
let pageData: any;
let locale: string = Astro.currentLocale ?? defaultLocale;
let pageKey: string = '';
let entryId: string = '';
let alternates: { locale: string; href: string }[] = [];

const isDev = import.meta.env.DEV;

if (Astro.props.fromResolver) {
  // Static mode — this path came from a resolver's getPaths(), which supplies the
  // lookup key and locale explicitly (the URL may carry a locale prefix and/or
  // date segments that the lookup must not see).
  const fromProps = splitLocale(Astro.params.slug);
  locale = Astro.props.resolverLocale ?? fromProps.locale;
  resolvedApp = await resolveContent(Astro.props.resolverSlug ?? fromProps.rest, locale, {
    showDrafts: isDev,
    siteUrl: config.site || Astro.site?.href || '',
    // The site's name in the page's language: the app puts it in the title.
    siteName: localizeSiteConfig(config, locale).brand.name,
  });
  if (resolvedApp) {
    mode = 'resolver';
  } else {
    return Astro.redirect('/404');
  }
} else if (Astro.props.pageData) {
  // Static mode — page data provided by getStaticPaths
  ({ pageData, locale, pageKey, entryId } = Astro.props);
} else {
  // SSR mode — try resolvers first, then pages. The locale prefix is part of the
  // URL here, so peel it off before asking the app to resolve the content.
  const fromUrl = splitLocale(Astro.params.slug);
  locale = fromUrl.locale;
  resolvedApp = await resolveContent(fromUrl.rest, locale, {
    showDrafts: isDev,
    siteUrl: config.site || Astro.site?.href || '',
    siteName: localizeSiteConfig(config, locale).brand.name,
  });

  if (resolvedApp) {
    mode = 'resolver';
  } else {
    const resolved = await resolvePageFromSlug(Astro.params.slug, defaultLocale);
    if (!resolved) {
      return Astro.redirect('/404');
    }
    ({ pageData, locale, pageKey } = resolved);
    entryId = resolved.entryId;
  }
}

// ---- Resolver mode: app-provided content (e.g. blog post) ----
let AppTemplate: any = null;
let AppContent: any = null;
let appMetadata: any = null;
let appExtras: any = {};

if (mode === 'resolver' && resolvedApp) {
  AppTemplate = templateMap[resolvedApp.template];
  if (import.meta.env.DEV && resolvedApp.template && !AppTemplate) {
    console.warn(
      `[parche] Unknown template "${resolvedApp.template}" requested by a resolver — ` +
      `not registered by any parche. Falling back to a bare <article>.`,
    );
  }
  appMetadata = resolvedApp.metadata;
  appExtras = resolvedApp.extras;

  try {
    const entry = await getEntry(resolvedApp.collection as any, resolvedApp.entryId as any);
    if (entry) {
      const { Content } = await render(entry);
      AppContent = Content;
    }
  } catch { /* non-renderable entry */ }
}

// ---- Page mode: standard page content ----
let pageMetadata: any = null;
let PageMarkdownContent: any = null;
let pageLayoutName: string = 'default';

// In dev the page is read afresh: Astro caches getStaticPaths' props, and a
// development tool may be showing a draft of this very page.
const freshEntry = import.meta.env.DEV && mode === 'page' && entryId ? await getEntry('pages', entryId) : undefined;
if (freshEntry) pageData = freshEntry.data;

if (mode === 'page' && pageData) {
  const slugMap = await buildSlugMap();
  alternates = getAlternateUrls(pageKey, slugMap, defaultLocale, Astro.site);

  const resolved = resolveMetadata(pageData, config, { locale });
  resolved.title = pageKey === 'home'
    ? config.brand.name
    : `${resolved.title} — ${config.brand.name}`;
  pageMetadata = resolved;

  // Only a Markdown page has a body to render. A JSON entry renders to an
  // empty component, which left an empty prose block at the end of the page.
  const pageEntry = freshEntry ?? (await getEntry('pages', entryId));
  if (pageEntry && (pageEntry as any).body?.trim()) {
    try {
      const { Content } = await render(pageEntry);
      PageMarkdownContent = Content;
    } catch {
      // JSON entries don't support render()
    }
  }
  pageLayoutName = pageData.layout || 'default';
}

// Resolver-backed content (e.g. a blog post) knows its own translations; core
// cannot derive them, because the pairing rule belongs to the app.
if (mode === 'resolver' && resolvedApp?.alternates?.length) {
  alternates = resolvedApp.alternates.map((alt: { locale: string; path: string }) => ({
    locale: alt.locale,
    href: Astro.site ? new URL(alt.path, Astro.site).href : alt.path,
  }));
}

// Expose them to the component tree (the language switcher lives inside the
// layout chrome and has no other way to reach route-level data).
Astro.locals.parche = { ...(Astro.locals.parche ?? {}), locale, alternates };

// Site-wide identity can be translated too; routes without frontmatter fall back
// to it, so it has to be localized before the metadata is assembled.
const siteConfig = localizeSiteConfig(config, locale);

const metadata = mode === 'resolver' ? appMetadata : pageMetadata;
const layoutName = mode === 'resolver'
  ? (resolvedApp?.layout || 'default')
  : pageLayoutName;
const layoutSections = await resolveLayout(layoutName, locale, defaultLocale);

// The page's trees by outlet: `sections` is the unnamed outlet, `slots` the named ones.
const pageSlots: Record<string, any[]> = mode === 'page' && pageData
  ? { default: pageData.sections ?? [], ...(pageData.slots ?? {}) }
  : {};
// A page may wrap its sections its own way, over what the layout's outlet says.
const pageWrappers = mode === 'page' && pageData?.wrapper !== undefined ? { default: pageData.wrapper } : undefined;
---

<BaseLayout metadata={metadata} config={siteConfig} lang={locale}>
  {alternates.length > 1 && (
    <Fragment slot="head">
      {alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.locale} href={alt.href} />
      ))}
      <link
        rel="alternate"
        hreflang="x-default"
        href={alternates.find((a) => a.locale === defaultLocale)?.href}
      />
    </Fragment>
  )}

  {mode === 'resolver' && resolvedApp ? (
    <LayoutRenderer layoutSections={layoutSections}>
      {AppTemplate ? (
        <AppTemplate {...resolvedApp.templateProps}>
          {AppContent && <AppContent />}
        </AppTemplate>
      ) : (
        <article class="prose max-w-4xl mx-auto py-16 px-4">
          {AppContent && <AppContent />}
        </article>
      )}

      {appExtras.sections?.length > 0 && (
        <NodeRenderer nodes={appExtras.sections} wrapper={outletWrapper(layoutSections)} />
      )}
    </LayoutRenderer>
  ) : (
    <LayoutRenderer layoutSections={layoutSections} pageSlots={pageSlots} pageWrappers={pageWrappers}>
      {/* A Markdown page's body renders after its sections, in the page's own outlet. */}
      {PageMarkdownContent && (
        <div class="mx-auto max-w-4xl px-4 md:px-6 pb-12 md:pb-16 prose">
          <PageMarkdownContent />
        </div>
      )}
    </LayoutRenderer>
  )}

  {showPanel && <ThemePanel />}
</BaseLayout>
