{
  "name": "@parche/builder",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The Parche visual builder: a dev-only editor for a site's content, started by `parche astro builder`.",
  "exports": {
    ".": {
      "types": "./dist/integration.d.ts",
      "default": "./dist/integration.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup && vite build -c vite.editor.config.ts",
    "dev:editor": "vite build -c vite.editor.config.ts --watch",
    "test:browser": "playwright test"
  },
  "peerDependencies": {
    "@parche/astro": "workspace:*",
    "astro": "catalog:"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "zustand": "^5.0.5",
    "immer": "^10.1.1",
    "idiomorph": "^0.7.4",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@parche/astro": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "^22.10.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.2.0",
    "astro": "catalog:",
    "tailwindcss": "catalog:",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^8.2.1",
    "zod": "catalog:"
  }
}
