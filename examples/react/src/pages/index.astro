---
import '@parche/core/styles';
import Hero from 'parche:widgets/Hero';
import Counter from '../components/Counter.tsx';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>React island — Parche</title>
  </head>
  <body>
    <Hero
      tagline="React"
      title="A React island in a Parche page"
      subtitle="The counter below is a React component, hydrated in the browser, sitting next to a server-rendered Parche widget."
    />
    <div class="mx-auto max-w-3xl px-4 pb-16">
      <Counter client:load start={3} />
    </div>
  </body>
</html>
