---
import Counter from '../components/Counter.tsx';
import Container from 'parche:elements/Container';
import Section from 'parche:elements/Section';

interface Props {
  id?: string;
  title?: string;
  start?: number;
}

const { id, title, start = 0 } = Astro.props;
---

<Section {id}>
  <Container>
    {title && <h2 class="type-h2 mb-8 text-center">{title}</h2>}
    <div class="flex justify-center">
      <Counter client:visible start={start} />
    </div>
  </Container>
</Section>
