              { "label": "GitHub", "href": "https://github.com/withparche/parche" }
            ]
          }
        ],
        "socialLinks": [
          { "label": "RSS", "href": "/rss.xml", "icon": "tabler:rss" },
          { "label": "GitHub", "href": "https://github.com/withparche/parche", "icon": "tabler:brand-github" }
        ],
        "footNote": "Built with <a class=\"text-primary hover:underline\" href=\"https://github.com/withparche/parche\">Parche</a>."
      }
    }
