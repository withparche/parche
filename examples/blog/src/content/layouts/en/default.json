      "widget": "layout/Header",
      "props": {
        "links": [
          { "label": "Home", "href": "/" },
          { "label": "Blog", "href": "/blog" }
        ],
        "actions": [
          { "label": "GitHub", "href": "https://github.com/withparche/parche", "variant": "primary", "icon": "tabler:brand-github" }
        ],
        "announcement": {
          "text": "🚀 Built with <strong>Parche</strong> — Astro 6 + Tailwind v4.",
          "href": "/blog",
          "dismissible": true
        }
