{
  "label": "Product shot",
  "description": "A screen beside a short pitch and its action: two widgets that exist, arranged once.",
  "category": "content",
  "icon": "tabler:layout-columns",
  "props": {
    "type": "object",
    "properties": {
      "screen": { "type": "string", "description": "The bar over the screen: \"app.example.com · 1200×760\"." },
      "title": { "type": "string", "minLength": 1 },
      "text": { "type": "string" },
      "action": {
        "type": "object",
        "properties": { "text": { "type": "string" }, "href": { "type": "string" } },
        "required": ["text", "href"],
        "additionalProperties": false
      }
    },
    "required": ["screen", "title"]
  },
  "tree": [
    {
      "widget": "Columns",
      "props": { "ratio": "equal", "gap": "lg", "align": "center" },
      "slots": {
        "default": [
          { "widget": "Column", "slots": { "default": [{ "widget": "Screenshot", "props": { "url": { "$prop": "screen" }, "ratio": "16/10" } }] } },
          {
            "widget": "Column",
            "slots": {
              "default": [
                {
                  "widget": "CallToAction",
                  "props": {
                    "layout": "stacked",
                    "title": { "$prop": "title" },
                    "subtitle": { "$prop": "text" },
                    "actions": [{ "variant": "primary", "text": { "$prop": "action.text" }, "href": { "$prop": "action.href" } }]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
