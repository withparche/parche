---
// A hand-written .astro page beside the JSON route. It imports a widget from
// Parche's virtual module and shows what only code can: per-request values.
import '@parche/core/styles';
import Content from 'parche:widgets/Content';

const now = new Date().toISOString();
const ua = Astro.request.headers.get('user-agent') ?? 'unknown';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Request — Parche SSR</title>
  </head>
  <body>
    <Content
      tagline="SSR · Node"
      title="Rendered on this request"
      content="This page is <code>src/pages/request.astro</code>, served per request by the Node adapter in standalone mode. Reload and the timestamp below changes."
    />
    <div class="mx-auto max-w-3xl px-4 pb-16">
      <p class="text-muted">Server time at render: <strong class="text-heading">{now}</strong></p>
      <p class="mt-4 text-muted">User agent, read from the request on the server:</p>
      <pre class="mt-2 overflow-x-auto rounded-lg border border-border bg-surface p-4 text-sm">{ua}</pre>
      <p class="mt-8 text-muted"><a class="text-primary underline" href="/">Back to the JSON page</a></p>
    </div>
  </body>
</html>
