---
import '@parche/core/styles';
import Content from 'parche:widgets/Content';

const now = new Date().toISOString();
const ua = Astro.request.headers.get('user-agent') ?? 'unknown';
// Cloudflare's per-request metadata (`request.cf`). Populated by workerd in
// dev, preview and production; `colo` is the datacenter that served the request.
const colo = Astro.request.cf?.colo ?? 'n/a';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SSR on Cloudflare — Parche</title>
  </head>
  <body>
    <Content
      tagline="SSR · Cloudflare"
      title="Rendered on the edge"
      content="This page is server-rendered on every request (prerender = false) via the Cloudflare adapter, inside the workerd runtime. Reload and the timestamp below changes."
    />
    <div class="mx-auto max-w-3xl px-4 pb-16">
      <p class="text-muted">Server time at render: <strong class="text-heading">{now}</strong></p>
      <p class="mt-4 text-muted">Cloudflare colo, from <code>Astro.request.cf</code>: <strong class="text-heading">{colo}</strong></p>
      <p class="mt-4 text-muted">User agent, read from the request on the server:</p>
      <pre class="mt-2 overflow-x-auto rounded-lg border border-border bg-surface p-4 text-sm">{ua}</pre>
    </div>
  </body>
</html>
