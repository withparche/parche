{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parche-example-ssr-cloudflare",
  // The adapter's unified entrypoint, used by `astro dev`, `astro preview`
  // and `wrangler deploy` alike.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2025-05-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
