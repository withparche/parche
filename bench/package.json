{
  "name": "parche-bench",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Measures Parche on a generated site of any size. No build script on purpose: CI's `pnpm -r build` skips it.",
  "scripts": {
    "gen": "node generate.mjs",
    "measure:build": "node build.mjs",
    "measure:ssr": "node ssr.mjs",
    "measure:chunks": "node chunks.mjs",
    "compare": "node compare.mjs"
  },
  "dependencies": {
    "@iconify-json/tabler": "^1.2.38",
    "@parche/astro": "workspace:*",
    "@parche/astro-blog": "workspace:*",
    "@parche/elements": "workspace:*",
    "@parche/themes": "workspace:*",
    "@parche/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "astro": "catalog:",
    "astro-icon": "catalog:",
    "sharp": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@astrojs/node": "catalog:"
  }
}
